## The 3D scene of a playback: builds the static layout from
## `UtsimPlayback.static_scene()` once and applies `UtsimPlayback.frame(t)` every frame.
##
## Positions arrive in Godot coordinates (the bridge converts `(x, y, z)` of the model to
## `(x, z, -y)`), so nothing here converts. Assets, as the Bevy viewer chooses them
## (`crates/utsim-godot/src/looks.rs`):
## - library assets with default parameters are the imported `.glb` of
##   `res://importados/modelos/` (copies of `assets/modelos/`, see `scripts/godot.sh`);
## - parametric ones (a rack with its own bays, a conveyor of its own length) are
##   generated by the bridge (`UtsimPlayback.glb(key)`) and loaded with GLTFDocument;
## - the skeletal person is the imported UAL mannequin ([Pessoa]); other catalogue
##   entries and user files are read from disk with GLTFDocument;
## - the elements made in Blender (`asset.source == "modelos3d"`, `assets/modelos3d/`,
##   `docs/elementos_3d_blender.md`) are the imported `.glb` of
##   `res://importados/modelos3d/`, else read from `asset.path`, else `asset.fallback` (the
##   library asset they replace). Their clips (`block.clips`) are placed by the frame's
##   `anim_clip` and `anim_fase`: the AnimationPlayer of the file in manual mode, seeked
##   to the phase, the rest pose restored when the clip changes. A person with a Blender
##   body (`block.pessoa`) is driven like the mannequin, with the clips of the UAL files on
##   its skeleton, and shows only its own protective equipment and colours;
## - a forklift with a seat (`block.driver`, `utsim-look/src/driver.rs`) carries a second
##   mannequin, seated at the anchor point of its asset, playing `Driving_Loop` while the
##   vehicle moves and `Sitting_Idle_Loop` otherwise (only a presentation).
## Per frame only the mobiles move; colours and labels change only when they differ.
class_name CenaUtsim
extends Node3D

const MODELOS := "res://importados/modelos/"
const MODELOS3D := "res://importados/modelos3d/"
const UAL1 := "res://importados/terceiros/quaternius_ual/UAL1_Standard.glb"
const UAL2 := "res://importados/terceiros/quaternius_ual2/UAL2_Standard.glb"
## Fork height at rest of the library forklift (`utsim_assets::dims::FORK_REST`).
const FORK_REST := 0.10
## Edge of the scene's item cube (`utsim_scene::compose::ITEM_SIZE`).
const ITEM_SIZE := 0.3

var playback: Object
var info: Dictionary
var blocks: Array = []
## Per block: {root, asset, carro, carro_rest, wheels, light, mesh_material, person, label,
## driver (Pessoa), driver_node, driver_info}.
var rigs: Array = []
var mobiles := PackedInt32Array()
var items := {}
var _item_spare: Array[Node3D] = []
var _templates := {}
var _materials := {}
var _last_color: Array = []
## Where each mobile resource goes for its current task, at the last frame (NaN: none).
var task_target := PackedVector3Array()
var _last_label: Array = []
var _pallets := false
var _clips2: AnimationLibrary
## The clips of the UAL1 mannequin, for the people with a Blender body (same skeleton).
var _clips1: AnimationLibrary
## The UAL2 clips the Blender bodies play: `_clips2` with the corrected clips of
## `pessoa_clipes.glb` (their names in `clips_fixed`); the UAL mannequins keep `_clips2`.
var _clips2_body: AnimationLibrary
var clips_fixed := PackedStringArray()
## Blocks whose Blender element plays clips (rig `anim`).
var _animated := PackedInt32Array()
## Items of the last frame put on a point of a Blender element: [block, point, node].
var _anchored: Array = []
var labels_visible := true
## A camada de segurança e qualidade (camada_seguranca.gd), quando a reprodução tem uma.
var camada: CamadaSeguranca
## Names of the vehicles whose driver is hidden ("Mostrar motorista" off). A preference of
## the viewer, kept across rebuilds; the model file does not store it.
var drivers_off := {}
## Labels drawn at most (the nearest ones to the camera, within `LABEL_DISTANCE`): large
## models stay readable (A3D-4).
const MAX_LABELS := 60
const LABEL_DISTANCE := 160.0
## Items farther than this are not drawn (level of detail).
const ITEM_DISTANCE := 140.0
## Fluid network: per node `{root, liquid, height, marker, label, shape}` and the pipes.
var fluid_nodes: Array = []
var fluid_pipes: Array = []
var _fluid_materials: Array = []
var _labels_shown := 0
## Polygons of the floor marking of the aisles, by pattern (`continuous`, `zebra`, `arrow`).
var mark_counts := {}
## Room kept around a following camera's eye (`clear_view`).
const VIEW_MARGIN := 0.5
## Meshes hidden by `clear_view` (shown again by `restore_view`).
var _hidden_for_view: Array[MeshInstance3D] = []
## Blocks whose driver `clear_view` hid (the camera is at its eyes).
var _view_hidden := {}
## Blocks with meshes `clear_view` hid (a click in Simular does not pick them).
var _blocks_hidden_for_view := {}
## Editar draws its own connections (arrows, port numbers) and floor.
var show_connections := true
var show_floor := true
## Time spent in the last `frame()` call of the bridge and in applying it, microseconds.
var last_bridge_us := 0
var last_apply_us := 0


## Whether the skeletal person files are imported (the bridge then gives people the
## mannequin; else the procedural operator).
static func skeletal_available() -> bool:
	return ResourceLoader.exists(UAL1) and ResourceLoader.exists(UAL2)


## Removes everything built. `keep_templates`: keep the loaded models for the next build
## (the editor rebuilds the scene after every edit).
func clear(keep_templates := false) -> void:
	for c in get_children():
		c.queue_free()
	if not keep_templates:
		for t in _templates.values():
			if t is Node:
				(t as Node).free()
		_templates.clear()
		_materials.clear()
	blocks.clear()
	route_belts.clear()
	rigs.clear()
	items.clear()
	_item_spare.clear()
	mobiles.clear()
	_animated.clear()
	_anchored.clear()
	_last_color.clear()
	_last_label.clear()
	fluid_nodes.clear()
	fluid_pipes.clear()
	_fluid_materials.clear()
	_hidden_for_view.clear()
	_view_hidden.clear()
	_blocks_hidden_for_view.clear()
	camada = null
	playback = null


func _notification(what: int) -> void:
	if what == NOTIFICATION_PREDELETE:
		for t in _templates.values():
			if t is Node:
				(t as Node).free()
		_templates.clear()


## Builds everything static of `pb` (a UtsimPlayback).
func build(pb: Object, keep_templates := false) -> void:
	clear(keep_templates)
	playback = pb
	info = pb.static_scene()
	_pallets = info.get("pallets", false)
	blocks = info["blocks"]
	if skeletal_available():
		_clips2 = _library_of(UAL2)
		_clips1 = _library_of(UAL1)
		clips_fixed = PackedStringArray()
		_clips2_body = _clips2
		if _clips2 != null and info.has("clipes_corrigidos"):
			_clips2_body = _fixed_clips(_clips2, String(info["clipes_corrigidos"]), info.get("clipes_substitui", PackedStringArray()))
	var names: PackedStringArray = pb.person_clips()
	var durations_set := false
	for i in blocks.size():
		var b: Dictionary = blocks[i]
		var rig := {}
		var root := Node3D.new()
		root.name = "b%d_%s" % [i, b["name"]]
		add_child(root)
		root.position = b["position"]
		# A fixed object turned by the user (`visual.yaw`) or a belt along its heading: the
		# root turns, so the asset, the simple shape and the editor's box turn together.
		root.rotation = Vector3(0, float(b.get("yaw", 0.0)), 0)
		rig["root"] = root
		var asset: Node3D = null
		# The Blender element did not load: the library asset it replaces.
		var fell_back := false
		if b.has("asset"):
			var a: Dictionary = b["asset"]
			asset = _instance(a)
			if asset == null and a.has("fallback"):
				asset = _instance(a["fallback"])
				fell_back = asset != null
		if asset != null:
			asset.position = b.get("offset", Vector3.ZERO)
			# A stack (LIFO queue) is drawn turned around: its arrow points back to
			# where the items come in, which is also where they leave.
			asset.rotation = Vector3(0, float(b.get("asset_yaw", 0.0)) + (PI if b.get("stack", false) else 0.0), 0)
			asset.scale = Vector3.ONE * float(b.get("scale", 1.0))
			if fell_back:
				# The library asset keeps its own size and place (a person's mannequin is
				# not scaled to the Blender body's height).
				var fb: Dictionary = (b["asset"] as Dictionary)["fallback"]
				asset.scale = Vector3.ONE * float(fb.get("scale", b.get("scale", 1.0)))
				asset.position = fb.get("offset", asset.position)
			elif b.has("pessoa"):
				# The Blender body follows the person's mass: width and depth by the body
				# mass index (`largura`, 1 without a mass), the height by `scale`.
				var w := float((b["pessoa"] as Dictionary).get("largura", 1.0))
				asset.scale = Vector3(asset.scale.x * w, asset.scale.y, asset.scale.z * w)
			root.add_child(asset)
			rig["asset"] = asset
			if b.get("sized", false) and not fell_back:
				_fit_to_size(root, asset, b["size"])
			if b.has("color") and not b.get("skeletal", false):
				_tint_named(asset, "pintura", b["color"])
			_bind(rig, asset)
			var clips: PackedStringArray = b.get("clips", PackedStringArray())
			if not fell_back and not clips.is_empty() and _bind_clips(rig, asset, clips):
				_animated.append(i)
			if not fell_back:
				_bind_points(rig, asset, b.get("pontos", PackedStringArray()))
			if b.get("skeletal", false):
				var p := Pessoa.new()
				# A Blender body has no clips of its own: the UAL1 ones drive its skeleton.
				var body: bool = b.has("pessoa") and not fell_back
				var own: AnimationLibrary = null
				if body:
					own = _clips1
				if p.bind(asset, _clips2_body if body else _clips2, names, own):
					rig["person"] = p
					if body:
						Pessoa.vestir(asset, b["pessoa"])
						rig["pessoa"] = b["pessoa"]
					if not durations_set:
						pb.set_clip_durations(p.durations)
						durations_set = true
		else:
			var mi := _simple_shape(b)
			root.add_child(mi)
			rig["simple"] = mi
		if b.has("driver") and skeletal_available():
			_add_driver(rig, root, b, names)
		# Labels as in the Bevy viewer: same size on screen, never hidden by the models.
		var label := Label3D.new()
		label.text = b["name"]
		label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
		label.fixed_size = true
		label.no_depth_test = true
		label.pixel_size = 0.0006
		label.font_size = 26
		label.modulate = Color(0.95, 0.96, 0.98)
		_style_label(label)
		# Above the model: a person's head, a machine's roof (not its light mast).
		var top := maxf(_height(root), (b["size"] as Vector3).y)
		if b.get("skeletal", false):
			top = 1.85
		elif b["kind"] in ["Processor", "Combiner"]:
			top = minf(top, 2.2)
		label.position = Vector3(0, top + 0.3, 0)
		root.add_child(label)
		if b.has("preview_color"):
			# The label goes up over the preview item (and the ring of its types).
			label.position.y = top + 0.55
			# C7: a small item of the colour the source's items get, over it.
			var item := MeshInstance3D.new()
			item.name = "PreviaItem"
			var box := BoxMesh.new()
			box.size = Vector3.ONE * 0.22
			item.mesh = box
			var m := StandardMaterial3D.new()
			m.albedo_color = Color("b8875a").lerp(b["preview_color"], 0.55)
			item.material_override = m
			item.position = Vector3(0, top + 0.12, 0)
			item.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			root.add_child(item)
			rig["preview"] = item
			rig["preview_material"] = m
			rig["preview_color"] = m.albedo_color
			var mix: Array = b.get("type_mix", [])
			if mix.size() > 0:
				root.add_child(_type_ring(mix, Vector3(0, top + 0.12, 0)))
		rig["label"] = label
		rig["top"] = top
		rigs.append(rig)
		_last_color.append(null)
		_last_label.append("")
		if b["mobile"]:
			mobiles.append(i)
	_draw_lines()
	_draw_marks()
	_build_fluids()
	_build_routes()


## A copy of `lib` with the clips `names` taken from the glTF at `path` (the corrected
## clips of the Blender bodies, same skeleton). A clip is swapped only when it drives the
## same bones as the one it replaces (the importer may have dropped the "_Loop" suffix on
## either side); otherwise the original stays, with a warning.
func _fixed_clips(lib: AnimationLibrary, path: String, names: PackedStringArray) -> AnimationLibrary:
	if not FileAccess.file_exists(path):
		return lib
	var scene := _from_gltf(PackedByteArray(), path)
	if scene == null:
		return lib
	var player := Pessoa._find(scene, "AnimationPlayer") as AnimationPlayer
	var out := lib.duplicate() as AnimationLibrary
	if player == null:
		push_warning("clipes corrigidos sem AnimationPlayer: %s" % path)
	if player != null:
		for name in names:
			var key := _clip_key(out, name)
			var src := _clip_key_in_player(player, name)
			if key == "" or src == "":
				push_warning("clipe corrigido %s não encontrado (biblioteca: %s; arquivo: %s)" % [name, key, player.get_animation_list()])
				continue
			var fixed := (player.get_animation(StringName(src)) as Animation).duplicate() as Animation
			var old := out.get_animation(StringName(key))
			var bones := {}
			for t in old.get_track_count():
				bones[String(old.track_get_path(t))] = true
			var same := 0
			for t in fixed.get_track_count():
				if bones.has(String(fixed.track_get_path(t))):
					same += 1
			if fixed.get_track_count() == 0 or same * 10 < fixed.get_track_count() * 9:
				push_warning("clipe corrigido %s não bate com o esqueleto (%d de %d trilhas)" % [name, same, fixed.get_track_count()])
				continue
			fixed.loop_mode = old.loop_mode
			out.remove_animation(StringName(key))
			out.add_animation(StringName(key), fixed)
			clips_fixed.append(name)
	scene.free()
	return out


## The name `clip` has in `lib` ("Walk_Carry_Loop" or "Walk_Carry"), or "".
static func _clip_key(lib: AnimationLibrary, clip: String) -> String:
	for k in [clip, clip.trim_suffix("_Loop")]:
		if lib.has_animation(StringName(k)):
			return k
	return ""


## The name `clip` has in `player`'s animations, or "".
static func _clip_key_in_player(player: AnimationPlayer, clip: String) -> String:
	for k in [clip, clip.trim_suffix("_Loop")]:
		if player.has_animation(StringName(k)):
			return k
	return ""


## The AnimationLibrary of an imported scene with clips (the UAL files), or null.
static func _library_of(path: String) -> AnimationLibrary:
	var scene := load(path) as PackedScene
	if scene == null:
		return null
	var tmp := scene.instantiate()
	var player := Pessoa._find(tmp, "AnimationPlayer") as AnimationPlayer
	var lib: AnimationLibrary = null
	if player != null:
		lib = player.get_animation_library(&"")
	tmp.free()
	return lib


## The clips of a Blender element: its AnimationPlayer in manual mode (the frame places
## each clip by its phase), not deterministic (a node no playing clip moves keeps its pose
## instead of going back to the start value), and the rest transform of the nodes each
## clip moves (`anim_rest`: clip name -> [[node, transform]]). False when the file has no
## player.
func _bind_clips(rig: Dictionary, asset: Node3D, clips: PackedStringArray) -> bool:
	var player := Pessoa._find(asset, "AnimationPlayer") as AnimationPlayer
	if player == null:
		push_warning("elemento sem AnimationPlayer: %s" % asset.name)
		return false
	player.stop()
	player.deterministic = false
	player.callback_mode_process = AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_MANUAL
	var root := player.get_node_or_null(player.root_node)
	var rest := {}
	if root != null:
		for clip_name in player.get_animation_list():
			var anim := player.get_animation(clip_name)
			_drop_static_tracks(anim)
			var nodes: Array = []
			var seen := {}
			for k in anim.get_track_count():
				var path := anim.track_get_path(k)
				var node := root.get_node_or_null(NodePath(path.get_concatenated_names()))
				if node is Node3D and not seen.has(node):
					seen[node] = true
					nodes.append([node, (node as Node3D).transform])
			rest[String(clip_name)] = nodes
	# A clip that moves the forks (`garfo_subir`) is their only driver: the frame's lift
	# no longer moves the `carro` node too.
	for nodes in rest.values():
		for r in nodes:
			if String((r[0] as Node3D).name) == "carro":
				rig.erase("carro")
				rig.erase("carro_rest")
				rig["anim_carro"] = r[0]
	rig["anim"] = player
	rig["anim_clips"] = clips
	rig["anim_rest"] = rest
	rig["anim_cur"] = -1
	rig["anim_fase"] = 0.0
	return true


## The nodes of the points where a Blender element holds a part or a load (`block.pontos`,
## indexed by the frame's `item_ancora_ponto`), found once; null where the file lacks one.
func _bind_points(rig: Dictionary, asset: Node3D, names: PackedStringArray) -> void:
	if names.is_empty():
		return
	var nodes: Array = []
	for n in names:
		nodes.append(asset.find_child(n, true, false))
	rig["pontos"] = nodes


## Removes the tracks of `anim` whose keys all hold the same value: the exported clips key
## every node of the element, also the ones the clip does not move (the door in `ciclo`),
## and such a track would put that node back at rest. Shared by every instance of the file,
## which all want the same.
static func _drop_static_tracks(anim: Animation) -> void:
	for k in range(anim.get_track_count() - 1, -1, -1):
		var n := anim.track_get_key_count(k)
		var still := true
		if n > 1:
			var first: Variant = anim.track_get_key_value(k, 0)
			for j in range(1, n):
				var v: Variant = anim.track_get_key_value(k, j)
				var same := false
				if first is Vector3:
					same = (first as Vector3).is_equal_approx(v)
				elif first is Quaternion:
					same = (first as Quaternion).is_equal_approx(v)
				elif first is float:
					same = is_equal_approx(first, v)
				else:
					same = first == v
				if not same:
					still = false
					break
		if still:
			anim.remove_track(k)


## Puts the clip `clip` (index into the block's `clips`, -1: none) of a Blender element at
## `fase` (0 to 1 of its length).
##
## Rest pose rule: when the clip changes, only the nodes the NEW clip moves go back to
## rest (the seek poses them anyway); the nodes only the old clip moved keep their last
## pose. So the door opened while the crew got in stays open through the setup and the
## process, and the leaving clip closes it from there (1 -> 0). When there is no clip any
## more (-1), every animated node goes back to rest.
func _drive_clip(rig: Dictionary, clip: int, fase: float) -> void:
	var player: AnimationPlayer = rig["anim"]
	var clips: PackedStringArray = rig["anim_clips"]
	var rest: Dictionary = rig["anim_rest"]
	var clip_id := &""
	if clip >= 0 and clip < clips.size():
		clip_id = StringName(clips[clip])
	var known := clip_id != &"" and player.has_animation(clip_id)
	if not known:
		clip = -1
	if clip != int(rig["anim_cur"]):
		rig["anim_cur"] = clip
		var held: Array = []
		if known:
			# The player puts back the nodes the new clip does not animate, even when not
			# deterministic: keep their pose here and set it again after every seek.
			var moved_now := {}
			for r in rest.get(String(clip_id), []):
				moved_now[r[0]] = true
			var seen := {}
			for nodes in rest.values():
				for r in nodes:
					var node: Node3D = r[0]
					if moved_now.has(node) or seen.has(node):
						continue
					seen[node] = true
					if not node.transform.is_equal_approx(r[1]):
						held.append([node, node.transform])
			for r in rest.get(String(clip_id), []):
				(r[0] as Node3D).transform = r[1]
			player.play(clip_id)
		else:
			player.stop(true)
			for nodes in rest.values():
				for r in nodes:
					(r[0] as Node3D).transform = r[1]
		rig["anim_held"] = held
	rig["anim_fase"] = clampf(fase, 0.0, 1.0) if known else 0.0
	if not known:
		return
	if not player.is_playing():
		player.play(clip_id)
	# Just short of the end: a clip that does not loop never "finishes" and stops.
	var length := player.get_animation(clip_id).length
	player.seek(minf(float(rig["anim_fase"]) * length, maxf(length - 1e-4, 0.0)), true)
	player.advance(0.0)
	for h in rig.get("anim_held", []):
		(h[0] as Node3D).transform = h[1]


## The clip a Blender element plays now (its name) and its phase (0 to 1), or ["", 0], as
## the bridge last set them.
func element_clip(i: int) -> Array:
	if i < 0 or i >= rigs.size() or not rigs[i].has("anim"):
		return ["", 0.0]
	var rig: Dictionary = rigs[i]
	var clip := int(rig["anim_cur"])
	var clips: PackedStringArray = rig["anim_clips"]
	if clip < 0 or clip >= clips.size():
		return ["", 0.0]
	return [clips[clip], float(rig["anim_fase"])]


## Whether node `node_name` of a Blender element is out of its rest pose (a door left
## open), or null when the element has no such animated node.
func element_node_moved(i: int, node_name: String) -> Variant:
	if i < 0 or i >= rigs.size() or not rigs[i].has("anim"):
		return null
	var rest: Dictionary = rigs[i]["anim_rest"]
	for nodes in rest.values():
		for r in nodes:
			var node: Node3D = r[0]
			if String(node.name) == node_name:
				return not node.transform.is_equal_approx(r[1])
	return null


## The seated driver of a forklift: the mannequin at its anchor point in the vehicle's
## root (it turns with the vehicle), driven like any other person.
func _add_driver(rig: Dictionary, root: Node3D, b: Dictionary, names: PackedStringArray) -> void:
	var info: Dictionary = b["driver"]
	var node := _instance({"source": "catalogue", "name": "pessoa_operador", "key": "pessoa_operador", "path": ""})
	if node == null:
		return
	node.name = "Motorista"
	node.position = info["position"]
	# Turned by `yaw`, then leaned forward about its side axis (`sentado_inclinar`; the
	# bridge already turned the root and the eyes about the hip).
	var yaw_basis := Basis(Vector3.UP, float(info["yaw"]))
	var lean := float(info.get("lean", 0.0))
	var side := yaw_basis * Vector3.RIGHT
	node.basis = (Basis(side, lean) * yaw_basis).scaled(Vector3.ONE * float(info["scale"]))
	root.add_child(node)
	var p := Pessoa.new()
	if not p.bind(node, _clips2, names):
		node.queue_free()
		return
	rig["driver"] = p
	rig["driver_node"] = node
	rig["driver_info"] = info
	node.visible = not drivers_off.has(String(b["name"]))


## The scene of an asset dictionary `{source, name, key, path}`, or null.
func _instance(a: Dictionary) -> Node3D:
	var key: String = a["source"] + ":" + a["key"]
	if a["source"] == "catalogue" and Pessoa._is_person(a["name"]) and ResourceLoader.exists(UAL1):
		return (load(UAL1) as PackedScene).instantiate() as Node3D
	if not _templates.has(key):
		_templates[key] = _load_template(a)
	var t = _templates[key]
	if t is PackedScene:
		return (t as PackedScene).instantiate() as Node3D
	if t is Node3D:
		return (t as Node3D).duplicate() as Node3D
	return null


func _load_template(a: Dictionary) -> Variant:
	match a["source"]:
		"modelos3d":
			var imported: String = MODELOS3D + a["name"] + ".glb"
			if ResourceLoader.exists(imported):
				return load(imported)
			if FileAccess.file_exists(a["path"]):
				return _from_gltf(PackedByteArray(), a["path"])
		"library":
			if a["key"] == a["name"]:
				var path: String = MODELOS + a["name"] + ".glb"
				if ResourceLoader.exists(path):
					return load(path)
			var bytes: PackedByteArray = playback.glb(a["key"])
			if bytes.is_empty():
				# A default asset that is not imported: the bridge generates it too.
				return null
			return _from_gltf(bytes, "")
		_:
			if FileAccess.file_exists(a["path"]):
				return _from_gltf(PackedByteArray(), a["path"])
	push_warning("modelo não encontrado: %s" % a)
	return null


func _from_gltf(bytes: PackedByteArray, path: String) -> Node3D:
	var doc := GLTFDocument.new()
	var state := GLTFState.new()
	var err := doc.append_from_file(path, state) if path != "" else doc.append_from_buffer(bytes, "", state)
	if err != OK:
		push_warning("glTF não carregou (%s): %d" % [path, err])
		return null
	return doc.generate_scene(state) as Node3D


## Named nodes of a library asset: forks (`carro`), wheels (`roda*`), status light (`luz`).
func _bind(rig: Dictionary, asset: Node) -> void:
	var wheels := []
	var stack: Array[Node] = [asset]
	while not stack.is_empty():
		var n: Node = stack.pop_back()
		stack.append_array(n.get_children())
		if not (n is Node3D):
			continue
		var nm := String(n.name)
		if nm == "carro" and not rig.has("carro"):
			rig["carro"] = n
			rig["carro_rest"] = (n as Node3D).position.y
		elif nm.begins_with("roda"):
			wheels.append([n, (n as Node3D).position.y, (n as Node3D).basis])
		elif nm == "luz" and not rig.has("light"):
			var mat := _own_light(n)
			if mat != null:
				rig["light"] = mat
	rig["wheels"] = wheels


## A material of its own for the `luz` node of one instance (each shows its own state).
func _own_light(n: Node) -> StandardMaterial3D:
	var own: StandardMaterial3D = null
	for mi in Pessoa._meshes(n):
		for s in mi.mesh.get_surface_count():
			var m := mi.mesh.surface_get_material(s)
			if own == null:
				own = (m.duplicate() if m is StandardMaterial3D else StandardMaterial3D.new()) as StandardMaterial3D
				own.emission_enabled = true
			mi.set_surface_override_material(s, own)
	return own


func _tint_named(asset: Node, material: String, color: Color) -> void:
	for mi in Pessoa._meshes(asset):
		for s in mi.mesh.get_surface_count():
			var m := mi.mesh.surface_get_material(s)
			if m != null and m.resource_name == material:
				mi.set_surface_override_material(s, _tinted(m, color))


func _tinted(original: Material, color: Color) -> Material:
	var key := "%d/%s" % [original.get_instance_id(), color.to_html()]
	if not _materials.has(key):
		var m := original.duplicate() as Material
		if m is BaseMaterial3D:
			(m as BaseMaterial3D).albedo_color = color
		_materials[key] = m
	return _materials[key]


func _plain(color: Color, rough := 0.6) -> StandardMaterial3D:
	var key := "plain/%s/%f" % [color.to_html(), rough]
	if not _materials.has(key):
		var m := StandardMaterial3D.new()
		m.albedo_color = color
		m.roughness = rough
		_materials[key] = m
	return _materials[key]


## The transform of `node` in the frame of its ancestor `frame` (no tree needed).
func _rel(frame: Node, node: Node) -> Transform3D:
	var t := Transform3D.IDENTITY
	var n := node
	while n != null and n != frame:
		if n is Node3D:
			t = (n as Node3D).transform * t
		n = n.get_parent()
	return t


## The box of the meshes under `node` (itself included), in the frame of `frame`.
func _box_in(frame: Node3D, node: Node) -> AABB:
	var box := AABB()
	var first := true
	var meshes: Array = node.find_children("*", "MeshInstance3D", true, false)
	if node is MeshInstance3D:
		meshes.append(node)
	for mi in meshes:
		var m := mi as MeshInstance3D
		if m.mesh == null:
			continue
		var b: AABB = _rel(frame, m) * m.get_aabb()
		box = b if first else box.merge(b)
		first = false
	return box


## Dimensions given in the model (`size`): the asset is stretched along each axis of the
## block (x length, y height, z width) to that box, standing on the floor at its centre.
## The asset turns under the root by quarter turns only, so the axes swap when it is
## turned sideways.
func _fit_to_size(root: Node3D, asset: Node3D, size: Vector3) -> void:
	var box := _box_in(root, asset)
	if box.size.x <= 1e-4 or box.size.y <= 1e-4 or box.size.z <= 1e-4:
		return
	var f := Vector3(size.x / box.size.x, size.y / box.size.y, size.z / box.size.z)
	var sideways := absf(sin(asset.rotation.y)) > 0.7
	var local := Vector3(f.z, f.y, f.x) if sideways else f
	asset.scale = asset.scale * local
	box = _box_in(root, asset)
	asset.position -= Vector3(box.get_center().x, box.position.y, box.get_center().z)


## The simple shape of a block without a realistic look (sources, sinks...), with the
## meshes of the Bevy viewer: the source cone points along the flow (+X), the combiner
## funnel points down, the dispatcher is a thin cone.
func _simple_shape(b: Dictionary) -> MeshInstance3D:
	var s: Vector3 = b["size"]
	var mi := MeshInstance3D.new()
	var c := CylinderMesh.new()
	c.height = 1.0
	match b["shape"]:
		"cone":
			c.top_radius = 0.0
			c.bottom_radius = 0.7
			mi.rotation = Vector3(0, 0, -PI / 2)
		"funnel":
			c.top_radius = 0.0
			c.bottom_radius = 1.0
			mi.rotation = Vector3(PI, 0, 0)
		"frustum":
			c.top_radius = 0.45
			c.bottom_radius = 1.0
		"cylinder":
			c.top_radius = 0.85
			c.bottom_radius = 0.85
		"flag":
			c.top_radius = 0.0
			c.bottom_radius = 0.25
			c.height = s.y
		_:
			var box := BoxMesh.new()
			box.size = s
			c = null
			mi.mesh = box
	if c != null:
		mi.mesh = c
	mi.position = Vector3(0, s.y * 0.5, 0)
	return mi


## Height of what is drawn under `root` (the top of its meshes in the root's frame), so
## the label floats above the model.
func _height(root: Node3D) -> float:
	var top := 0.0
	var inv := root.global_transform.affine_inverse()
	for mi in Pessoa._meshes(root):
		var t := inv * mi.global_transform
		var box := mi.get_aabb()
		for k in 8:
			top = maxf(top, (t * box.get_endpoint(k)).y)
	return top


## Floor (receives shadows), path network and connections.
func _draw_lines() -> void:
	var lo: Vector3 = info["bounds_min"]
	var hi: Vector3 = info["bounds_max"]
	var ground := MeshInstance3D.new()
	var plane := PlaneMesh.new()
	plane.size = Vector2(hi.x - lo.x + 30.0, hi.z - lo.z + 30.0)
	ground.mesh = plane
	ground.material_override = _plain(Color(0.30, 0.31, 0.32), 0.95)
	ground.position = Vector3((lo.x + hi.x) * 0.5, -0.004, (lo.z + hi.z) * 0.5)
	ground.name = "Piso"
	if show_floor:
		add_child(ground)
	else:
		ground.free()
	var im := ImmediateMesh.new()
	var lines := MeshInstance3D.new()
	lines.mesh = im
	lines.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	var mat := StandardMaterial3D.new()
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.vertex_color_use_as_albedo = true
	mat.vertex_color_is_srgb = true
	lines.material_override = mat
	im.surface_begin(Mesh.PRIMITIVE_LINES)
	var net: PackedVector3Array = info.get("network", PackedVector3Array())
	var ctl: PackedInt32Array = info.get("network_controlled", PackedInt32Array())
	var up := Vector3(0, 0.03, 0)
	for k in range(0, net.size() - 1, 2):
		var c := Color(1.0, 0.30, 0.25) if ctl.size() > k / 2 and ctl[k / 2] != 0 else Color(0.95, 0.75, 0.25)
		im.surface_set_color(c)
		im.surface_add_vertex(net[k] + up)
		im.surface_set_color(c)
		im.surface_add_vertex(net[k + 1] + up)
	var con: PackedInt32Array = info.get("connections", PackedInt32Array()) if show_connections else PackedInt32Array()
	var lift := Vector3(0, 0.05, 0)
	for k in range(0, con.size() - 1, 2):
		var a: Dictionary = blocks[con[k]]
		var b: Dictionary = blocks[con[k + 1]]
		if a["mobile"] or b["mobile"]:
			continue
		var c := Color(0.55, 0.62, 0.75)
		im.surface_set_color(c)
		im.surface_add_vertex((a["position"] as Vector3) + lift)
		im.surface_set_color(c)
		im.surface_add_vertex((b["position"] as Vector3) + lift)
	# Keep the surface valid when there is nothing to draw.
	im.surface_set_color(Color(0, 0, 0, 0))
	im.surface_add_vertex(Vector3.ZERO)
	im.surface_add_vertex(Vector3.ZERO)
	im.surface_end()
	lines.name = "Linhas"
	add_child(lines)


## Heights above the floor (m) of each pattern of the marking, so the zebra lies over the
## lines and the arrows over both and none of them fights the floor in the depth buffer.
const MARK_HEIGHT := {"continuous": 0.006, "zebra": 0.009, "arrow": 0.012}


## The floor marking of the circulation aisles (`UtsimPlayback.floor_marks`): continuous
## lines, zebra stripes at the crossings and arrows of one-way aisles, as thin coloured
## meshes just above the floor. One mesh for all of them (vertex colours).
func _draw_marks() -> void:
	mark_counts = {}
	if playback == null or not playback.has_method("floor_marks"):
		return
	var marks: Array = playback.floor_marks()
	if marks.is_empty():
		return
	var verts := PackedVector3Array()
	var colors := PackedColorArray()
	var indices := PackedInt32Array()
	var normals := PackedVector3Array()
	for m in marks:
		var poly: PackedVector3Array = m["polygon"]
		if poly.size() < 3:
			continue
		var pattern: String = m["pattern"]
		mark_counts[pattern] = int(mark_counts.get(pattern, 0)) + 1
		var y: float = MARK_HEIGHT.get(pattern, 0.006)
		var base := verts.size()
		for p in poly:
			verts.append(Vector3(p.x, y, p.z))
			colors.append(m["color"])
			normals.append(Vector3.UP)
		for k in range(1, poly.size() - 1):
			indices.append_array(PackedInt32Array([base, base + k, base + k + 1]))
	if verts.is_empty():
		return
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = verts
	arrays[Mesh.ARRAY_NORMAL] = normals
	arrays[Mesh.ARRAY_COLOR] = colors
	arrays[Mesh.ARRAY_INDEX] = indices
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	var mat := StandardMaterial3D.new()
	mat.vertex_color_use_as_albedo = true
	mat.vertex_color_is_srgb = true
	mat.roughness = 0.85
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	var mi := MeshInstance3D.new()
	mi.name = "Faixas"
	mi.mesh = mesh
	mi.material_override = mat
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(mi)


## Belts drawn by nodes and ramps of the floor paths (`trajeto_malha.gd`): the belt's
## asset gives way to the shape built along its route. The belts that scroll, by block:
## [material, speed (m/s)].
var route_belts: Array = []
var _trajetos: Object


func _build_routes() -> void:
	route_belts = []
	if playback == null or not ClassDB.class_exists("UtsimTrajetos"):
		return
	var tr: Object = ClassDB.instantiate("UtsimTrajetos")
	_trajetos = tr
	for r in tr.call("da_cena", playback):
		var i := int(r["block"])
		if i < 0 or i >= rigs.size():
			continue
		var rig: Dictionary = rigs[i]
		for key in ["asset", "simple"]:
			if rig.has(key):
				(rig[key] as Node3D).visible = false
		var node := TrajetoMalha.belt(r)
		(rig["root"] as Node3D).add_child(node)
		rig["trajeto"] = node
		var m = (node.get_meta("belt_material") if node.has_meta("belt_material") else null)
		route_belts.append([m, float(r.get("speed", 0.0)), node.get_meta("drums", []), (node.get_meta("rollers") if node.has_meta("rollers") else null)])
		# The label over the middle of the route, above its highest point.
		var line: PackedVector3Array = r["line"]
		var top := 0.0
		for p in line:
			top = maxf(top, p.y)
		if rig.has("label"):
			var mid := line[line.size() / 2]
			var root: Node3D = rig["root"]
			(rig["label"] as Node3D).position = root.to_local(Vector3(mid.x, top + 0.6, mid.z))
	for c in tr.call("caminhos_da_cena", playback):
		var deck := TrajetoMalha.ramp(c)
		if deck != null:
			add_child(deck)


## Scrolls the belts drawn by nodes as far as their surface really moved by `t`
## (`UtsimTrajetos.avancos`: stopped by a breakdown, a shift or, without accumulation,
## the front item waiting); the drums and rollers turn with it.
func _scroll_routes(t: float) -> void:
	if route_belts.is_empty() or playback == null:
		return
	var moved := PackedFloat64Array()
	if _trajetos != null:
		moved = _trajetos.call("avancos", playback, t)
	for k in route_belts.size():
		var b: Array = route_belts[k]
		var s: float = moved[k] if k < moved.size() else t * float(b[1])
		if b[0] != null:
			var m: StandardMaterial3D = b[0]
			m.uv1_offset.x = -fposmod(s / TrajetoMalha.STRIPE, 1.0)
		TrajetoMalha.roll(b[2], s)
		if b.size() > 3 and b[3] != null:
			TrajetoMalha.roll_rollers(b[3], s)


## Applies the frame at `t`. `dt`: real time since the last call (clip crossfades);
## `snap`: no crossfade (a jump, a capture).
func apply(t: float, dt: float, snap := false) -> void:
	if playback == null:
		return
	var t0 := Time.get_ticks_usec()
	_scroll_routes(t)
	var f: Dictionary = playback.frame(t)
	var t1 := Time.get_ticks_usec()
	var pos: PackedVector3Array = f["position"]
	var yaw: PackedFloat32Array = f["yaw"]
	var lift: PackedFloat32Array = f["lift"]
	var rolled: PackedFloat32Array = f["rolled"]
	var clip: PackedInt32Array = f["clip"]
	var clip_time: PackedFloat32Array = f["clip_time"]
	var anim_clip: PackedInt32Array = f.get("anim_clip", PackedInt32Array())
	var anim_fase: PackedFloat32Array = f.get("anim_fase", PackedFloat32Array())
	var anim_extra: PackedFloat32Array = f.get("anim_extra", PackedFloat32Array())
	for i in _animated:
		if i < anim_clip.size():
			_drive_clip(rigs[i], anim_clip[i], anim_fase[i])
			# A rack cell above the fork clip's travel: the clip ends at its top and the
			# carriage goes on up by the rest (the seek above put it back every frame).
			if i < anim_extra.size() and anim_extra[i] > 0.0 and rigs[i].has("anim_carro"):
				(rigs[i]["anim_carro"] as Node3D).position.y += anim_extra[i]
	for i in mobiles:
		var rig: Dictionary = rigs[i]
		var root: Node3D = rig["root"]
		root.position = pos[i]
		root.basis = Basis(Vector3.UP, yaw[i])
		var scale := float(blocks[i].get("scale", 1.0))
		if rig.has("carro"):
			var c: Node3D = rig["carro"]
			c.position.y = float(rig["carro_rest"]) + (lift[i] - FORK_REST) / scale
		for w in rig.get("wheels", []):
			var radius: float = w[1]
			if radius > 1e-3:
				var angle := -fposmod(rolled[i] / radius, TAU)
				(w[0] as Node3D).basis = (w[2] as Basis) * Basis(Vector3(0, 0, 1), angle)
		if rig.has("person"):
			(rig["person"] as Pessoa).drive(clip[i], clip_time[i], dt, snap)
		if rig.has("driver"):
			(rig["driver"] as Pessoa).drive(clip[i], clip_time[i], dt, snap)
	task_target = f.get("task_target", PackedVector3Array())
	# C7: a source that just lost an item blinks red.
	var flash: PackedFloat32Array = f.get("flash", PackedFloat32Array())
	for i in mini(flash.size(), rigs.size()):
		if rigs[i].has("preview_material"):
			var m: StandardMaterial3D = rigs[i]["preview_material"]
			var on := flash[i] > 0.0 and fmod(flash[i] * 6.0, 1.0) > 0.5
			m.albedo_color = Color(1.0, 0.25, 0.2) if on else rigs[i]["preview_color"]
	var color: PackedColorArray = f["color"]
	var label: PackedStringArray = f["label"]
	for i in rigs.size():
		var rig: Dictionary = rigs[i]
		if _last_color[i] != color[i]:
			_last_color[i] = color[i]
			if rig.has("light"):
				var m: StandardMaterial3D = rig["light"]
				m.albedo_color = color[i]
				m.emission = color[i]
				m.emission_energy_multiplier = 1.5
			elif rig.has("simple"):
				(rig["simple"] as MeshInstance3D).material_override = _plain(color[i])
		if _last_label[i] != label[i]:
			_last_label[i] = label[i]
			set_label_text(rig["label"], label[i])
	_apply_items(f)
	if camada != null:
		camada.aplicar(t)
	if not fluid_nodes.is_empty():
		_apply_fluids(playback.fluid_frame(t))
	last_bridge_us = t1 - t0
	last_apply_us = Time.get_ticks_usec() - t1


func _apply_items(f: Dictionary) -> void:
	var ids: PackedInt64Array = f["item_id"]
	var ipos: PackedVector3Array = f["item_position"]
	var iyaw: PackedFloat32Array = f["item_yaw"]
	var iscale: PackedFloat32Array = f["item_scale"]
	var icolor: PackedColorArray = f["item_color"]
	var carrier: PackedInt32Array = f["item_carrier"]
	var stack: PackedInt32Array = f["item_stack"]
	var anchor_block: PackedInt32Array = f.get("item_ancora_bloco", PackedInt32Array())
	var anchor_point: PackedInt32Array = f.get("item_ancora_ponto", PackedInt32Array())
	_anchored.clear()
	var seen := {}
	for k in ids.size():
		var id := ids[k]
		seen[id] = true
		var node: Node3D = items.get(id)
		if node == null:
			node = _new_item(icolor[k])
			items[id] = node
		var p := ipos[k]
		var s := iscale[k]
		var basis := Basis(Vector3.UP, iyaw[k]).scaled(Vector3.ONE * s)
		var c := carrier[k]
		if c >= 0 and rigs[c].has("person"):
			# Between the hands of a skeletal person (never inside the chest).
			var hands = (rigs[c]["person"] as Pessoa).hands()
			if hands != null:
				var root: Node3D = rigs[c]["root"]
				var size := s * ITEM_SIZE
				var local: Vector3 = root.global_transform.affine_inverse() * (hands as Vector3)
				local.x = maxf(local.x, size * 0.5 + 0.04)
				local.y += stack[k] * size
				p = root.global_transform * local
				basis = root.global_transform.basis.orthonormalized().scaled(Vector3.ONE * s)
		var at := _anchor_node(anchor_block, anchor_point, k)
		if at != null:
			# On a point of a Blender element, posed by the clip already (the gripper, the
			# forks, the deck): the item's base on the point, the stack on top.
			var g := at.global_transform
			var size := s * ITEM_SIZE
			p = g.origin + Vector3.UP * (size * 0.5 + stack[k] * size)
			basis = g.basis.orthonormalized().scaled(Vector3.ONE * s)
			_anchored.append([anchor_block[k], anchor_point[k], node])
		node.transform = Transform3D(basis, p)
		node.visible = _item_near(p)
	for id in items.keys():
		if not seen.has(id):
			var n: Node3D = items[id]
			n.visible = false
			items.erase(id)
			n.queue_free()


## How many items of the last frame sit on point `point_name` of block `i` (anchored to
## it and drawn within 0.6 m of its node).
func items_at_point(i: int, point_name: String) -> int:
	if i < 0 or i >= rigs.size() or not rigs[i].has("pontos"):
		return 0
	var names: PackedStringArray = blocks[i].get("pontos", PackedStringArray())
	var nodes: Array = rigs[i]["pontos"]
	var n := 0
	for a in _anchored:
		if int(a[0]) != i or int(a[1]) >= names.size() or names[int(a[1])] != point_name:
			continue
		var at := nodes[int(a[1])] as Node3D
		if at != null and (a[2] as Node3D).global_position.distance_to(at.global_position) < 0.6:
			n += 1
	return n


## Height (global y) of point `point_name` of block `i`'s Blender element, or NAN.
func point_height(i: int, point_name: String) -> float:
	if i < 0 or i >= rigs.size() or not rigs[i].has("pontos"):
		return NAN
	var names: PackedStringArray = blocks[i].get("pontos", PackedStringArray())
	var k := names.find(point_name)
	var nodes: Array = rigs[i]["pontos"]
	if k < 0 or k >= nodes.size() or nodes[k] == null:
		return NAN
	return (nodes[k] as Node3D).global_position.y


## The point node item `k` of the frame goes to, or null.
func _anchor_node(blocks_of: PackedInt32Array, points_of: PackedInt32Array, k: int) -> Node3D:
	if k >= blocks_of.size() or k >= points_of.size():
		return null
	var b := blocks_of[k]
	var pt := points_of[k]
	if b < 0 or b >= rigs.size() or pt < 0 or not rigs[b].has("pontos"):
		return null
	var nodes: Array = rigs[b]["pontos"]
	if pt >= nodes.size():
		return null
	return nodes[pt] as Node3D


## The ring of a source's item types (C7): a flat ring around `at`, one slice per type
## in its colour, as wide as its share.
func _type_ring(mix: Array, at: Vector3) -> MeshInstance3D:
	var im := ImmediateMesh.new()
	im.surface_begin(Mesh.PRIMITIVE_TRIANGLES)
	var r0 := 0.2
	var r1 := 0.3
	var a := 0.0
	for pair in mix:
		var col: Color = pair[0]
		var span := TAU * float(pair[1])
		var steps := maxi(2, int(ceil(span / 0.2)))
		for k in steps:
			var t0 := a + span * k / steps
			var t1 := a + span * (k + 1) / steps
			var p := [Vector3(cos(t0) * r0, 0, sin(t0) * r0), Vector3(cos(t0) * r1, 0, sin(t0) * r1),
				Vector3(cos(t1) * r1, 0, sin(t1) * r1), Vector3(cos(t1) * r0, 0, sin(t1) * r0)]
			for j in [0, 1, 2, 0, 2, 3]:
				im.surface_set_color(col)
				im.surface_add_vertex(p[j])
		a += span
	im.surface_end()
	var mi := MeshInstance3D.new()
	mi.name = "AnelTipos"
	mi.mesh = im
	var m := StandardMaterial3D.new()
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	m.vertex_color_use_as_albedo = true
	m.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi.material_override = m
	mi.position = at
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	return mi


## An item: a pallet with 2 x 2 x 2 boxes in a scene with pallet loads, else one box,
## filling the ITEM_SIZE cube (origin at its centre), cardboard tinted by the origin.
func _new_item(origin: Color) -> Node3D:
	var node := Node3D.new()
	add_child(node)
	var card := Color("b8875a").lerp(origin, 0.35)
	var e := ITEM_SIZE
	var half := e * 0.5
	var caixa := _instance({"source": "library", "name": "caixa", "key": "caixa", "path": ""})
	if not _pallets:
		if caixa != null:
			var k := e / 0.40
			caixa.position = Vector3(0, -half, 0)
			caixa.scale = Vector3.ONE * k
			_tint_named(caixa, "papelao", card)
			node.add_child(caixa)
		return node
	var palete := _instance({"source": "library", "name": "palete", "key": "palete", "path": ""})
	var k := e / 1.2
	if palete != null:
		palete.position = Vector3(0, -half, 0)
		palete.scale = Vector3.ONE * k
		node.add_child(palete)
	var deck := -half + 0.144 * k
	var w := 1.2 * k
	var d := 1.0 * k
	var layer := (e - 0.144 * k) / 2.0
	var sc := Vector3((w / 2.0 - 0.004) / 0.40, (layer - 0.003) / 0.30, (d / 2.0 - 0.004) / 0.30)
	for level in 2:
		for corner in [Vector2(-1, -1), Vector2(1, -1), Vector2(-1, 1), Vector2(1, 1)]:
			var bx := caixa.duplicate() as Node3D if caixa != null else null
			if bx == null:
				continue
			bx.position = Vector3(corner.x * w / 4.0, deck + level * layer, corner.y * d / 4.0)
			bx.scale = sc
			_tint_named(bx, "papelao", card)
			node.add_child(bx)
	if caixa != null:
		caixa.free()
	return node


## Whether the vehicle `name` has a driver to show (a forklift with a seat).
func has_driver(name: String) -> bool:
	var i := block_index(name)
	return i >= 0 and rigs[i].has("driver")


## Whether the driver of `name` is shown (false without a driver).
func driver_visible(name: String) -> bool:
	return has_driver(name) and not drivers_off.has(name)


## "Mostrar motorista": shows or hides the driver of the vehicle `name`.
func set_driver_visible(name: String, on: bool) -> void:
	if on:
		drivers_off.erase(name)
	else:
		drivers_off[name] = true
	var i := block_index(name)
	if i >= 0 and rigs[i].has("driver_node"):
		(rigs[i]["driver_node"] as Node3D).visible = on and not _view_hidden.has(i)


## The driver's eyes in the world, or null when the vehicle has no driver (the camera
## "Do recurso" sits there).
func driver_eye(i: int) -> Variant:
	if i < 0 or i >= rigs.size() or not rigs[i].has("driver_info"):
		return null
	var root: Node3D = rigs[i]["root"]
	return root.global_transform * (rigs[i]["driver_info"]["eye"] as Vector3)


## Block index by name, or -1.
func block_index(name: String) -> int:
	for i in blocks.size():
		if blocks[i]["name"] == name:
			return i
	return -1


## Where block `i` is drawn now (its root), and its height.
func block_focus(i: int) -> Vector3:
	var root: Node3D = rigs[i]["root"]
	return root.global_position + Vector3(0, (blocks[i]["size"] as Vector3).y * 0.5, 0)


## Draws everything see-through and without shadows (the ghost of the object being placed).
func set_ghost(opacity: float) -> void:
	var stack: Array[Node] = [self]
	while not stack.is_empty():
		var n: Node = stack.pop_back()
		stack.append_array(n.get_children())
		if n is Label3D:
			(n as Label3D).visible = false
		elif n is GeometryInstance3D:
			var g := n as GeometryInstance3D
			g.transparency = 1.0 - opacity
			g.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF


## Look of the name labels over the objects: a thin outline and, behind the text, a dark
## translucent plate (`Placa`, a child quad drawn with the same billboard and fixed size as
## the label), so a name stays readable over the floor grid, a model or another label.
static func _style_label(label: Label3D) -> void:
	label.outline_size = 4
	label.outline_modulate = Color(0.04, 0.05, 0.07, 0.9)
	label.render_priority = 10
	label.outline_render_priority = 9
	var plate := MeshInstance3D.new()
	plate.name = "Placa"
	plate.mesh = QuadMesh.new()
	plate.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	var m := StandardMaterial3D.new()
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	m.billboard_mode = BaseMaterial3D.BILLBOARD_ENABLED
	m.fixed_size = true
	m.no_depth_test = true
	m.albedo_color = Color(0.07, 0.08, 0.11, 0.78)
	m.render_priority = 8
	plate.material_override = m
	label.add_child(plate)
	_fit_plate(label)


## Text of a label, with its plate resized to the new text.
static func set_label_text(label: Label3D, text: String) -> void:
	label.text = text
	_fit_plate(label)


static func _fit_plate(label: Label3D) -> void:
	var plate := label.get_node_or_null("Placa") as MeshInstance3D
	if plate == null:
		return
	plate.visible = label.text != ""
	var font: Font = label.font if label.font != null else ThemeDB.fallback_font
	var px := font.get_multiline_string_size(label.text, HORIZONTAL_ALIGNMENT_CENTER, -1, label.font_size)
	# Padding of about 10 px on the sides and 4 px above and below, at the label's scale.
	(plate.mesh as QuadMesh).size = Vector2(px.x + 20.0, px.y + 8.0) * label.pixel_size


func set_labels_visible(on: bool) -> void:
	labels_visible = on
	for rig in rigs:
		(rig["label"] as Label3D).visible = on


# ---------------------------------------------------------------------------
# Fluids (G3)
# ---------------------------------------------------------------------------


## A material of its own, so each tank and pipe shows its own colour.
func _own(color: Color, alpha := 1.0) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = Color(color, alpha)
	m.roughness = 0.4
	if alpha < 1.0:
		m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		m.cull_mode = BaseMaterial3D.CULL_DISABLED
	_fluid_materials.append(m)
	return m


## A transform that stretches a unit cylinder (along +Y, centred) from `a` to `b`.
static func _segment(a: Vector3, b: Vector3, radius: float) -> Transform3D:
	var d := b - a
	var length := maxf(d.length(), 1e-4)
	var y := d / length
	var x := y.cross(Vector3.UP)
	if x.length() < 1e-4:
		x = y.cross(Vector3.RIGHT)
	x = x.normalized()
	var z := x.cross(y).normalized()
	return Transform3D(Basis(x * radius, y * length, z * radius), (a + b) * 0.5)


## The fluid network of the scene: tanks as a see-through shell with the liquid inside
## (its height is the level), the other nodes as coloured markers, the pipes between the
## ports and the converters' lines to their discrete object (`UtsimPlayback` gives the
## layout; `fluid_frame(t)` the levels and rates).
func _build_fluids() -> void:
	for f in info.get("fluids", []):
		var root := Node3D.new()
		root.name = "fluido_" + String(f["name"])
		root.position = f["position"]
		add_child(root)
		var e := {"root": root, "shape": f["shape"], "height": float(f["height"])}
		var r := float(f["radius"])
		var h := float(f["height"])
		if f["shape"] == "tank":
			var shell := MeshInstance3D.new()
			var cyl := CylinderMesh.new()
			cyl.top_radius = r
			cyl.bottom_radius = r
			cyl.height = h
			shell.mesh = cyl
			shell.material_override = _own(Color(0.75, 0.85, 0.95), 0.22)
			shell.position = Vector3(0, h * 0.5, 0)
			shell.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			root.add_child(shell)
			var liquid := MeshInstance3D.new()
			var lc := CylinderMesh.new()
			lc.top_radius = r * 0.94
			lc.bottom_radius = r * 0.94
			lc.height = 1.0
			liquid.mesh = lc
			liquid.material_override = _own(Color(0.12, 0.45, 0.95))
			root.add_child(liquid)
			e["liquid"] = liquid
		else:
			var marker := MeshInstance3D.new()
			if f["shape"] == "pipe":
				var sphere := SphereMesh.new()
				sphere.radius = r
				sphere.height = r * 2.0
				marker.mesh = sphere
			else:
				var box := BoxMesh.new()
				box.size = Vector3(r, r, r) * 2.0
				marker.mesh = box
			marker.material_override = _own(Color(0.6, 0.6, 0.6))
			marker.position = Vector3(0, r, 0)
			root.add_child(marker)
			e["marker"] = marker
		var label := Label3D.new()
		label.text = String(f["name"])
		label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
		label.fixed_size = true
		label.no_depth_test = true
		label.pixel_size = 0.0006
		label.font_size = 24
		label.modulate = Color(0.75, 0.88, 1.0)
		_style_label(label)
		label.position = Vector3(0, h + 0.35, 0)
		root.add_child(label)
		e["label"] = label
		fluid_nodes.append(e)
	var nodes: Array = info.get("fluids", [])
	var links: PackedInt32Array = info.get("fluid_links", PackedInt32Array())
	for k in range(0, links.size() - 1, 2):
		var a: Dictionary = nodes[links[k]]
		var b: Dictionary = nodes[links[k + 1]]
		var pa: Vector3 = (a["position"] as Vector3) + Vector3(0, float(a["port"]), 0)
		var pb: Vector3 = (b["position"] as Vector3) + Vector3(0, float(b["port"]), 0)
		var dir := (pb - pa).normalized()
		pa += dir * float(a["radius"])
		pb -= dir * float(b["radius"])
		var pipe := MeshInstance3D.new()
		var cyl := CylinderMesh.new()
		cyl.top_radius = 1.0
		cyl.bottom_radius = 1.0
		cyl.height = 1.0
		cyl.radial_segments = 10
		pipe.mesh = cyl
		pipe.transform = _segment(pa, pb, 0.07)
		pipe.material_override = _own(Color(0.30, 0.42, 0.52))
		pipe.name = "tubo_%d" % (k / 2)
		add_child(pipe)
		fluid_pipes.append(pipe)
	for c in info.get("fluid_converters", []):
		var n: Dictionary = nodes[int(c["node"])]
		var blk: Dictionary = blocks[int(c["block"])]
		var pa: Vector3 = (n["position"] as Vector3) + Vector3(0, 0.3, 0)
		var pb: Vector3 = (blk["position"] as Vector3) + Vector3(0, 0.3, 0)
		var line := MeshInstance3D.new()
		var cyl := CylinderMesh.new()
		cyl.top_radius = 1.0
		cyl.bottom_radius = 1.0
		cyl.height = 1.0
		cyl.radial_segments = 6
		line.mesh = cyl
		line.transform = _segment(pa, pb, 0.03)
		line.material_override = _own(Color(0.75, 0.45, 0.95))
		add_child(line)


func _apply_fluids(ff: Dictionary) -> void:
	var fill: PackedFloat32Array = ff.get("fill", PackedFloat32Array())
	var color: PackedColorArray = ff.get("color", PackedColorArray())
	var text: PackedStringArray = ff.get("text", PackedStringArray())
	var active: PackedInt32Array = ff.get("link_active", PackedInt32Array())
	for i in mini(fluid_nodes.size(), fill.size()):
		var e: Dictionary = fluid_nodes[i]
		if e.has("liquid"):
			var h := float(e["height"]) * 0.98
			var level := maxf(fill[i] * h, 0.001)
			var liquid: MeshInstance3D = e["liquid"]
			liquid.scale = Vector3(1, level, 1)
			liquid.position = Vector3(0, level * 0.5 + 0.01, 0)
			(liquid.material_override as StandardMaterial3D).albedo_color = color[i]
		elif e.has("marker"):
			(( e["marker"] as MeshInstance3D).material_override as StandardMaterial3D).albedo_color = color[i]
		if (e["label"] as Label3D).text != text[i]:
			set_label_text(e["label"], text[i])
	for k in mini(fluid_pipes.size(), active.size()):
		var c := Color(0.25, 0.85, 0.95) if active[k] != 0 else Color(0.30, 0.42, 0.52)
		((fluid_pipes[k] as MeshInstance3D).material_override as StandardMaterial3D).albedo_color = c


## Filled fraction of every tank now (scripted checks), `-1` for the other nodes.
func fluid_fill() -> PackedFloat32Array:
	var out := PackedFloat32Array()
	for e in fluid_nodes:
		if e.has("liquid"):
			out.append((e["liquid"] as MeshInstance3D).scale.y / maxf(float(e["height"]) * 0.98, 1e-6))
		else:
			out.append(-1.0)
	return out


# ---------------------------------------------------------------------------
# Level of detail (G3)
# ---------------------------------------------------------------------------


func _item_near(p: Vector3) -> bool:
	var cam := get_viewport().get_camera_3d() if is_inside_tree() else null
	return cam == null or cam.global_position.distance_to(p) <= ITEM_DISTANCE


## Shows only the `MAX_LABELS` labels nearest to `cam` within `LABEL_DISTANCE` (the
## others would pile up on screen in a large model). Call it every few frames.
func limit_labels(cam: Camera3D) -> void:
	if cam == null:
		return
	if not labels_visible:
		_labels_shown = 0
		return
	var order := []
	for i in rigs.size():
		var root: Node3D = rigs[i]["root"]
		order.append([cam.global_position.distance_squared_to(root.global_position), i])
	order.sort_custom(func(a, b): return a[0] < b[0])
	var max_d := LABEL_DISTANCE * LABEL_DISTANCE
	var shown := 0
	for k in order.size():
		var on: bool = shown < MAX_LABELS and float(order[k][0]) <= max_d
		(rigs[order[k][1]]["label"] as Label3D).visible = on
		if on:
			shown += 1
	_labels_shown = shown


## Labels drawn after the last `limit_labels` (scripted checks).
func labels_shown() -> int:
	return _labels_shown


# ---------------------------------------------------------------------------
# Visual checks (G3)
# ---------------------------------------------------------------------------


## Meshes drawn between `eye` and `aim` or within `margin` of the eye (the floor, the
## lines and hidden meshes aside): what would block a camera there. Each entry is
## `"block/mesh"`, with the distance to the eye.
func meshes_blocking(eye: Vector3, aim: Vector3, margin: float) -> PackedStringArray:
	var out := PackedStringArray()
	var stack: Array[Node] = [self]
	while not stack.is_empty():
		var n: Node = stack.pop_back()
		stack.append_array(n.get_children())
		if not (n is MeshInstance3D):
			continue
		var mi := n as MeshInstance3D
		if not mi.is_visible_in_tree() or mi.mesh == null or String(mi.name) in ["Piso", "Linhas"]:
			continue
		var box := mi.global_transform * mi.get_aabb()
		var near := box.grow(margin)
		if near.has_point(eye) or box.intersects_segment(eye, aim):
			var path := String(get_path_to(mi))
			var d := eye.distance_to(box.get_center())
			out.append("%s (%.1f m)" % [path, d])
	return out


## Hides what would block a camera at `eye` looking towards `aim`: the meshes of block
## `own` (the vehicle the camera rides) on the first 3 m of the sight line, and the
## meshes of any other block within `VIEW_MARGIN` of the eye or on its first metre (a
## vehicle parked on a source or driving through a machine). What an earlier call hid is shown again first.
func clear_view(eye: Vector3, aim: Vector3, own: int) -> void:
	restore_view()
	# The camera is in the driver's head: the driver is not drawn from there.
	if own >= 0 and own < rigs.size() and rigs[own].has("driver_node"):
		(rigs[own]["driver_node"] as Node3D).visible = false
		_view_hidden[own] = true
	var dir := (aim - eye).normalized()
	for i in rigs.size():
		var root: Node3D = rigs[i]["root"]
		if i != own and root.global_position.distance_to(eye) > 8.0:
			continue
		var near := eye + dir * (3.0 if i == own else 1.0)
		for mi in Pessoa._meshes(root):
			if not mi.visible:
				continue
			var box := mi.global_transform * mi.get_aabb()
			if box.grow(VIEW_MARGIN).has_point(eye) or box.intersects_segment(eye, near):
				mi.visible = false
				_hidden_for_view.append(mi)
				_blocks_hidden_for_view[i] = true


## Whether `clear_view` hid block `i` (its driver or meshes of it) for the camera's view.
func hidden_for_view(i: int) -> bool:
	return _view_hidden.has(i) or _blocks_hidden_for_view.has(i)


## Shows again what `clear_view` hid.
func restore_view() -> void:
	for i in _view_hidden:
		if i < rigs.size() and rigs[i].has("driver_node"):
			(rigs[i]["driver_node"] as Node3D).visible = not drivers_off.has(String(blocks[i]["name"]))
	_view_hidden.clear()
	_blocks_hidden_for_view.clear()
	for mi in _hidden_for_view:
		if is_instance_valid(mi):
			mi.visible = true
	_hidden_for_view.clear()


## Bounding box of the fluid network as drawn (tanks, markers, pipes), `[lo, hi]`; empty
## without fluids.
func fluid_bounds() -> Array:
	var box := AABB()
	var first := true
	var parts: Array = []
	for e in fluid_nodes:
		parts.append_array(Pessoa._meshes(e["root"]))
	parts.append_array(fluid_pipes)
	for mi in parts:
		var b: AABB = (mi as MeshInstance3D).global_transform * (mi as MeshInstance3D).get_aabb()
		box = b if first else box.merge(b)
		first = false
	return [] if first else [box.position, box.end]
