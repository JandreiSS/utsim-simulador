## The 3D scene of a playback: builds the static layout from
## `UtsimPlayback.static_scene()` once and applies `UtsimPlayback.frame(t)` every frame.
##
## Positions arrive in Godot coordinates (the bridge converts `(x, y, z)` of the model to
## `(x, z, -y)`), so nothing here converts. Assets, as the Bevy viewer chooses them
## (`crates/utsim-godot/src/looks.rs`):
## - library assets with default parameters are the imported `.glb` of
##   `res://importados/modelos/` (copies of `assets/modelos/`, see `scripts/godot.sh`);
## - parametric ones (a rack with its own bays, a conveyor of its own length) are
##   generated by the bridge (`UtsimPlayback.glb(key)`) and loaded with GLTFDocument;
## - the skeletal person is the imported UAL mannequin ([Pessoa]); other catalogue
##   entries and user files are read from disk with GLTFDocument.
## Per frame only the mobiles move; colours and labels change only when they differ.
class_name CenaUtsim
extends Node3D

const MODELOS := "res://importados/modelos/"
const UAL1 := "res://importados/terceiros/quaternius_ual/UAL1_Standard.glb"
const UAL2 := "res://importados/terceiros/quaternius_ual2/UAL2_Standard.glb"
## Fork height at rest of the library forklift (`utsim_assets::dims::FORK_REST`).
const FORK_REST := 0.10
## Edge of the scene's item cube (`utsim_scene::compose::ITEM_SIZE`).
const ITEM_SIZE := 0.3

var playback: Object
var info: Dictionary
var blocks: Array = []
## Per block: {root, asset, carro, carro_rest, wheels, light, mesh_material, person, label}.
var rigs: Array = []
var mobiles := PackedInt32Array()
var items := {}
var _item_spare: Array[Node3D] = []
var _templates := {}
var _materials := {}
var _last_color: Array = []
var _last_label: Array = []
var _pallets := false
var _clips2: AnimationLibrary
var labels_visible := true
## Time spent in the last `frame()` call of the bridge and in applying it, microseconds.
var last_bridge_us := 0
var last_apply_us := 0


## Whether the skeletal person files are imported (the bridge then gives people the
## mannequin; else the procedural operator).
static func skeletal_available() -> bool:
	return ResourceLoader.exists(UAL1) and ResourceLoader.exists(UAL2)


func clear() -> void:
	for c in get_children():
		c.queue_free()
	for t in _templates.values():
		if t is Node:
			(t as Node).free()
	_templates.clear()
	_materials.clear()
	blocks.clear()
	rigs.clear()
	items.clear()
	_item_spare.clear()
	mobiles.clear()
	_last_color.clear()
	_last_label.clear()
	playback = null


func _notification(what: int) -> void:
	if what == NOTIFICATION_PREDELETE:
		for t in _templates.values():
			if t is Node:
				(t as Node).free()
		_templates.clear()


## Builds everything static of `pb` (a UtsimPlayback).
func build(pb: Object) -> void:
	clear()
	playback = pb
	info = pb.static_scene()
	_pallets = info.get("pallets", false)
	blocks = info["blocks"]
	if skeletal_available():
		var scene2 := load(UAL2) as PackedScene
		if scene2 != null:
			var tmp := scene2.instantiate()
			var player := Pessoa._find(tmp, "AnimationPlayer") as AnimationPlayer
			if player != null:
				_clips2 = player.get_animation_library(&"")
			tmp.free()
	var names: PackedStringArray = pb.person_clips()
	var durations_set := false
	for i in blocks.size():
		var b: Dictionary = blocks[i]
		var rig := {}
		var root := Node3D.new()
		root.name = "b%d_%s" % [i, b["name"]]
		add_child(root)
		root.position = b["position"]
		rig["root"] = root
		var asset: Node3D = null
		if b.has("asset"):
			asset = _instance(b["asset"])
		if asset != null:
			asset.position = b.get("offset", Vector3.ZERO)
			asset.rotation = Vector3(0, b.get("asset_yaw", 0.0), 0)
			asset.scale = Vector3.ONE * float(b.get("scale", 1.0))
			root.add_child(asset)
			rig["asset"] = asset
			if b.has("color") and not b.get("skeletal", false):
				_tint_named(asset, "pintura", b["color"])
			_bind(rig, asset)
			if b.get("skeletal", false):
				var p := Pessoa.new()
				if p.bind(asset, _clips2, names):
					rig["person"] = p
					if not durations_set:
						pb.set_clip_durations(p.durations)
						durations_set = true
		else:
			var mi := _simple_shape(b)
			root.add_child(mi)
			rig["simple"] = mi
		# Labels as in the Bevy viewer: same size on screen, never hidden by the models.
		var label := Label3D.new()
		label.text = b["name"]
		label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
		label.fixed_size = true
		label.no_depth_test = true
		label.pixel_size = 0.0006
		label.font_size = 26
		label.outline_size = 8
		label.outline_modulate = Color(0.08, 0.09, 0.11, 0.9)
		label.modulate = Color(0.95, 0.96, 0.98)
		label.render_priority = 10
		label.outline_render_priority = 9
		# Above the model: a person's head, a machine's roof (not its light mast).
		var top := maxf(_height(root), (b["size"] as Vector3).y)
		if b.get("skeletal", false):
			top = 1.85
		elif b["kind"] in ["Processor", "Combiner"]:
			top = minf(top, 2.2)
		label.position = Vector3(0, top + 0.3, 0)
		root.add_child(label)
		rig["label"] = label
		rigs.append(rig)
		_last_color.append(null)
		_last_label.append("")
		if b["mobile"]:
			mobiles.append(i)
	_draw_lines()
	for f in info.get("fluids", []):
		var mi := MeshInstance3D.new()
		var cyl := CylinderMesh.new()
		var s: Vector3 = f["size"]
		cyl.top_radius = maxf(s.x, s.z) * 0.5
		cyl.bottom_radius = cyl.top_radius
		cyl.height = maxf(s.y, 0.1)
		mi.mesh = cyl
		mi.material_override = _plain(Color(0.55, 0.62, 0.70), 0.5)
		mi.position = (f["position"] as Vector3) + Vector3(0, cyl.height * 0.5, 0)
		add_child(mi)


## The scene of an asset dictionary `{source, name, key, path}`, or null.
func _instance(a: Dictionary) -> Node3D:
	var key: String = a["source"] + ":" + a["key"]
	if a["source"] == "catalogue" and Pessoa._is_person(a["name"]) and ResourceLoader.exists(UAL1):
		return (load(UAL1) as PackedScene).instantiate() as Node3D
	if not _templates.has(key):
		_templates[key] = _load_template(a)
	var t = _templates[key]
	if t is PackedScene:
		return (t as PackedScene).instantiate() as Node3D
	if t is Node3D:
		return (t as Node3D).duplicate() as Node3D
	return null


func _load_template(a: Dictionary) -> Variant:
	match a["source"]:
		"library":
			if a["key"] == a["name"]:
				var path: String = MODELOS + a["name"] + ".glb"
				if ResourceLoader.exists(path):
					return load(path)
			var bytes: PackedByteArray = playback.glb(a["key"])
			if bytes.is_empty():
				# A default asset that is not imported: the bridge generates it too.
				return null
			return _from_gltf(bytes, "")
		_:
			if FileAccess.file_exists(a["path"]):
				return _from_gltf(PackedByteArray(), a["path"])
	push_warning("modelo não encontrado: %s" % a)
	return null


func _from_gltf(bytes: PackedByteArray, path: String) -> Node3D:
	var doc := GLTFDocument.new()
	var state := GLTFState.new()
	var err := doc.append_from_file(path, state) if path != "" else doc.append_from_buffer(bytes, "", state)
	if err != OK:
		push_warning("glTF não carregou (%s): %d" % [path, err])
		return null
	return doc.generate_scene(state) as Node3D


## Named nodes of a library asset: forks (`carro`), wheels (`roda*`), status light (`luz`).
func _bind(rig: Dictionary, asset: Node) -> void:
	var wheels := []
	var stack: Array[Node] = [asset]
	while not stack.is_empty():
		var n: Node = stack.pop_back()
		stack.append_array(n.get_children())
		if not (n is Node3D):
			continue
		var nm := String(n.name)
		if nm == "carro" and not rig.has("carro"):
			rig["carro"] = n
			rig["carro_rest"] = (n as Node3D).position.y
		elif nm.begins_with("roda"):
			wheels.append([n, (n as Node3D).position.y, (n as Node3D).basis])
		elif nm == "luz" and not rig.has("light"):
			var mat := _own_light(n)
			if mat != null:
				rig["light"] = mat
	rig["wheels"] = wheels


## A material of its own for the `luz` node of one instance (each shows its own state).
func _own_light(n: Node) -> StandardMaterial3D:
	var own: StandardMaterial3D = null
	for mi in Pessoa._meshes(n):
		for s in mi.mesh.get_surface_count():
			var m := mi.mesh.surface_get_material(s)
			if own == null:
				own = (m.duplicate() if m is StandardMaterial3D else StandardMaterial3D.new()) as StandardMaterial3D
				own.emission_enabled = true
			mi.set_surface_override_material(s, own)
	return own


func _tint_named(asset: Node, material: String, color: Color) -> void:
	for mi in Pessoa._meshes(asset):
		for s in mi.mesh.get_surface_count():
			var m := mi.mesh.surface_get_material(s)
			if m != null and m.resource_name == material:
				mi.set_surface_override_material(s, _tinted(m, color))


func _tinted(original: Material, color: Color) -> Material:
	var key := "%d/%s" % [original.get_instance_id(), color.to_html()]
	if not _materials.has(key):
		var m := original.duplicate() as Material
		if m is BaseMaterial3D:
			(m as BaseMaterial3D).albedo_color = color
		_materials[key] = m
	return _materials[key]


func _plain(color: Color, rough := 0.6) -> StandardMaterial3D:
	var key := "plain/%s/%f" % [color.to_html(), rough]
	if not _materials.has(key):
		var m := StandardMaterial3D.new()
		m.albedo_color = color
		m.roughness = rough
		_materials[key] = m
	return _materials[key]


## The simple shape of a block without a realistic look (sources, sinks...), with the
## meshes of the Bevy viewer: the source cone points along the flow (+X), the combiner
## funnel points down, the dispatcher is a thin cone.
func _simple_shape(b: Dictionary) -> MeshInstance3D:
	var s: Vector3 = b["size"]
	var mi := MeshInstance3D.new()
	var c := CylinderMesh.new()
	c.height = 1.0
	match b["shape"]:
		"cone":
			c.top_radius = 0.0
			c.bottom_radius = 0.7
			mi.rotation = Vector3(0, 0, -PI / 2)
		"funnel":
			c.top_radius = 0.0
			c.bottom_radius = 1.0
			mi.rotation = Vector3(PI, 0, 0)
		"frustum":
			c.top_radius = 0.45
			c.bottom_radius = 1.0
		"cylinder":
			c.top_radius = 0.85
			c.bottom_radius = 0.85
		"flag":
			c.top_radius = 0.0
			c.bottom_radius = 0.25
			c.height = s.y
		_:
			var box := BoxMesh.new()
			box.size = s
			c = null
			mi.mesh = box
	if c != null:
		mi.mesh = c
	mi.position = Vector3(0, s.y * 0.5, 0)
	return mi


## Height of what is drawn under `root` (the top of its meshes in the root's frame), so
## the label floats above the model.
func _height(root: Node3D) -> float:
	var top := 0.0
	var inv := root.global_transform.affine_inverse()
	for mi in Pessoa._meshes(root):
		var t := inv * mi.global_transform
		var box := mi.get_aabb()
		for k in 8:
			top = maxf(top, (t * box.get_endpoint(k)).y)
	return top


## Floor (receives shadows), path network and connections.
func _draw_lines() -> void:
	var lo: Vector3 = info["bounds_min"]
	var hi: Vector3 = info["bounds_max"]
	var ground := MeshInstance3D.new()
	var plane := PlaneMesh.new()
	plane.size = Vector2(hi.x - lo.x + 30.0, hi.z - lo.z + 30.0)
	ground.mesh = plane
	ground.material_override = _plain(Color(0.30, 0.31, 0.32), 0.95)
	ground.position = Vector3((lo.x + hi.x) * 0.5, -0.004, (lo.z + hi.z) * 0.5)
	ground.name = "Piso"
	add_child(ground)
	var im := ImmediateMesh.new()
	var lines := MeshInstance3D.new()
	lines.mesh = im
	lines.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	var mat := StandardMaterial3D.new()
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.vertex_color_use_as_albedo = true
	mat.vertex_color_is_srgb = true
	lines.material_override = mat
	im.surface_begin(Mesh.PRIMITIVE_LINES)
	var net: PackedVector3Array = info.get("network", PackedVector3Array())
	var ctl: PackedInt32Array = info.get("network_controlled", PackedInt32Array())
	var up := Vector3(0, 0.03, 0)
	for k in range(0, net.size() - 1, 2):
		var c := Color(1.0, 0.30, 0.25) if ctl.size() > k / 2 and ctl[k / 2] != 0 else Color(0.95, 0.75, 0.25)
		im.surface_set_color(c)
		im.surface_add_vertex(net[k] + up)
		im.surface_set_color(c)
		im.surface_add_vertex(net[k + 1] + up)
	var con: PackedInt32Array = info.get("connections", PackedInt32Array())
	var lift := Vector3(0, 0.05, 0)
	for k in range(0, con.size() - 1, 2):
		var a: Dictionary = blocks[con[k]]
		var b: Dictionary = blocks[con[k + 1]]
		if a["mobile"] or b["mobile"]:
			continue
		var c := Color(0.55, 0.62, 0.75)
		im.surface_set_color(c)
		im.surface_add_vertex((a["position"] as Vector3) + lift)
		im.surface_set_color(c)
		im.surface_add_vertex((b["position"] as Vector3) + lift)
	# Keep the surface valid when there is nothing to draw.
	im.surface_set_color(Color(0, 0, 0, 0))
	im.surface_add_vertex(Vector3.ZERO)
	im.surface_add_vertex(Vector3.ZERO)
	im.surface_end()
	lines.name = "Linhas"
	add_child(lines)


## Applies the frame at `t`. `dt`: real time since the last call (clip crossfades);
## `snap`: no crossfade (a jump, a capture).
func apply(t: float, dt: float, snap := false) -> void:
	if playback == null:
		return
	var t0 := Time.get_ticks_usec()
	var f: Dictionary = playback.frame(t)
	var t1 := Time.get_ticks_usec()
	var pos: PackedVector3Array = f["position"]
	var yaw: PackedFloat32Array = f["yaw"]
	var lift: PackedFloat32Array = f["lift"]
	var rolled: PackedFloat32Array = f["rolled"]
	var clip: PackedInt32Array = f["clip"]
	var clip_time: PackedFloat32Array = f["clip_time"]
	for i in mobiles:
		var rig: Dictionary = rigs[i]
		var root: Node3D = rig["root"]
		root.position = pos[i]
		root.basis = Basis(Vector3.UP, yaw[i])
		var scale := float(blocks[i].get("scale", 1.0))
		if rig.has("carro"):
			var c: Node3D = rig["carro"]
			c.position.y = float(rig["carro_rest"]) + (lift[i] - FORK_REST) / scale
		for w in rig.get("wheels", []):
			var radius: float = w[1]
			if radius > 1e-3:
				var angle := -fposmod(rolled[i] / radius, TAU)
				(w[0] as Node3D).basis = (w[2] as Basis) * Basis(Vector3(0, 0, 1), angle)
		if rig.has("person"):
			(rig["person"] as Pessoa).drive(clip[i], clip_time[i], dt, snap)
	var color: PackedColorArray = f["color"]
	var label: PackedStringArray = f["label"]
	for i in rigs.size():
		var rig: Dictionary = rigs[i]
		if _last_color[i] != color[i]:
			_last_color[i] = color[i]
			if rig.has("light"):
				var m: StandardMaterial3D = rig["light"]
				m.albedo_color = color[i]
				m.emission = color[i]
				m.emission_energy_multiplier = 1.5
			elif rig.has("simple"):
				(rig["simple"] as MeshInstance3D).material_override = _plain(color[i])
		if _last_label[i] != label[i]:
			_last_label[i] = label[i]
			(rig["label"] as Label3D).text = label[i]
	_apply_items(f)
	last_bridge_us = t1 - t0
	last_apply_us = Time.get_ticks_usec() - t1


func _apply_items(f: Dictionary) -> void:
	var ids: PackedInt64Array = f["item_id"]
	var ipos: PackedVector3Array = f["item_position"]
	var iyaw: PackedFloat32Array = f["item_yaw"]
	var iscale: PackedFloat32Array = f["item_scale"]
	var icolor: PackedColorArray = f["item_color"]
	var carrier: PackedInt32Array = f["item_carrier"]
	var stack: PackedInt32Array = f["item_stack"]
	var seen := {}
	for k in ids.size():
		var id := ids[k]
		seen[id] = true
		var node: Node3D = items.get(id)
		if node == null:
			node = _new_item(icolor[k])
			items[id] = node
		var p := ipos[k]
		var s := iscale[k]
		var basis := Basis(Vector3.UP, iyaw[k]).scaled(Vector3.ONE * s)
		var c := carrier[k]
		if c >= 0 and rigs[c].has("person"):
			# Between the hands of a skeletal person (never inside the chest).
			var hands = (rigs[c]["person"] as Pessoa).hands()
			if hands != null:
				var root: Node3D = rigs[c]["root"]
				var size := s * ITEM_SIZE
				var local: Vector3 = root.global_transform.affine_inverse() * (hands as Vector3)
				local.x = maxf(local.x, size * 0.5 + 0.04)
				local.y += stack[k] * size
				p = root.global_transform * local
				basis = root.global_transform.basis.orthonormalized().scaled(Vector3.ONE * s)
		node.transform = Transform3D(basis, p)
	for id in items.keys():
		if not seen.has(id):
			var n: Node3D = items[id]
			n.visible = false
			items.erase(id)
			n.queue_free()


## An item: a pallet with 2 x 2 x 2 boxes in a scene with pallet loads, else one box,
## filling the ITEM_SIZE cube (origin at its centre), cardboard tinted by the origin.
func _new_item(origin: Color) -> Node3D:
	var node := Node3D.new()
	add_child(node)
	var card := Color("b8875a").lerp(origin, 0.35)
	var e := ITEM_SIZE
	var half := e * 0.5
	var caixa := _instance({"source": "library", "name": "caixa", "key": "caixa", "path": ""})
	if not _pallets:
		if caixa != null:
			var k := e / 0.40
			caixa.position = Vector3(0, -half, 0)
			caixa.scale = Vector3.ONE * k
			_tint_named(caixa, "papelao", card)
			node.add_child(caixa)
		return node
	var palete := _instance({"source": "library", "name": "palete", "key": "palete", "path": ""})
	var k := e / 1.2
	if palete != null:
		palete.position = Vector3(0, -half, 0)
		palete.scale = Vector3.ONE * k
		node.add_child(palete)
	var deck := -half + 0.144 * k
	var w := 1.2 * k
	var d := 1.0 * k
	var layer := (e - 0.144 * k) / 2.0
	var sc := Vector3((w / 2.0 - 0.004) / 0.40, (layer - 0.003) / 0.30, (d / 2.0 - 0.004) / 0.30)
	for level in 2:
		for corner in [Vector2(-1, -1), Vector2(1, -1), Vector2(-1, 1), Vector2(1, 1)]:
			var bx := caixa.duplicate() as Node3D if caixa != null else null
			if bx == null:
				continue
			bx.position = Vector3(corner.x * w / 4.0, deck + level * layer, corner.y * d / 4.0)
			bx.scale = sc
			_tint_named(bx, "papelao", card)
			node.add_child(bx)
	if caixa != null:
		caixa.free()
	return node


## Block index by name, or -1.
func block_index(name: String) -> int:
	for i in blocks.size():
		if blocks[i]["name"] == name:
			return i
	return -1


## Where block `i` is drawn now (its root), and its height.
func block_focus(i: int) -> Vector3:
	var root: Node3D = rigs[i]["root"]
	return root.global_position + Vector3(0, (blocks[i]["size"] as Vector3).y * 0.5, 0)


func set_labels_visible(on: bool) -> void:
	labels_visible = on
	for rig in rigs:
		(rig["label"] as Label3D).visible = on
