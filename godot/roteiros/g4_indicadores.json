{
	"saida": "../capturas",
	"passos": [
		{"nota": "Depois de simular, as abas Qualidade, Segurança e Manutenção do nó mostram o que a simulação diz dele: os mesmos números do UTSim Qualidade e do UTSim Segurança do Trabalho, com o IC de 95 % entre as replicações."},
		{"abrir": "../../examples/inspecao_e_retrabalho.ron"},
		{"clicar": {"objeto": "torno"}},
		{"conferir": {"visivel": ["Aba_Qualidade"], "oculto": ["AbaSimNota"]}},
		{"clicar": {"controle": "Modo_Simular"}},
		{"esperar_trabalho": 120},
		{"esperar_indicadores": true},
		{"clicar": {"controle": "Modo_Editar"}},
		{"clicar": {"objeto": "torno"}},
		{"clicar": {"controle": "Aba_Qualidade"}},
		{"conferir": {"visivel": ["AbaSimNota", "AbaSim_0", "AbaSim_1"],
			"texto": {"controle": "AbaSimNota", "contem": "Na última simulação"}}},
		{"conferir": {"texto": {"controle": "AbaSim_0", "contem": " ± "}}},
		{"capturar": "g4_ind_01_qualidade"},
		{"nota": "A inspeção mostra o rendimento de primeira; o refugo, os itens refugados."},
		{"clicar": {"objeto": "inspecao"}},
		{"conferir": {"visivel": ["AbaSim_0"], "texto": {"controle": "AbaSim_0", "contem": "%"}}},
		{"clicar": {"objeto": "refugo"}},
		{"conferir": {"visivel": ["AbaSim_0"]}},
		{"nota": "Outro modelo esquece os números."},
		{"novo": true},
		{"arrastar": {"de": {"controle": "Biblioteca_Processor"}, "para": {"chao": [0.0, 0.0]}}},
		{"clicar": {"objeto": "processo"}},
		{"conferir": {"visivel": ["Aba_Qualidade"], "oculto": ["AbaSimNota"]}},
		{"nota": "Abrir no UTSim Qualidade na aba Qualidade, no UTSim Segurança na aba Segurança; a Manutenção não tem app próprio."},
		{"clicar": {"controle": "Aba_Qualidade"}},
		{"conferir": {"visivel": ["AbaAbrir_qualidade"], "oculto": ["AbaAbrir_seguranca"]}},
		{"clicar": {"controle": "Aba_Seguranca"}},
		{"conferir": {"visivel": ["AbaAbrir_seguranca"], "oculto": ["AbaAbrir_qualidade"]}},
		{"capturar": "g4_ind_02_abrir_seguranca"},
		{"clicar": {"controle": "Aba_Manutencao"}},
		{"conferir": {"oculto": ["AbaAbrir_qualidade", "AbaAbrir_seguranca"]}}
	]
}
