{
	"saida": "../capturas",
	"passos": [
		{"nota": "Painel ao vivo em janela própria: o botão Janela tira o painel de cima da vista 3D e o abre numa janela do sistema, que pode ir para outro monitor. Vários ficam abertos ao mesmo tempo e continuam ao vivo. Fechar a janela fecha o painel. (Sem tela, no teste, a janela fica embutida.)"},
		{"abrir": "../../examples/inspecao_e_retrabalho.ron"},
		{"clicar": {"controle": "Modo_Simular"}},
		{"esperar_trabalho": 120},
		{"tempo": 2400.0},
		{"painel_ao_vivo": "inspecao"},
		{"conferir": {"painel_vivo": ["inspecao"], "visivel": ["PainelVivo_Janela"], "janelas_vivo": []}},
		{"clicar": {"controle": "PainelVivo_Janela"}},
		{"esperar": 4},
		{"conferir": {"janelas_vivo": ["inspecao"], "oculto": ["PainelVivo"]}},
		{"conferir": {"janela_vivo_texto": {"objeto": "inspecao", "controle": "PainelVivo_Titulo", "contem": "inspecao (processo)"}}},
		{"conferir": {"janela_vivo_texto": {"objeto": "inspecao", "controle": "PainelVivo_Nota", "contem": "t = 2400"}}},
		{"nota": "Outro painel: abre sobre a vista e também vai para uma janela; os dois continuam."},
		{"painel_ao_vivo": "torno"},
		{"conferir": {"visivel": ["PainelVivo"], "texto": {"controle": "PainelVivo_Titulo", "contem": "torno"}}},
		{"clicar": {"controle": "PainelVivo_Janela"}},
		{"esperar": 4},
		{"conferir": {"janelas_vivo": ["inspecao", "torno"], "oculto": ["PainelVivo"]}},
		{"nota": "Ao vivo: o relógio anda e as janelas acompanham."},
		{"tempo": 3000.0},
		{"esperar": 4},
		{"conferir": {"janela_vivo_texto": {"objeto": "inspecao", "controle": "PainelVivo_Nota", "contem": "t = 3000"}}},
		{"conferir": {"janela_vivo_texto": {"objeto": "torno", "controle": "PainelVivo_Nota", "contem": "t = 3000"}}},
		{"nota": "Fechar a janela fecha o painel; Editar fecha os outros (e as janelas deles)."},
		{"fechar_janela_vivo": "inspecao"},
		{"conferir": {"janelas_vivo": ["torno"], "painel_vivo": ["torno"]}},
		{"modo": "editar"},
		{"esperar": 4},
		{"conferir": {"janelas_vivo": []}}
	]
}
