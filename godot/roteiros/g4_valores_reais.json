{
	"saida": "../capturas/valores",
	"passos": [
		{"nota": "Valores reais numa janela grande: importa um CSV, cola valores com vírgula decimal, apaga um, compara todas as distribuições de uma vez, troca a ordem, abre as explicações, vê o Q-Q, grava o relatório com a comparação e usa a distribuição escolhida na tabela (desfaz e refaz)."},
		{"abrir": "../../examples/tutorial_06_atendimento.ron"},
		{"camera": {"alvo": [6.0, 0.0], "distancia": 16.0, "giro": 0.0, "inclinacao": 0.9}},
		{"clicar": {"objeto": "atendentes"}},
		{"escolher": {"controle": "Prop_process_fonte", "item": "Dados reais"}},
		{"conferir": {"visivel": ["Prop_process_janela"]}},
		{"clicar": {"controle": "Prop_process_janela"}},
		{"esperar": 4},
		{"conferir": {"janela_valores": {"aberta": true, "linhas": 0, "comparado": false}, "visivel": ["Valores_Janela", "Valores_Colar", "Valores_Csv", "Valores_Comparar"]}},

		{"nota": "Importar CSV e colar da planilha (vírgula decimal, várias linhas); × apaga um valor."},
		{"clicar": {"controle": "Valores_Csv"}},
		{"dialogo": "../../examples/dados/tempos_atendimento.csv"},
		{"conferir": {"janela_valores": {"linhas_maior_que": 20}}},
		{"digitar": "3,5\n4,25", "em": {"controle": "Valores_Colar"}, "enter": false},
		{"clicar": {"controle": "Valores_Adicionar"}},
		{"conferir": {"texto": {"controle": "Valores_Resumo", "contem": "média"}}},
		{"clicar": {"controle": "Valores_Remover_0"}},
		{"capturar": "g4_valores_01_dados"},

		{"nota": "Comparar todas: uma linha por distribuição com AIC, BIC, log-verossimilhança, K-S, A-D e χ²."},
		{"clicar": {"controle": "Valores_Comparar"}},
		{"esperar_valores": true},
		{"conferir": {"janela_valores": {"comparado": true, "ordem": "aic", "candidatas_maior_que": 10},
			"visivel": ["Valores_Tabela", "Valores_Usar", "Valores_Relatorio", "Valores_Grafico_Ajuste", "Valores_Grafico_Prob"],
			"texto": {"controle": "Valores_Tabela", "contem": "ordem=aic"}}},
		{"capturar": "g4_valores_02_comparacao"},
		{"clicar": {"controle": "Valores_Ordem_bic"}},
		{"conferir": {"janela_valores": {"ordem": "bic"}}},
		{"clicar": {"controle": "Valores_Ordem_aic"}},

		{"nota": "O ⓘ de cada medida e de cada família abre a explicação."},
		{"clicar": {"controle": "Valores_Info_ad"}},
		{"conferir": {"texto": {"controle": "Valores_Explicacao", "contem": "Anderson-Darling"}}},
		{"conferir": {"texto": {"controle": "Valores_Explicacao", "contem": "Cuidados"}}},
		{"capturar": "g4_valores_03_explicacao"},
		{"clicar": {"controle": "Valores_Info_Gama"}},
		{"conferir": {"texto": {"controle": "Valores_Explicacao", "contem": "Gama"}}},
		{"clicar": {"controle": "Valores_Explicacao_Fechar"}},
		{"clicar": {"controle": "Valores_QQ"}},
		{"conferir": {"texto": {"controle": "Valores_Grafico_Prob", "contem": "Q-Q"}}},

		{"nota": "Escolher outra linha da tabela e gerar o relatório com a comparação completa."},
		{"clicar": {"controle": "Valores_Cand_0"}},
		{"conferir": {"janela_valores": {"escolhida": "Weibull deslocada"}, "texto": {"controle": "Valores_Usar", "contem": "Weibull deslocada"}}},
		{"capturar": "g4_valores_04_outra"},
		{"clicar": {"controle": "Valores_Relatorio"}},
		{"dialogo": "{saida}/relatorio_valores"},
		{"conferir": {"arquivo": {"caminho": "{saida}/relatorio_valores/ajuste_atendentes_process.html", "contem": ["Comparação de todas as medidas", "Weibull deslocada (usada)", "Como ler:", "<svg"]}}},

		{"nota": "Usar esta distribuição: o campo passa a usar os valores, com a família escolhida."},
		{"clicar": {"controle": "Valores_Usar"}},
		{"esperar_trabalho": 120},
		{"esperar": 10},
		{"conferir": {"janela_valores": {"aberta": false}, "dados": {"campo": "atendentes.process", "fonte": "dados", "familia": "Weibull deslocada"}, "pode_desfazer": true}},
		{"tecla": "ctrl+z"},
		{"esperar": 5},
		{"conferir": {"dados": {"campo": "atendentes.process", "fonte": "dist"}}},
		{"tecla": "ctrl+y"},
		{"esperar": 5},
		{"conferir": {"dados": {"campo": "atendentes.process", "fonte": "dados"}}}
	]
}
