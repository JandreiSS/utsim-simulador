{
	"saida": "../capturas",
	"passos": [
		{"nota": "Monta o tutorial 1 (um caixa) só pela interface e compara o .ron salvo com examples/tutorial_01_caixa.ron. Roda sem janela em scripts/godot_teste.sh."},
		{"novo": true},
		{"camera": {"alvo": [6, 0], "distancia": 22.0, "giro": 0.0, "inclinacao": 0.85}},
		{"nota": "Biblioteca: arrastar até o chão e clicar e clicar no chão, com encaixe na grade de 1 m."},
		{"arrastar": {"de": {"controle": "Biblioteca_Source"}, "para": {"chao": [0.2, -0.3]}, "passos": 16}},
		{"conferir": {"objetos": 1, "posicao": {"objeto": "chegada", "x": 0.0, "y": 0.0}, "selecao": ["chegada"]}},
		{"arrastar": {"de": {"controle": "Biblioteca_Queue"}, "para": {"chao": [3.8, 0.2]}}},
		{"conferir": {"objetos": 2, "posicao": {"objeto": "fila", "x": 4.0, "y": 0.0}}},
		{"clicar": {"controle": "Biblioteca_Processor"}},
		{"conferir": {"ferramenta": "colocar"}},
		{"clicar": {"chao": [8.3, 0.1]}},
		{"conferir": {"objetos": 3, "posicao": {"objeto": "processo", "x": 8.0, "y": 0.0}, "ferramenta": "selecionar"}},
		{"nota": "Esc cancela a colocação."},
		{"clicar": {"controle": "Biblioteca_Queue"}},
		{"conferir": {"ferramenta": "colocar"}},
		{"tecla": "escape"},
		{"conferir": {"ferramenta": "selecionar", "objetos": 3}},
		{"arrastar": {"de": {"controle": "Biblioteca_Sink"}, "para": {"chao": [11.7, -0.2]}}},
		{"conferir": {"objetos": 4, "posicao": {"objeto": "saida", "x": 12.0, "y": 0.0}}},
		{"nota": "Delete apaga o selecionado; Ctrl+Z e Ctrl+Y."},
		{"arrastar": {"de": {"controle": "Biblioteca_Queue"}, "para": {"chao": [6.0, 4.0]}}},
		{"conferir": {"objetos": 5, "existe": ["fila_2"], "selecao": ["fila_2"]}},
		{"tecla": "delete"},
		{"conferir": {"objetos": 4, "nao_existe": ["fila_2"]}},
		{"tecla": "ctrl+z"},
		{"conferir": {"objetos": 5, "existe": ["fila_2"], "pode_refazer": true}},
		{"tecla": "ctrl+y"},
		{"conferir": {"objetos": 4, "nao_existe": ["fila_2"]}},
		{"nota": "Mover com o mouse, com encaixe, e desfazer o movimento."},
		{"arrastar": {"de": {"objeto": "saida"}, "para": {"chao": [13.2, 2.1]}}},
		{"conferir": {"posicao": {"objeto": "saida", "x": 13.0, "y": 2.0}, "selecao": ["saida"]}},
		{"tecla": "ctrl+z"},
		{"conferir": {"posicao": {"objeto": "saida", "x": 12.0, "y": 0.0}}},
		{"nota": "Ligar por arrasto: da porta de saída até o destino (ou a porta de entrada dele)."},
		{"arrastar": {"de": {"porta_saida": "chegada"}, "para": {"objeto": "fila"}}},
		{"conferir": {"ligacoes": 1, "ligado": ["chegada", "fila"], "ligando": ""}},
		{"arrastar": {"de": {"porta_saida": "fila"}, "para": {"porta_entrada": "processo"}}},
		{"conferir": {"ligacoes": 2, "ligado": ["fila", "processo"]}},
		{"nota": "Ferramenta Ligar (L): arrastar de um bloco ao outro."},
		{"tecla": "l"},
		{"conferir": {"ferramenta": "ligar"}},
		{"arrastar": {"de": {"objeto": "processo"}, "para": {"objeto": "saida"}}},
		{"tecla": "escape"},
		{"conferir": {"ligacoes": 3, "ligado": ["processo", "saida"], "problemas": 0, "ferramenta": "selecionar"}},
		{"nota": "Propriedades: nome, distribuições pelo parâmetro e pelo texto RON."},
		{"clicar": {"objeto": "processo"}},
		{"conferir": {"selecao": ["processo"]}},
		{"digitar": "caixa", "em": {"controle": "Prop_name"}},
		{"conferir": {"existe": ["caixa"], "nao_existe": ["processo"], "selecao": ["caixa"], "ligado": ["caixa", "saida"]}},
		{"clicar": {"controle": "Prop_process_texto"}},
		{"digitar": "Exp(mean: 4.0)", "em": {"controle": "Prop_process_ron"}},
		{"conferir": {"campo": {"objeto": "caixa", "campo": "process", "valor": "Exp(mean: 4.0)"}}},
		{"clicar": {"objeto": "chegada"}},
		{"digitar": "5", "em": {"controle": "Prop_interarrival_mean"}},
		{"conferir": {"campo": {"objeto": "chegada", "campo": "interarrival", "valor": "Exp(mean: 5.0)"}}},
		{"nota": "Modelo e simulação (nada selecionado: Esc)."},
		{"tecla": "escape"},
		{"conferir": {"selecao": []}},
		{"digitar": "Tutorial 01: um caixa", "em": {"controle": "Prop_model_name"}},
		{"digitar": "Fila M/M/1 para comparar a simulação com a fórmula", "em": {"controle": "Prop_description"}, "enter": false},
		{"clicar": {"controle": "Prop_description_aplicar"}},
		{"digitar": "100000", "em": {"controle": "Prop_stop_time"}},
		{"digitar": "2000", "em": {"controle": "Prop_warmup"}},
		{"digitar": "42", "em": {"controle": "Prop_seed"}},
		{"digitar": "10", "em": {"controle": "Prop_replications"}},
		{"conferir": {"problemas": 0, "sujo": true}},
		{"nota": "Ctrl+S (sem arquivo: Salvar como) e a comparação com o exemplo."},
		{"tecla": "ctrl+s"},
		{"dialogo": "{saida}/tutorial_01.ron"},
		{"conferir": {"sujo": false, "igual_a": {"arquivo": "{saida}/tutorial_01.ron", "modelo": "../../examples/tutorial_01_caixa.ron"}}},
		{"capturar": "g2_tutorial_01"},
		{"novo": true},
		{"tecla": "ctrl+o"},
		{"dialogo": "{saida}/tutorial_01.ron"},
		{"conferir": {"objetos": 4, "ligacoes": 3, "problemas": 0, "sujo": false,
			"campo": {"objeto": "caixa", "campo": "process", "valor": "Exp(mean: 4.0)"}}}
	]
}
