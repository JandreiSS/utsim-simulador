		{"conferir": {"objetos": 1}},
		{"clicar": {"objeto": "processo"}},
		{"conferir": {"selecao": ["processo"], "visivel": ["Aba_Qualidade", "Aba_Seguranca", "Aba_Manutencao"], "campo": {"objeto": "processo", "campo": "quality", "valor": "não"}}},
		{"nota": "Qualidade: liga o bloco, acrescenta um defeito e muda a probabilidade (vírgula vale)."},
		{"clicar": {"controle": "AbaCampo_quality"}},
		{"conferir": {"campo": {"objeto": "processo", "campo": "quality", "valor": "sim"}}},
		{"clicar": {"controle": "AbaAdicionar_quality_defects"}},
		{"conferir": {"campo": {"objeto": "processo", "campo": "quality.defects[0].name", "valor": "defeito_1"}}},
		{"digitar": "0,05", "em": {"controle": "AbaCampo_quality_defects_0_probability"}, "enter": true},
		{"conferir": {"campo": {"objeto": "processo", "campo": "quality.defects[0].probability", "valor": "0.05"}}},
		{"capturar": "g4_abas_01_qualidade"},
		{"nota": "Um valor recusado fica escrito embaixo do campo, e o modelo não muda."},
		{"digitar": "dois", "em": {"controle": "AbaCampo_quality_defects_0_probability"}, "enter": true},
		{"conferir": {"visivel": ["AbaErro"], "campo": {"objeto": "processo", "campo": "quality.defects[0].probability", "valor": "0.05"}}},
		{"nota": "Segurança: EPI do posto e um perigo."},
		{"clicar": {"controle": "Aba_Seguranca"}},
		{"digitar": "oculos, luvas", "em": {"controle": "AbaCampo_ppe"}, "enter": true},
		{"conferir": {"campo": {"objeto": "processo", "campo": "ppe", "valor": "oculos, luvas"}}},
		{"clicar": {"controle": "AbaCampo_safety"}},
		{"clicar": {"controle": "AbaAdicionar_safety_hazards"}},
