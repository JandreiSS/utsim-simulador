		{"conferir": {"oculto": ["AbaCampo_downtime_mtbf"]}},
		{"tecla": "ctrl+z"},
		{"conferir": {"campo": {"objeto": "processo", "campo": "safety.hazards[0].description", "valor": ""}}},
		{"tecla": "ctrl+y"},
		{"conferir": {"campo": {"objeto": "processo", "campo": "safety.hazards[0].description", "valor": "novo perigo"}}}
