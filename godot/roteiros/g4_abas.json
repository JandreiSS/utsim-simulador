{
	"saida": "../capturas",
	"passos": [
		{"nota": "Abas Qualidade, Segurança e Manutenção do nó no painel de propriedades: vazias num nó novo, cada mudança é um passo de desfazer, e o modelo guarda os mesmos campos que o UTSim Qualidade e o UTSim Segurança do Trabalho editam."},
		{"novo": true},
		{"camera": {"alvo": [0, 0], "distancia": 14.0, "giro": 0.0, "inclinacao": 0.85}},
