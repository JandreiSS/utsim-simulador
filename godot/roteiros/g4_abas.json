		{"capturar": "g4_abas_02_seguranca"},
		{"nota": "Manutenção: as quebras do nó, as mesmas da seção Quebras e turnos."},
		{"clicar": {"controle": "Aba_Manutencao"}},
		{"clicar": {"controle": "AbaCampo_downtime"}},
		{"conferir": {"visivel": ["AbaCampo_downtime_mtbf", "AbaCampo_downtime_mttr"]}},
		{"capturar": "g4_abas_03_manutencao"},
		{"nota": "Desfazer volta um passo por vez."},
