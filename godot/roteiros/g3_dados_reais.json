{
	"saida": "../capturas/dados",
	"passos": [
		{"nota": "Dados reais num campo de distribuição: troca o processamento de Gama(2; 1,5) por tempos de um CSV, confere a família escolhida, desfaz, refaz, troca de candidata com um clique, volta para Distribuição e grava o relatório."},
		{"abrir": "../../examples/tutorial_06_atendimento.ron"},
		{"camera": {"alvo": [6.0, 0.0], "distancia": 16.0, "giro": 0.0, "inclinacao": 0.9}},
		{"clicar": {"objeto": "atendentes"}},
		{"conferir": {"selecao": ["atendentes"], "visivel": ["Prop_process_fonte"], "pode_desfazer": false,
			"dados": {"campo": "atendentes.process", "fonte": "dist"}}},
		{"capturar": "g3_dados_01_distribuicao"},

		{"nota": "Fonte: Dados reais, arquivo escolhido no diálogo, coluna do cabeçalho."},
		{"escolher": {"controle": "Prop_process_fonte", "item": "Dados reais"}},
		{"conferir": {"visivel": ["Prop_process_origem", "Prop_process_arquivo", "Prop_process_escolher", "Prop_process_aplicar"]}},
		{"clicar": {"controle": "Prop_process_escolher"}},
		{"dialogo": "../../examples/dados/tempos_atendimento.csv"},
		{"conferir": {"texto": {"controle": "Prop_process_arquivo", "contem": "tempos_atendimento.csv"}}},
		{"escolher": {"controle": "Prop_process_coluna", "item": "tempo_atendimento"}},
		{"capturar": "g3_dados_02_formulario"},

		{"nota": "Aplicar: o ajuste roda na thread da ponte e o resultado aparece no próprio painel."},
		{"clicar": {"controle": "Prop_process_aplicar"}},
		{"esperar_trabalho": 120},
		{"esperar": 10},
		{"conferir": {"dados": {"campo": "atendentes.process", "fonte": "dados", "familia": "Gama", "n_maior_que": 20, "defasado": false, "analisado": true},
			"visivel": ["Prop_process_selo", "Prop_process_resultado", "Prop_process_grafico", "Prop_process_cand_0", "Prop_process_relatorio"],
			"grafico_dados": {"controle": "Prop_process_grafico", "barras_maior_que": 4, "curva": true},
			"texto": {"controle": "Prop_process_selo", "contem": "dados"},
			"pode_desfazer": true, "sujo": true,
			"modelo_contem": ["data: [", "tempos_atendimento.csv"]}},
		{"clicar": {"controle": "Secao_Objeto"}},
		{"clicar": {"controle": "Secao_Posição"}},
		{"rolar": {"ponto": [1380, 500]}, "vezes": 3, "sentido": "baixo"},
		{"esperar": 5},
		{"capturar": "g3_dados_03_resultado"},

		{"nota": "Desfazer volta para Gama(2; 1,5) escrita; refazer traz os dados de volta."},
		{"tecla": "ctrl+z"},
		{"esperar": 5},
		{"conferir": {"dados": {"campo": "atendentes.process", "fonte": "dist"}, "oculto": ["Prop_process_selo"],
			"campo": {"objeto": "atendentes", "campo": "process", "valor": "Gamma(shape: 2.0, scale: 1.5)"}}},
		{"tecla": "ctrl+y"},
		{"esperar": 5},
		{"conferir": {"dados": {"campo": "atendentes.process", "fonte": "dados", "familia": "Gama"}, "visivel": ["Prop_process_selo"]}},
		{"nota": "Depois do refazer a análise vem do cache (sem rodar de novo)."},
		{"esperar_trabalho": 60},
		{"esperar": 5},
		{"conferir": {"dados": {"campo": "atendentes.process", "analisado": true}, "visivel": ["Prop_process_grafico"]}},

		{"nota": "Trocar de candidata com um clique: a segunda do ranking."},
		{"clicar": {"controle": "Prop_process_cand_1"}},
		{"esperar_trabalho": 120},
		{"esperar": 10},
		{"conferir": {"dados": {"campo": "atendentes.process", "fonte": "dados", "analisado": true}, "pode_desfazer": true}},
		{"rolar": {"ponto": [1380, 500]}, "vezes": 3, "sentido": "baixo"},
		{"capturar": "g3_dados_04_outra_candidata"},
		{"tecla": "ctrl+z"},
		{"esperar": 5},
		{"conferir": {"dados": {"campo": "atendentes.process", "fonte": "dados", "familia": "Gama"}}},

		{"nota": "Relatório: grava o HTML numa pasta temporária (o navegador só abre com janela)."},
		{"clicar": {"controle": "Prop_process_relatorio"}},
		{"dialogo": "{saida}/relatorio_dados"},
		{"esperar_trabalho": 120},
		{"conferir": {"arquivo": {"caminho": "{saida}/relatorio_dados/index.html", "contem": ["atendentes.process", "Gama"]}}},
		{"conferir": {"arquivo": {"caminho": "{saida}/relatorio_dados/atendentes.process.html", "contem": ["<svg", "Justificativa"]}}},

		{"nota": "Voltar para Distribuição mantém a distribuição ajustada no campo, e é um passo de desfazer."},
		{"escolher": {"controle": "Prop_process_fonte", "item": "Distribuição"}},
		{"esperar": 5},
		{"conferir": {"status_contem": "volta a usar"}},
		{"conferir": {"dados": {"campo": "atendentes.process", "fonte": "dist"}, "visivel": ["Prop_process_familia"]}},
		{"tecla": "ctrl+z"},
		{"esperar": 5},
		{"conferir": {"dados": {"campo": "atendentes.process", "fonte": "dados", "familia": "Gama"}}}
	]
}
