{
	"saida": "../capturas",
	"passos": [
		{"nota": "Painel ao vivo: no Simular, o clique num objeto abre no canto os números dele no instante da reprodução; no fim da replicação são os do relatório final dela."},
		{"abrir": "../../examples/inspecao_e_retrabalho.ron"},
		{"clicar": {"controle": "Modo_Simular"}},
		{"esperar_trabalho": 120},
		{"conferir": {"modo": "simular", "ocupado": false, "painel_vivo": []}},
		{"tempo": 2400.0},
		{"focar": {"objeto": "inspecao", "distancia": 14.0}},
		{"clicar": {"objeto_simular": "inspecao"}},
		{"conferir": {"painel_vivo": ["inspecao"],
			"visivel": ["PainelVivo", "PainelVivo_Titulo", "PainelVivo_Processados", "PainelVivo_Fila", "PainelVivo_Refugo", "PainelVivo_Retrabalho", "PainelVivo_Ocupado"],
			"texto": {"controle": "PainelVivo_Titulo", "contem": "inspecao (processo)"}}},
		{"conferir": {"texto": {"controle": "PainelVivo_Nota", "contem": "t = 2400"}}},
		{"conferir": {"grafico": {"controle": "PainelVivo_Grafico", "maior_que": 1}}},
		{"capturar": "g4_painel_ao_vivo_01"},
		{"nota": "Fixar mantém o painel; o próximo objeto abre outro ao lado."},
		{"clicar": {"controle": "PainelVivo_Fixar"}},
		{"painel_ao_vivo": "torno"},
		{"conferir": {"painel_vivo": ["torno", "inspecao"], "visivel": ["PainelVivo2", "PainelVivo2_Processados"]}},
		{"nota": "No fim da replicação os números são os do relatório final dela (a replicação 0)."},
		{"tempo": 4800.0},
		{"esperar": 3},
		{"conferir": {"painel_vivo_relatorio": "inspecao"}},
		{"conferir": {"painel_vivo_relatorio": "torno"}},
		{"conferir": {"painel_vivo_relatorio": "refugo"}},
		{"capturar": "g4_painel_ao_vivo_02"},
		{"nota": "Esc fecha o painel não fixado; de novo, o fixado."},
		{"tecla": "esc"},
		{"conferir": {"painel_vivo": ["inspecao"]}},
		{"tecla": "esc"},
		{"conferir": {"painel_vivo": [], "oculto": ["PainelVivo"]}}
	]
}
