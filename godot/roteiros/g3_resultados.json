{
	"saida": "../capturas",
	"passos": [
		{"nota": "Resultados: simula em thread, tabela com IC e gargalo, gráficos, aquecimento com aplicar, replicações necessárias com rodar mais, Little, gargalo móvel, cenários e otimização."},
		{"abrir": "../../examples/servidores.ron"},
		{"conferir": {"problemas": 0}},
		{"nota": "A simulação vai para a thread da ponte."},
		{"clicar": {"controle": "Modo_Simular"}},
		{"esperar_trabalho": 120},
		{"conferir": {"modo": "simular", "ocupado": false, "oculto": ["Progresso", "Botao_Cancelar"], "replicacoes": 5}},
		{"clicar": {"controle": "Botao_Resultados"}},
		{"conferir": {"visivel": ["PainelResultados", "Res_Tabela"],
			"texto": {"controle": "Res_Resumo", "contem": "Gargalo (geral): maquina"}}},
		{"conferir": {"texto": {"controle": "Res_Tabela", "contem": "maquina (gargalo)"}}},
		{"conferir": {"texto": {"controle": "Res_Tabela", "contem": " ± "}}},
		{"capturar": "g3_res_01_resumo"},
		{"nota": "Gráficos: ocupação, estados, série e histograma."},
		{"clicar": {"aba": ["Res_Abas", "Gráficos"]}},
		{"conferir": {"grafico": {"controle": "Res_Grafico", "maior_que": 0}}},
		{"capturar": "g3_res_02_ocupacao"},
		{"escolher": {"controle": "Res_TipoGrafico", "item": "Estados"}},
		{"conferir": {"grafico": {"controle": "Res_Grafico", "maior_que": 1}}},
		{"capturar": "g3_res_03_estados"},
		{"escolher": {"controle": "Res_TipoGrafico", "item": "Série temporal"}},
		{"capturar": "g3_res_04_serie"},
		{"escolher": {"controle": "Res_TipoGrafico", "item": "Histograma"}},
		{"capturar": "g3_res_05_histograma"},
		{"nota": "Análise: aquecimento (Welch e MSER-5) e aplicar ao modelo."},
		{"clicar": {"aba": ["Res_Abas", "Análise"]}},
		{"clicar": {"controle": "Res_AquecAnalisar"}},
		{"esperar_trabalho": 120},
		{"conferir": {"grafico": {"controle": "Res_AquecGrafico", "maior_que": 1}, "texto": {"controle": "Res_AquecTexto", "contem": "Corte sugerido"}}},
		{"capturar": "g3_res_06_aquecimento"},
		{"clicar": {"controle": "Res_AquecAplicar"}},
		{"conferir": {"execucao": {"campo": "warmup", "maior_que": 0.0}, "sujo": true, "status_contem": "aplicado"}},
		{"nota": "Replicações necessárias e rodar mais (acrescenta às 5 já feitas)."},
		{"digitar": "20%", "em": {"controle": "Res_Precisao"}},
		{"clicar": {"controle": "Res_PrecisaoCalcular"}},
		{"conferir": {"texto": {"controle": "Res_PrecisaoTexto", "contem": "maquina.utilization"}}},
		{"clicar": {"controle": "Res_RodarMais"}},
		{"esperar_trabalho": 120},
		{"conferir": {"texto": {"controle": "Res_Resumo", "contem": "replicação(ões)"}}},
		{"nota": "Lei de Little com semáforo e gargalo móvel."},
		{"clicar": {"controle": "Res_Little"}},
		{"esperar_trabalho": 120},
		{"conferir": {"texto": {"controle": "Res_LittleTexto", "contem": "sistema"}, "status_contem": "Lei de Little"}},
		{"conferir": {"texto": {"controle": "Res_LittleTexto", "contem": "● "}}},
		{"clicar": {"controle": "Res_GargaloMovel"}},
		{"esperar_trabalho": 120},
		{"conferir": {"texto": {"controle": "Res_GargaloMovelTexto", "contem": "Gargalo móvel: maquina"}, "grafico": {"controle": "Res_GargaloMovelGrafico", "maior_que": 0}}},
		{"capturar": "g3_res_07_analise"},
		{"nota": "Cenários em texto, com números aleatórios comuns."},
		{"clicar": {"aba": ["Res_Abas", "Cenários"]}},
		{"digitar": "[dois servidores]\nmaquina.capacity = 2\n", "em": {"controle": "Res_CenariosTexto"}, "enter": false},
		{"digitar": "fila.content.mean, saida.input", "em": {"controle": "Res_CenariosMedidas"}},
		{"clicar": {"controle": "Res_CenariosComparar"}},
		{"esperar_trabalho": 180},
		{"conferir": {"texto": {"controle": "Res_CenariosResultado", "contem": "dois servidores"}, "status_contem": "2 cenário(s) comparados"}},
		{"conferir": {"texto": {"controle": "Res_CenariosResultado", "contem": "Δ "}}},
		{"capturar": "g3_res_08_cenarios"},
		{"nota": "Otimização pela ponte."},
		{"clicar": {"aba": ["Res_Abas", "Otimização"]}},
		{"digitar": "fila.content.mean", "em": {"controle": "Res_OtimMetrica"}},
		{"digitar": "maquina.capacity 1 3", "em": {"controle": "Res_OtimVariaveis"}, "enter": false},
		{"digitar": "2", "em": {"controle": "Res_OtimReplicacoes"}},
		{"clicar": {"controle": "Res_Otimizar"}},
		{"esperar_trabalho": 240},
		{"conferir": {"texto": {"controle": "Res_OtimResultado", "contem": "Melhor ponto: maquina.capacity = 3"}}},
		{"capturar": "g3_res_09_otimizacao"},
		{"clicar": {"controle": "Res_Fechar"}},
		{"conferir": {"oculto": ["PainelResultados"]}},
		{"nota": "Uma rodada longa mostra o progresso sem travar a interface, e o Cancelar para no meio."},
		{"digitar": "3000", "em": {"controle": "Simular_Replicacoes"}},
		{"clicar": {"controle": "Botao_RodarDeNovo"}},
		{"conferir": {"ocupado": true, "visivel": ["Progresso", "Botao_Cancelar"]}},
		{"esperar": 10},
		{"conferir": {"ocupado": true}},
		{"clicar": {"controle": "Botao_Cancelar"}},
		{"esperar_trabalho": 120},
		{"conferir": {"ocupado": false, "oculto": ["Progresso", "Botao_Cancelar"], "status_contem": "cancelada"}}
	]
}
