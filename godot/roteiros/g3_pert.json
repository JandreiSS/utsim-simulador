{
	"saida": "../capturas",
	"passos": [
		{"nota": "PERT/CPM da seleção: de chegada até saida no M/M/1, abrindo no modo simulado; clássico e Monte Carlo a um clique; rede, Gantt, distribuição, tabela, texto e exportação."},
		{"abrir": "../../examples/mm1.ron"},
		{"camera": {"alvo": [4.5, 0], "distancia": 18.0, "giro": 0.0, "inclinacao": 0.9}},
		{"clicar": {"objeto": "chegada"}},
		{"clicar": {"objeto": "saida"}, "shift": true},
		{"conferir": {"selecao": ["saida", "chegada"]}},
		{"clicar": {"controle": "Botao_Pert"}},
		{"conferir": {"visivel": ["PainelPert", "Pert_Diagrama"]}},
		{"esperar_trabalho": 180},
		{"conferir": {"pert": {"modo": "simulado", "caixas_maior_que": 2, "tem_histograma": true}, "critico": ["maquina"],
			"texto": {"controle": "Pert_Resumo", "contem": "observado na simulação"}}},
		{"conferir": {"texto": {"controle": "Pert_Resumo", "contem": "Caminho crítico:"}}},
		{"capturar": "g3_pert_01_rede_simulado"},
		{"clicar": {"controle": "Pert_Modo_classico"}},
		{"esperar_trabalho": 60},
		{"conferir": {"pert": {"modo": "classico", "tem_histograma": true}, "texto": {"controle": "Pert_Resumo", "contem": "PERT clássico"}}},
		{"clicar": {"aba": ["Pert_Abas", "Gantt"]}},
		{"capturar": "g3_pert_02_gantt"},
		{"nota": "Monte Carlo com prazo: P(T ≤ prazo) com o intervalo."},
		{"clicar": {"controle": "Pert_Modo_montecarlo"}},
		{"esperar_trabalho": 60},
		{"digitar": "2.0", "em": {"controle": "Pert_Prazo"}},
		{"esperar_trabalho": 60},
		{"conferir": {"pert": {"modo": "montecarlo", "tem_histograma": true}, "texto": {"controle": "Pert_Resumo", "contem": "P(T ≤ 2"}}},
		{"clicar": {"aba": ["Pert_Abas", "Distribuição"]}},
		{"conferir": {"texto": {"controle": "Pert_DistribuicaoTexto", "contem": "prazo"}}},
		{"capturar": "g3_pert_03_distribuicao"},
		{"clicar": {"aba": ["Pert_Abas", "Tabela"]}},
		{"conferir": {"texto": {"controle": "Pert_Tabela", "contem": "maquina"}}},
		{"clicar": {"aba": ["Pert_Abas", "Texto"]}},
		{"conferir": {"texto": {"controle": "Pert_Texto", "contem": "PERT/CPM de"}}},
		{"digitar": "{saida}/g3_pert.html", "em": {"controle": "Pert_Arquivo"}},
		{"clicar": {"controle": "Pert_ExportarHTML"}},
		{"conferir": {"arquivo": {"caminho": "{saida}/g3_pert.html", "contem": ["<svg", "maquina"]}}},
		{"clicar": {"controle": "Pert_Fechar"}},
		{"conferir": {"oculto": ["PainelPert"]}},
		{"nota": "Seleção de objetos (sem trecho): todos os três do meio."},
		{"clicar": {"objeto": "fila"}},
		{"clicar": {"objeto": "maquina"}, "shift": true},
		{"clicar": {"objeto": "saida"}, "shift": true},
		{"clicar": {"controle": "Botao_Pert"}},
		{"esperar_trabalho": 180},
		{"conferir": {"pert": {"modo": "simulado", "caixas_maior_que": 2}}},
		{"clicar": {"controle": "Pert_Fechar"}}
	]
}
