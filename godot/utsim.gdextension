; Biblioteca da ponte em Rust (crates/utsim-godot), copiada para bin/ por scripts/godot.sh.

[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]

windows.debug.x86_64 = "res://bin/utsim_godot.dll"
windows.release.x86_64 = "res://bin/utsim_godot.dll"
linux.debug.x86_64 = "res://bin/libutsim_godot.so"
linux.release.x86_64 = "res://bin/libutsim_godot.so"
