// Tutorial 01: uma fila e um caixa (M/M/1).
// Tempo em minutos. Um cliente chega a cada 5 minutos, em média (taxa λ = 0,2 por minuto),
// e o caixa atende em 4 minutos, em média (taxa μ = 0,25 por minuto).
// Teoria: ρ = λ/μ = 0,8 | Lq = 3,2 | Wq = 16 | W = 20 | L = 4.
Model(
    name: "Tutorial 01: um caixa",
    description: "Fila M/M/1 para comparar a simulação com a fórmula",
    run: (
        stop_time: 100000.0,
        warmup: 2000.0,
        seed: 42,
        replications: 10,
    ),
    objects: [
        (name: "chegada", kind: Source(interarrival: Exp(mean: 5.0)), position: (0.0, 0.0, 0.0)),
        (name: "fila",    kind: Queue(),                              position: (4.0, 0.0, 0.0)),
        (name: "caixa",   kind: Processor(process: Exp(mean: 4.0)),   position: (8.0, 0.0, 0.0)),
        (name: "saida",   kind: Sink,                                 position: (12.0, 0.0, 0.0)),
    ],
    connections: [
        ("chegada", "fila"),
        ("fila", "caixa"),
        ("caixa", "saida"),
    ],
)
