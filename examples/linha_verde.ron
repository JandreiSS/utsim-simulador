// Ambiental na cena 3D (fase AM13 do UTSim Ambiental): usinagem que gera trinca, lavadora,
// estufa a gás, cabine de pintura e inspeção antes da expedição, das 06:00 às 22:00, com a
// janela de pico da tarifa das 18:00 às 21:00. Na reprodução, a camada Ambiental mostra o
// brilho da energia de cada máquina no piso, a coluna da potência no instante, o medidor da
// fábrica e a mochila de cada peça refugada (clique na peça marcada).
// Tempos em minutos, distâncias em metros. Fatores didáticos, não oficiais.
Model(
    name: "Linha verde",
    description: "Energia por estado, potência no instante, janela de pico e a mochila do refugo",
    run: (stop_time: 960.0, warmup: 60.0, seed: 53, replications: 3),
    packs: ["qualidade"],
    objects: [
        (name: "chegada", kind: Source(interarrival: Exp(mean: 5.0)), position: (0.0, 0.0, 0.0)),
        (name: "usinagem", kind: Processor(process: Triangular(min: 2.5, mode: 3.0, max: 3.5)),
         position: (4.0, 0.0, 0.0),
         quality: Some((defects: [(name: "trinca", probability: 0.12)])),
         environment: Some((stage: Some("usinagem"), power: (producing: 10.0, waiting: 3.0)))),
        (name: "fila1", kind: Queue(), position: (7.0, 0.0, 0.0)),
        (name: "lavadora", kind: Processor(process: Const(2.0)), position: (10.0, 0.0, 0.0),
         environment: Some((stage: Some("pré-tratamento"), power: (producing: 15.0, waiting: 9.0),
            flows: [(flow: "agua", amount: 0.02, driver: Item)]))),
        (name: "fila2", kind: Queue(), position: (13.0, 0.0, 0.0)),
        (name: "estufa", kind: Processor(process: Const(3.0)), position: (16.0, 0.0, 0.0),
         environment: Some((stage: Some("cura"), power: (producing: 2.0, waiting: 1.0),
            flows: [(flow: "gas", amount: 0.3, driver: Item)]))),
        (name: "fila3", kind: Queue(), position: (19.0, 0.0, 0.0)),
        (name: "cabine", kind: Processor(process: Const(3.0)), position: (22.0, 0.0, 0.0),
         environment: Some((stage: Some("pintura"), power: (producing: 8.0, waiting: 5.0),
            flows: [(flow: "tinta", amount: 0.2, driver: Item)]))),
        (name: "fila4", kind: Queue(), position: (25.0, 0.0, 0.0)),
        (name: "insp_final", kind: Processor(process: Const(0.5)), output: ByLabel("inspecao"),
         position: (28.0, 0.0, 0.0),
         inspection: Some((every: 1, detect: 0.95, on_reject: Scrap))),
        (name: "cliente", kind: Sink, sink_role: Some(Customer), position: (32.0, 0.0, 0.0)),
        (name: "refugo", kind: Sink, sink_role: Some(Scrap), position: (32.0, -4.0, 0.0)),
    ],
    connections: [
        ("chegada", "usinagem"), ("usinagem", "fila1"), ("fila1", "lavadora"),
        ("lavadora", "fila2"), ("fila2", "estufa"), ("estufa", "fila3"), ("fila3", "cabine"),
        ("cabine", "fila4"), ("fila4", "insp_final"), ("insp_final", "cliente"), ("insp_final", "refugo"),
    ],
    environment: Some((
        clock: (start: "06:00", time_unit: Minute),
        flows: [(name: "eletricidade", kind: Energy, unit: "kWh", direction: In),
                (name: "gas", kind: Fuel, unit: "m3", direction: In),
                (name: "tinta", kind: Material, unit: "kg", direction: In),
                (name: "agua", kind: Water, unit: "m3", direction: In)],
        factors: [(flow: "eletricidade", scope: 2, kg_co2e: Some(0.09),
                   source: "Fator didático (não é oficial)", didactic: true),
                  (flow: "gas", scope: 1, kg_co2e: Some(2.0),
                   source: "Fator didático (não é oficial)", didactic: true),
                  (flow: "tinta", scope: 3, kg_co2e: Some(3.0),
                   source: "Fator didático (não é oficial)", didactic: true),
                  (flow: "agua", scope: 3, kg_co2e: Some(0.3),
                   source: "Fator didático (não é oficial)", didactic: true)],
        tariff: Some((
            peak: (from: "18:00", to: "21:00", weekdays_only: false),
            demand_interval_min: 15,
            contracted_kw: Some(40.0),
            price_kwh_peak: None, price_kwh_off_peak: None, price_kw: None,
            price_kw_overrun: None,
            source: "Tarifa didática (não é oficial)",
        )),
    )),
)
