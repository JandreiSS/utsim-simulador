// Aprovação de compras (linha Lean Office): modelo pronto da linha, montado só com as
// predefinições de linhas/lean_office/biblioteca.ron.
//
// Os pedidos de compra chegam no horário comercial, com valor, prioridade e prazo (sla de
// 3 dias corridos). Compras cota o pedido (15 % saem com informação errada) e confere a
// cotação (percebe 90 % dos erros e devolve o pedido ao solicitante, que demora a
// responder). A alçada depende do valor: até 5 mil o gerente aprova, até 25 mil a
// diretoria, acima disso o comitê, que se reúne às quartas das 14h às 16h. Cada aprovação
// pode devolver o pedido para nova cotação. Aprovado, o pedido é emitido e concluído.
//
// Tempo em minutos; a semana começa na segunda às 0h (calendário "expediente": das 8h às
// 18h com almoço das 12h às 13h, de segunda a sexta). Rode com:
//   utsim linha lean_office relatorio examples/aprovacao_de_compras.ron --html relatorio.html
//
//   pedidos -> caixa_compras -> cotacao -> conferencia -> alcadas -+-> caixa_gerente -> aprov_gerente --+
//                  ^                           |                   +-> caixa_diretor -> aprov_diretor --+-> caixa_emissao -> emissao -> concluido
//                  +--- devolucao_solicitante <+                   +-> malote_comite -> comite_pauta -> comite --+
//                  +------------------------ devoluções das aprovações ------------------------+
Model(
    name: "Aprovação de compras",
    description: "Lean Office: três alçadas de aprovação por valor, devoluções, conferência com erro e comitê semanal",
    line: "lean_office",
    run: (stop_time: 50400.0, warmup: 10080.0, seed: 11, replications: 5),
    calendars: {
        "expediente": (period: 10080.0, off: [
            (start: 0.0, duration: 480.0),
            (start: 720.0, duration: 60.0),
            (start: 1080.0, duration: 840.0),
            (start: 2160.0, duration: 60.0),
            (start: 2520.0, duration: 840.0),
            (start: 3600.0, duration: 60.0),
            (start: 3960.0, duration: 840.0),
            (start: 5040.0, duration: 60.0),
            (start: 5400.0, duration: 840.0),
            (start: 6480.0, duration: 60.0),
            (start: 6840.0, duration: 3240.0),
        ]),
    },
    objects: [
        // Solicitante.
        (name: "pedidos", kind: Source(interarrival: Exp(mean: 30.0),
            labels: {
                "valor": LogNormal(mean: 8000.0, sd: 15000.0),
                "prioridade": Discrete([(1.0, 0.85), (2.0, 0.15)]),
                "sla": Const(4320.0),
            }),
            shifts: Calendar("expediente"), position: (0.0, 0.0, 0.0),
            preset: "lean_office/entrada", area: "Solicitante", symbol: "inicio"),
        (name: "devolucao_solicitante", kind: Processor(capacity: 100000, process: Exp(mean: 960.0)),
            position: (2.0, 0.0, 0.0),
            preset: "lean_office/espera_informacao", area: "Solicitante", symbol: "espera"),
        // Compras.
        (name: "caixa_compras", kind: Queue(order: Desc("prioridade")), position: (0.0, 2.0, 0.0),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            preset: "lean_office/caixa_entrada", area: "Compras", symbol: "espera"),
        (name: "cotacao", kind: Processor(capacity: 2, process: Triangular(min: 20.0, mode: 40.0, max: 90.0),
            operators: Some(OperatorUse(team: "compradores"))), position: (2.0, 2.0, 0.0),
            on_entry: "if random() > 0.85 { item.erro = 1.0; item.erros_cotacao = label(item, \"erros_cotacao\", 0.0) + 1.0; }",
            preset: "lean_office/posto", area: "Compras", symbol: "operacao"),
        (name: "conferencia", kind: Processor(capacity: 1, process: Triangular(min: 3.0, mode: 5.0, max: 10.0),
            operators: Some(OperatorUse(team: "compradores"))), position: (4.0, 2.0, 0.0),
            output: ByLabel("rota"),
            on_entry: "item.rota = 1.0; if label(item, \"erro\", 0.0) >= 1.0 && random() < 0.9 { item.erro = 0.0; item.rota = 2.0; }",
            preset: "lean_office/verificacao", area: "Compras", symbol: "inspecao"),
        (name: "alcadas", kind: Queue(), position: (6.0, 2.0, 0.0),
            output: Script("if item.valor <= 5000.0 { 1 } else if item.valor <= 25000.0 { 2 } else { 3 }"),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            preset: "lean_office/caixa_entrada", area: "Compras", symbol: "espera"),
        (name: "caixa_emissao", kind: Queue(order: Asc("prazo")), position: (8.0, 2.0, 0.0),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            preset: "lean_office/caixa_entrada", area: "Compras", symbol: "espera"),
        (name: "emissao", kind: Processor(capacity: 1, process: Triangular(min: 10.0, mode: 15.0, max: 30.0),
            operators: Some(OperatorUse(team: "compradores"))), position: (10.0, 2.0, 0.0),
            on_entry: "if random() > 1.0 { item.erro = 1.0; item.erros_emissao = label(item, \"erros_emissao\", 0.0) + 1.0; }",
            preset: "lean_office/posto", area: "Compras", symbol: "operacao"),
        (name: "concluido", kind: Sink, position: (12.0, 2.0, 0.0),
            preset: "lean_office/conclusao", area: "Compras", symbol: "fim"),
        // Gerência.
        (name: "caixa_gerente", kind: Queue(order: Desc("prioridade")), position: (6.0, 4.0, 0.0),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            preset: "lean_office/caixa_entrada", area: "Gerência", symbol: "espera"),
        (name: "aprov_gerente", kind: Processor(capacity: 1, process: Triangular(min: 5.0, mode: 10.0, max: 20.0),
            operators: Some(OperatorUse(team: "gerentes"))), position: (8.0, 4.0, 0.0),
            output: Weighted([0.92, 0.08]),
            preset: "lean_office/aprovacao", area: "Gerência", symbol: "inspecao"),
        // Diretoria.
        (name: "caixa_diretor", kind: Queue(order: Desc("prioridade")), position: (6.0, 6.0, 0.0),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            preset: "lean_office/caixa_entrada", area: "Diretoria", symbol: "espera"),
        (name: "aprov_diretor", kind: Processor(capacity: 1, process: Triangular(min: 10.0, mode: 20.0, max: 40.0),
            operators: Some(OperatorUse(team: "diretoria"))), position: (8.0, 6.0, 0.0),
            output: Weighted([0.9, 0.1]),
            preset: "lean_office/aprovacao", area: "Diretoria", symbol: "inspecao"),
        // Comitê.
        (name: "malote_comite", kind: Processor(capacity: 100000, process: Uniform(min: 60.0, max: 240.0)),
            position: (4.0, 8.0, 0.0),
            preset: "lean_office/tramitacao", area: "Comitê", symbol: "transporte"),
        (name: "comite", kind: Processor(process: Exp(mean: 10.0)),
            shifts: (period: 10080.0, off: [(start: 0.0, duration: 3720.0), (start: 3840.0, duration: 6240.0)]),
            output: Weighted([0.85, 0.15]), position: (7.0, 8.0, 0.0),
            preset: "lean_office/reuniao", area: "Comitê", symbol: "inspecao"),
        (name: "comite_pauta", kind: Queue(), position: (5.5, 8.0, 0.0),
            preset: "lean_office/reuniao", area: "Comitê", symbol: "espera"),
        // Pessoas e equipes.
        (name: "compradores", kind: Dispatcher(team: ["comprador_1", "comprador_2", "comprador_3", "comprador_4"]),
            position: (3.5, 0.8, 0.0), preset: "lean_office/equipe", area: "Compras"),
        (name: "comprador_1", kind: Transporter(speed: 72.0), position: (2.0, 1.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", area: "Compras"),
        (name: "comprador_2", kind: Transporter(speed: 72.0), position: (3.0, 1.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", area: "Compras"),
        (name: "comprador_3", kind: Transporter(speed: 72.0), position: (4.0, 1.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", area: "Compras"),
        (name: "comprador_4", kind: Transporter(speed: 72.0), position: (5.0, 1.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", area: "Compras"),
        (name: "gerentes", kind: Dispatcher(team: ["gerente"]), position: (9.0, 5.0, 0.0),
            preset: "lean_office/equipe", area: "Gerência"),
        (name: "gerente", kind: Transporter(speed: 72.0), position: (8.0, 5.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", area: "Gerência"),
        (name: "diretoria", kind: Dispatcher(team: ["diretor"]), position: (9.0, 7.0, 0.0),
            preset: "lean_office/equipe", area: "Diretoria"),
        (name: "diretor", kind: Transporter(speed: 72.0), position: (8.0, 7.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", area: "Diretoria"),
    ],
    connections: [
        ("pedidos", "caixa_compras"),
        ("caixa_compras", "cotacao"),
        ("cotacao", "conferencia"),
        ("conferencia", "alcadas"),               // porta 1: segue
        ("conferencia", "devolucao_solicitante"), // porta 2: erro percebido
        ("devolucao_solicitante", "caixa_compras"),
        ("alcadas", "caixa_gerente"),             // porta 1: até 5 mil
        ("alcadas", "caixa_diretor"),             // porta 2: até 25 mil
        ("alcadas", "malote_comite"),             // porta 3: acima de 25 mil
        ("caixa_gerente", "aprov_gerente"),
        ("aprov_gerente", "caixa_emissao"),       // aprova
        ("aprov_gerente", "caixa_compras"),       // devolve
        ("caixa_diretor", "aprov_diretor"),
        ("aprov_diretor", "caixa_emissao"),
        ("aprov_diretor", "caixa_compras"),
        ("malote_comite", "comite_pauta"),
        ("comite_pauta", "comite"),
        ("comite", "caixa_emissao"),
        ("comite", "caixa_compras"),
        ("caixa_emissao", "emissao"),
        ("emissao", "concluido"),
    ],
)
