// Cozinha de delivery (linha Alimentação e food service): modelo pronto da linha, montado
// só com as predefinições de linhas/alimentacao/biblioteca.ron.
//
// Uma cozinha que só vende por aplicativo recebe pedidos das 11h às 23h, todos os dias,
// com dois picos: 36 pedidos por hora no almoço (11h às 14h) e 48 no jantar (18h às 21h).
// O preparo tem 12 bocas; dois funcionários embalam. O pedido pronto espera o entregador
// no balcão de retirada; depois de 20 minutos a comida esfria e é descartada (o pedido é
// refeito por fora, e o descarte entra na conta). Os entregadores são de aplicativo: até 14
// ficam em rota ao mesmo tempo com pedidos desta cozinha, e a viagem até o cliente leva de
// 10 a 35 minutos. O pedido termina na entrega. No jantar faltam entregadores, e os pedidos
// esfriam no balcão.
//
// Tempo em minutos; o dia começa às 0h. Rode com:
//   utsim linha alimentacao relatorio examples/cozinha_delivery.ron --prazo 45 --html relatorio.html
//
//   pedidos -> fila_preparo -> preparo -> embalagem -> retirada -> entrega -> saida
Model(
    name: "Cozinha de delivery",
    description: "Alimentação e food service: pedidos de aplicativo com dois picos, preparo, embalagem, balcão de retirada onde a comida esfria e é descartada, e entregadores",
    line: "alimentacao",
    packs: ["seguranca"],
    run: (stop_time: 11520.0, warmup: 1440.0, seed: 73, replications: 5),
    calendars: {
        "loja": (period: 1440.0, off: [
            (start: 0.0, duration: 660.0),
            (start: 1380.0, duration: 60.0),
        ]),
        "turno": (period: 1440.0, off: [
            (start: 0.0, duration: 630.0),
        ]),
    },
    objects: [
        (name: "pedidos", kind: Source(interarrival: Exp(mean: 2.0),
            labels: {"canal": Const(3.0), "itens": Const(1.0)},
            schedule: Some((cycle: 1440.0, periods: [
                (start: 660.0, end: 840.0, arrivals: Rate(0.6)),
                (start: 840.0, end: 1080.0, arrivals: Rate(0.15)),
                (start: 1080.0, end: 1260.0, arrivals: Rate(0.8)),
                (start: 1260.0, end: 1380.0, arrivals: Rate(0.3)),
            ]))),
            shifts: Calendar("loja"), position: (0.0, 0.0, 0.0),
            preset: "alimentacao/pedidos", department: "Cozinha", symbol: "inicio"),
        (name: "fila_preparo", kind: Queue(), position: (2.0, 0.0, 0.0),
            visual: Some((asset: Some("area"))), preset: "alimentacao/fila", department: "Cozinha", symbol: "espera"),
        (name: "preparo", kind: Processor(capacity: 12, process: Triangular(min: 8.0, mode: 12.0, max: 18.0)),
            downtime: Some((mtbf: Exp(mean: 3000.0), mttr: Exp(mean: 30.0))),
            position: (4.0, 0.0, 0.0), ppe: ["touca", "avental"], visual: Some((asset: Some("bancada"))),
            preset: "alimentacao/estacao", department: "Cozinha", symbol: "operacao"),
        (name: "embalagem", kind: Processor(capacity: 2, process: Triangular(min: 1.0, mode: 1.5, max: 2.5),
            operators: Some(OperatorUse(team: "embaladores"))),
            position: (6.0, 0.0, 0.0), ppe: ["touca", "avental"], visual: Some((asset: Some("bancada"))),
            preset: "alimentacao/estacao", department: "Cozinha", symbol: "operacao"),
        (name: "retirada", kind: Queue(patience: Some(Const(20.0))), position: (8.0, 0.0, 0.0),
            visual: Some((asset: Some("armario"))), preset: "alimentacao/retirada", department: "Expedição", symbol: "armazenagem"),
        (name: "entrega", kind: Processor(capacity: 14, process: Triangular(min: 10.0, mode: 18.0, max: 35.0)),
            position: (10.0, 0.0, 0.0), ppe: ["capacete"], visual: Some((asset: Some("caixa"))),
            preset: "alimentacao/entrega", department: "Expedição", symbol: "transporte"),
        (name: "saida", kind: Sink, position: (12.0, 0.0, 0.0),
            preset: "alimentacao/saida", department: "Expedição", symbol: "fim"),
        (name: "embaladores", kind: Dispatcher(team: ["embaladores_1", "embaladores_2"], rule: FirstAvailable), position: (6.0, 2.0, 0.0),
            preset: "alimentacao/equipe", department: "Cozinha"),
        (name: "embaladores_1", kind: Transporter(speed: 60.0), position: (5.5, 3.0, 0.0),
            shifts: Calendar("turno", Finish), ppe: ["touca", "avental"], visual: Some((asset: Some("pessoa"))),
            person: Some(()), preset: "alimentacao/funcionario", department: "Cozinha"),
        (name: "embaladores_2", kind: Transporter(speed: 60.0), position: (6.5, 3.0, 0.0),
            shifts: Calendar("turno", Finish), ppe: ["touca", "avental"], visual: Some((asset: Some("pessoa"))),
            person: Some(()), preset: "alimentacao/funcionario", department: "Cozinha"),
    ],
    connections: [
        ("pedidos", "fila_preparo"),
        ("fila_preparo", "preparo"),
        ("preparo", "embalagem"),
        ("embalagem", "retirada"),
        ("retirada", "entrega"),
        ("entrega", "saida"),
    ],
)
