// Secretaria acadêmica (linha Lean Office): modelo pronto da linha, montado só com as
// predefinições de linhas/lean_office/biblioteca.ron. Área: secretaria acadêmica.
//
// Os alunos pedem documentos e ajustes de matrícula no horário de atendimento, com pico nas
// duas primeiras semanas do semestre (7,2 pedidos por hora, depois 2,4) e prazo de 3 dias
// corridos. O atendimento recebe o pedido (5 % com dado errado) e o encaminha pelo tipo:
// declaração (60 %) vai direto à emissão; histórico (25 %) passa pela conferência das notas,
// que espera o professor lançar a nota que falta; ajuste de matrícula (15 %) vai à
// coordenação, que defere ou pede um documento ao aluno, e depois ao registro no sistema.
// Os documentos emitidos são assinados digitalmente.
//
// Tempo em minutos; a semana começa na segunda às 0h (calendário "expediente": das 8h às
// 18h com almoço das 12h às 13h, de segunda a sexta); o ciclo das chegadas tem 8 semanas.
// Rode com:
//   utsim linha lean_office relatorio examples/secretaria_academica.ron --html relatorio.html
//
//   pedidos -> caixa_atendimento -> atendimento -> encaminhamento -+-> caixa_emissao -> emissao -> assinatura -> entregue
//                                                                  +-> caixa_historico -> conferencia_notas -+ (porta 2: espera_professor -> caixa_historico)
//                                                                  +-> caixa_coordenacao -> deferimento -> caixa_registro -> registro -> entregue
//                                                                                              (devolve: espera_aluno -> caixa_coordenacao)
Model(
    name: "Secretaria acadêmica",
    description: "Lean Office: pico de pedidos no início do semestre, declarações, históricos com espera pelo professor, ajustes de matrícula com a coordenação",
    line: "lean_office",
    run: (stop_time: 80640.0, warmup: 0.0, seed: 53, replications: 5),
    calendars: {
        "expediente": (period: 10080.0, off: [
            (start: 0.0, duration: 480.0),
            (start: 720.0, duration: 60.0),
            (start: 1080.0, duration: 840.0),
            (start: 2160.0, duration: 60.0),
            (start: 2520.0, duration: 840.0),
            (start: 3600.0, duration: 60.0),
            (start: 3960.0, duration: 840.0),
            (start: 5040.0, duration: 60.0),
            (start: 5400.0, duration: 840.0),
            (start: 6480.0, duration: 60.0),
            (start: 6840.0, duration: 3240.0),
        ]),
    },
    objects: [
        // Aluno.
        (name: "pedidos", kind: Source(interarrival: Exp(mean: 25.0),
            labels: {
                "tipo": Discrete([(1.0, 0.6), (2.0, 0.25), (3.0, 0.15)]),
                "prioridade": Discrete([(1.0, 0.9), (2.0, 0.1)]),
                "sla": Const(4320.0),
            },
            schedule: Some((cycle: 80640.0, periods: [
                (start: 0.0, end: 20160.0, arrivals: Rate(0.12)),
                (start: 20160.0, end: 80640.0, arrivals: Rate(0.04)),
            ]))),
            shifts: Calendar("expediente"), position: (0.0, 0.0, 0.0),
            preset: "lean_office/entrada", department: "Aluno", symbol: "inicio"),
        (name: "espera_aluno", kind: Processor(capacity: 100000, process: Exp(mean: 1440.0)), position: (6.0, 6.0, 0.0),
            preset: "lean_office/espera_informacao", department: "Aluno", symbol: "espera"),
        // Atendimento.
        (name: "caixa_atendimento", kind: Queue(order: Desc("prioridade")), position: (0.0, 2.0, 0.0),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            visual: Some((asset: Some("pilha_papeis"))), preset: "lean_office/caixa_entrada", department: "Atendimento", symbol: "espera"),
        (name: "atendimento", kind: Processor(capacity: 3, process: Triangular(min: 3.0, mode: 6.0, max: 12.0),
            operators: Some(OperatorUse(team: "atendentes"))), position: (1.0, 2.0, 0.0),
            on_entry: "if random() > 0.95 { item.erro = 1.0; item.erros_atendimento = label(item, \"erros_atendimento\", 0.0) + 1.0; }",
            visual: Some((asset: Some("mesa"))), preset: "lean_office/posto", department: "Atendimento", symbol: "operacao"),
        (name: "encaminhamento", kind: Queue(), position: (2.0, 2.0, 0.0),
            output: ByLabel("tipo"),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            visual: Some((asset: Some("pilha_papeis"))), preset: "lean_office/caixa_entrada", department: "Atendimento", symbol: "espera"),
        // Secretaria.
        (name: "caixa_emissao", kind: Queue(order: Asc("prazo")), position: (3.0, 1.0, 0.0),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            visual: Some((asset: Some("pilha_papeis"))), preset: "lean_office/caixa_entrada", department: "Secretaria", symbol: "espera"),
        (name: "emissao", kind: Processor(capacity: 2, process: Triangular(min: 2.0, mode: 5.0, max: 10.0),
            operators: Some(OperatorUse(team: "secretaria"))), position: (4.0, 1.0, 0.0),
            on_entry: "if random() > 1.0 { item.erro = 1.0; item.erros_emissao = label(item, \"erros_emissao\", 0.0) + 1.0; }",
            visual: Some((asset: Some("mesa"))), preset: "lean_office/posto", department: "Secretaria", symbol: "operacao"),
        (name: "assinatura", kind: Processor(capacity: 100000, process: Uniform(min: 30.0, max: 240.0)), position: (5.0, 1.0, 0.0),
            preset: "lean_office/tramitacao", department: "Secretaria", symbol: "transporte"),
        (name: "entregue", kind: Sink, position: (6.0, 2.0, 0.0),
            preset: "lean_office/conclusao", department: "Secretaria", symbol: "fim"),
        (name: "caixa_historico", kind: Queue(order: Asc("prazo")), position: (3.0, 3.0, 0.0),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            visual: Some((asset: Some("pilha_papeis"))), preset: "lean_office/caixa_entrada", department: "Secretaria", symbol: "espera"),
        (name: "conferencia_notas", kind: Processor(process: Triangular(min: 5.0, mode: 10.0, max: 20.0),
            operators: Some(OperatorUse(team: "secretaria"))), position: (4.0, 3.0, 0.0),
            output: ByLabel("rota"),
            on_entry: "item.rota = 1.0; if label(item, \"erro\", 0.0) >= 1.0 && random() < 0.9 { item.erro = 0.0; item.rota = 2.0; }",
            visual: Some((asset: Some("mesa"))), preset: "lean_office/verificacao", department: "Secretaria", symbol: "inspecao"),
        (name: "caixa_registro", kind: Queue(order: Asc("prazo")), position: (5.0, 4.0, 0.0),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            visual: Some((asset: Some("pilha_papeis"))), preset: "lean_office/caixa_entrada", department: "Secretaria", symbol: "espera"),
        (name: "registro", kind: Processor(process: Triangular(min: 5.0, mode: 10.0, max: 20.0),
            operators: Some(OperatorUse(team: "secretaria"))), position: (6.0, 4.0, 0.0),
            on_entry: "if random() > 1.0 { item.erro = 1.0; item.erros_registro = label(item, \"erros_registro\", 0.0) + 1.0; }",
            visual: Some((asset: Some("mesa"))), preset: "lean_office/posto", department: "Secretaria", symbol: "operacao"),
        // Professor.
        (name: "espera_professor", kind: Processor(capacity: 100000, process: Exp(mean: 2880.0)), position: (4.0, 5.0, 0.0),
            preset: "lean_office/espera_informacao", department: "Professor", symbol: "espera"),
        // Coordenação.
        (name: "caixa_coordenacao", kind: Queue(order: Asc("prazo")), position: (3.0, 6.0, 0.0),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            visual: Some((asset: Some("pilha_papeis"))), preset: "lean_office/caixa_entrada", department: "Coordenação", symbol: "espera"),
        (name: "deferimento", kind: Processor(process: Triangular(min: 5.0, mode: 10.0, max: 20.0),
            operators: Some(OperatorUse(team: "coordenacao"))), position: (4.0, 6.0, 0.0),
            output: Weighted([0.9, 0.1]),
            visual: Some((asset: Some("mesa"))), preset: "lean_office/aprovacao", department: "Coordenação", symbol: "inspecao"),
        // Pessoas e equipes.
        (name: "atendentes", kind: Dispatcher(team: ["atendente_1", "atendente_2"]), position: (1.5, 1.0, 0.0),
            preset: "lean_office/equipe", department: "Atendimento"),
        (name: "atendente_1", kind: Transporter(speed: 72.0), position: (1.0, 3.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", department: "Atendimento"),
        (name: "atendente_2", kind: Transporter(speed: 72.0), position: (1.5, 3.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", department: "Atendimento"),
        (name: "secretaria", kind: Dispatcher(team: ["secretario_1", "secretario_2"]), position: (5.0, 2.5, 0.0),
            preset: "lean_office/equipe", department: "Secretaria"),
        (name: "secretario_1", kind: Transporter(speed: 72.0), position: (4.0, 2.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", department: "Secretaria"),
        (name: "secretario_2", kind: Transporter(speed: 72.0), position: (4.5, 2.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", department: "Secretaria"),
        (name: "coordenacao", kind: Dispatcher(team: ["coordenador"]), position: (4.5, 7.0, 0.0),
            preset: "lean_office/equipe", department: "Coordenação"),
        (name: "coordenador", kind: Transporter(speed: 72.0), position: (4.0, 7.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", department: "Coordenação"),
    ],
    connections: [
        ("pedidos", "caixa_atendimento"),
        ("caixa_atendimento", "atendimento"),
        ("atendimento", "encaminhamento"),
        ("encaminhamento", "caixa_emissao"),   // porta 1: declaração
        ("encaminhamento", "caixa_historico"),   // porta 2: histórico
        ("encaminhamento", "caixa_coordenacao"),   // porta 3: ajuste de matrícula
        ("caixa_emissao", "emissao"),
        ("emissao", "assinatura"),
        ("assinatura", "entregue"),
        ("caixa_historico", "conferencia_notas"),
        ("conferencia_notas", "caixa_emissao"),   // porta 1: notas completas
        ("conferencia_notas", "espera_professor"),   // porta 2: falta nota
        ("espera_professor", "caixa_historico"),
        ("caixa_coordenacao", "deferimento"),
        ("deferimento", "caixa_registro"),   // defere
        ("deferimento", "espera_aluno"),   // pede documento
        ("espera_aluno", "caixa_coordenacao"),
        ("caixa_registro", "registro"),
        ("registro", "entregue"),
    ],
)
