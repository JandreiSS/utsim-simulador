// Central de solicitações (linha Lean Office): modelo pronto da linha, montado só com as
// predefinições de linhas/lean_office/biblioteca.ron.
//
// As solicitações dos usuários chegam com taxa por hora do dia (pico das 8h às 10h, vale no
// almoço), com tipo (1 dúvida, 2 problema, 3 pedido de acesso) e prioridade (1 normal, 2
// alta, 3 urgente). O prazo (sla) depende da prioridade: 24 h, 8 h e 4 h corridas. O nível 1
// faz a triagem e resolve as dúvidas e 60 % dos outros casos; o resto vai ao nível 2, que
// atende pelo prazo mais curto. Os atendentes do nível 1 atendem vários canais ao mesmo
// tempo (multitarefa: até 3 casos abertos, cerca de 10 min em cada um, 2 min perdidos a
// cada troca).
//
// Tempo em minutos; a semana começa na segunda às 0h (calendário "expediente": das 8h às
// 18h com almoço das 12h às 13h, de segunda a sexta). Rode com:
//   utsim linha lean_office relatorio examples/central_de_solicitacoes.ron --html relatorio.html
//
//   solicitacoes -> caixa_triagem -> triagem -> roteamento -+-> caixa_n1 -> atendimento_n1 --+-> resolvido
//                                                           +-> caixa_n2 -> atendimento_n2 --+
Model(
    name: "Central de solicitações",
    description: "Lean Office: chegadas por hora, triagem por tipo, níveis 1 e 2, prazo por prioridade e atendentes em multitarefa",
    line: "lean_office",
    run: (stop_time: 50400.0, warmup: 10080.0, seed: 31, replications: 5),
    calendars: {
        "expediente": (period: 10080.0, off: [
            (start: 0.0, duration: 480.0),
            (start: 720.0, duration: 60.0),
            (start: 1080.0, duration: 840.0),
            (start: 2160.0, duration: 60.0),
            (start: 2520.0, duration: 840.0),
            (start: 3600.0, duration: 60.0),
            (start: 3960.0, duration: 840.0),
            (start: 5040.0, duration: 60.0),
            (start: 5400.0, duration: 840.0),
            (start: 6480.0, duration: 60.0),
            (start: 6840.0, duration: 3240.0),
        ]),
    },
    objects: [
        // Usuário.
        (name: "solicitacoes", kind: Source(interarrival: Exp(mean: 10.0),
            labels: {
                "tipo": Discrete([(1.0, 0.5), (2.0, 0.3), (3.0, 0.2)]),
                "prioridade": Discrete([(1.0, 0.7), (2.0, 0.25), (3.0, 0.05)]),
            },
            schedule: Some((cycle: 10080.0, periods: [
                (start: 480.0, end: 600.0, arrivals: Rate(0.15)),
                (start: 600.0, end: 720.0, arrivals: Rate(0.1)),
                (start: 720.0, end: 780.0, arrivals: Rate(0.05)),
                (start: 780.0, end: 900.0, arrivals: Rate(0.12)),
                (start: 900.0, end: 1080.0, arrivals: Rate(0.08)),
                (start: 1920.0, end: 2040.0, arrivals: Rate(0.15)),
                (start: 2040.0, end: 2160.0, arrivals: Rate(0.1)),
                (start: 2160.0, end: 2220.0, arrivals: Rate(0.05)),
                (start: 2220.0, end: 2340.0, arrivals: Rate(0.12)),
                (start: 2340.0, end: 2520.0, arrivals: Rate(0.08)),
                (start: 3360.0, end: 3480.0, arrivals: Rate(0.15)),
                (start: 3480.0, end: 3600.0, arrivals: Rate(0.1)),
                (start: 3600.0, end: 3660.0, arrivals: Rate(0.05)),
                (start: 3660.0, end: 3780.0, arrivals: Rate(0.12)),
                (start: 3780.0, end: 3960.0, arrivals: Rate(0.08)),
                (start: 4800.0, end: 4920.0, arrivals: Rate(0.15)),
                (start: 4920.0, end: 5040.0, arrivals: Rate(0.1)),
                (start: 5040.0, end: 5100.0, arrivals: Rate(0.05)),
                (start: 5100.0, end: 5220.0, arrivals: Rate(0.12)),
                (start: 5220.0, end: 5400.0, arrivals: Rate(0.08)),
                (start: 6240.0, end: 6360.0, arrivals: Rate(0.15)),
                (start: 6360.0, end: 6480.0, arrivals: Rate(0.1)),
                (start: 6480.0, end: 6540.0, arrivals: Rate(0.05)),
                (start: 6540.0, end: 6660.0, arrivals: Rate(0.12)),
                (start: 6660.0, end: 6840.0, arrivals: Rate(0.08)),
            ]))),
            position: (0.0, 0.0, 0.0),
            preset: "lean_office/entrada", department: "Usuário", symbol: "inicio"),
        // Nível 1.
        (name: "caixa_triagem", kind: Queue(order: Desc("prioridade")), position: (0.0, 2.0, 0.0),
            on_entry: "if label(item, \"sla\", -1.0) < 0.0 { if item.prioridade >= 3.0 { item.sla = 240.0; } else if item.prioridade >= 2.0 { item.sla = 480.0; } else { item.sla = 1440.0; } } if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            preset: "lean_office/caixa_entrada", department: "Nível 1", symbol: "espera"),
        (name: "triagem", kind: Processor(capacity: 3, process: Triangular(min: 1.0, mode: 2.0, max: 4.0),
            operators: Some(OperatorUse(team: "nivel_1"))), position: (2.0, 2.0, 0.0),
            on_entry: "if random() > 0.97 { item.erro = 1.0; item.erros_triagem = label(item, \"erros_triagem\", 0.0) + 1.0; }",
            preset: "lean_office/posto", department: "Nível 1", symbol: "operacao"),
        (name: "roteamento", kind: Queue(), position: (4.0, 2.0, 0.0),
            output: ByLabel("rota"),
            on_entry: "if item.tipo <= 1.0 || random() < 0.6 { item.rota = 1.0; } else { item.rota = 2.0; } if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            preset: "lean_office/caixa_entrada", department: "Nível 1", symbol: "espera"),
        (name: "caixa_n1", kind: Queue(order: Asc("prazo")), position: (6.0, 2.0, 0.0),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            preset: "lean_office/caixa_entrada", department: "Nível 1", symbol: "espera"),
        (name: "atendimento_n1", kind: Processor(capacity: 9, process: Exp(mean: 12.0),
            operators: Some(OperatorUse(team: "nivel_1"))), position: (8.0, 2.0, 0.0),
            on_entry: "if random() > 0.95 { item.erro = 1.0; item.erros_atendimento_n1 = label(item, \"erros_atendimento_n1\", 0.0) + 1.0; }",
            preset: "lean_office/posto", department: "Nível 1", symbol: "operacao"),
        (name: "resolvido", kind: Sink, position: (10.0, 3.0, 0.0),
            preset: "lean_office/conclusao", department: "Nível 1", symbol: "fim"),
        // Nível 2.
        (name: "caixa_n2", kind: Queue(order: Asc("prazo")), position: (6.0, 4.0, 0.0),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            preset: "lean_office/caixa_entrada", department: "Nível 2", symbol: "espera"),
        (name: "atendimento_n2", kind: Processor(capacity: 2, process: Triangular(min: 20.0, mode: 45.0, max: 120.0),
            operators: Some(OperatorUse(team: "nivel_2"))), position: (8.0, 4.0, 0.0),
            on_entry: "if random() > 1.0 { item.erro = 1.0; item.erros_atendimento_n2 = label(item, \"erros_atendimento_n2\", 0.0) + 1.0; }",
            preset: "lean_office/posto", department: "Nível 2", symbol: "operacao"),
        // Pessoas e equipes.
        (name: "nivel_1", kind: Dispatcher(team: ["atendente_1", "atendente_2", "atendente_3"]),
            position: (5.0, 0.8, 0.0), preset: "lean_office/equipe", department: "Nível 1"),
        (name: "atendente_1", kind: Transporter(speed: 72.0,
            multitask: Some((max_open: 3, slice: Exp(mean: 10.0), switch: Const(2.0)))),
            position: (4.0, 1.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", department: "Nível 1"),
        (name: "atendente_2", kind: Transporter(speed: 72.0,
            multitask: Some((max_open: 3, slice: Exp(mean: 10.0), switch: Const(2.0)))),
            position: (5.0, 1.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", department: "Nível 1"),
        (name: "atendente_3", kind: Transporter(speed: 72.0,
            multitask: Some((max_open: 3, slice: Exp(mean: 10.0), switch: Const(2.0)))),
            position: (6.0, 1.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", department: "Nível 1"),
        (name: "nivel_2", kind: Dispatcher(team: ["analista_n2_1", "analista_n2_2"]),
            position: (9.0, 5.5, 0.0), preset: "lean_office/equipe", department: "Nível 2"),
        (name: "analista_n2_1", kind: Transporter(speed: 72.0), position: (8.0, 5.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", department: "Nível 2"),
        (name: "analista_n2_2", kind: Transporter(speed: 72.0), position: (9.0, 5.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", department: "Nível 2"),
    ],
    connections: [
        ("solicitacoes", "caixa_triagem"),
        ("caixa_triagem", "triagem"),
        ("triagem", "roteamento"),
        ("roteamento", "caixa_n1"),          // porta 1: o nível 1 resolve
        ("roteamento", "caixa_n2"),          // porta 2: vai ao nível 2
        ("caixa_n1", "atendimento_n1"),
        ("atendimento_n1", "resolvido"),
        ("caixa_n2", "atendimento_n2"),
        ("atendimento_n2", "resolvido"),
    ],
)
