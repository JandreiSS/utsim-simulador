// Armazém com porta-paletes: cargas chegam pela recepção, esperam numa fila e são
// guardadas em um porta-paletes de 6 colunas × 4 níveis (24 posições). Cada carga
// fica entre 20 e 60 unidades de tempo (uniforme) e depois sai pela expedição.
//
// Carga média: 1 chegada a cada 2 unidades (λ = 0,5) × permanência média 40 = 20 posições
// ocupadas em média, de 24. Em picos o porta-paletes enche e a fila segura as chegadas,
// o que aparece nos estados "blocked" e no conteúdo da fila.
Model(
    name: "Armazém com porta-paletes",
    run: (stop_time: 5000.0, warmup: 500.0, seed: 13, replications: 3),
    objects: [
        (name: "recepcao", kind: Source(interarrival: Exp(mean: 2.0)), position: (0.0, 0.0, 0.0)),
        (name: "fila_recepcao", kind: Queue(capacity: Some(10)), position: (4.0, 0.0, 0.0)),
        (
            name: "porta_paletes",
            kind: Rack(
                bays: 6,
                levels: 4,
                dwell: Some(Uniform(min: 20.0, max: 60.0)),
                placement: FirstFree,
                // Espaçamento na visualização 3D: 1,2 de largura por coluna, 1,5 de altura por nível.
                bay_width: 1.2,
                level_height: 1.5,
            ),
            position: (10.5, 0.0, 0.0),
        ),
        (name: "expedicao", kind: Sink, position: (18.0, 0.0, 0.0)),
    ],
    connections: [
        ("recepcao", "fila_recepcao"),
        ("fila_recepcao", "porta_paletes"),
        ("porta_paletes", "expedicao"),
    ],
)
