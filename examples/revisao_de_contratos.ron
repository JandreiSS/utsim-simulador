// Revisão de contratos (linha Lean Office): modelo pronto da linha, montado só com as
// predefinições de linhas/lean_office/biblioteca.ron. Área: jurídico e contratos.
//
// As áreas da empresa pedem contratos no horário comercial, com valor, prioridade,
// complexidade (1 padrão, 70 %; 2 específico, 30 %) e prazo de 10 dias corridos. O jurídico
// faz a triagem; os contratos padrão saem de uma minuta pronta, feita pelo assistente, e os
// específicos são redigidos pelos advogados, que tocam vários contratos ao mesmo tempo
// (multitarefa: até 3 abertos, cerca de 1 hora em cada um, 10 minutos perdidos a cada troca).
// A minuta vai à contraparte, que demora a responder; a revisão final do advogado sênior
// devolve ao jurídico 90 % das minutas com erro, e a diretoria aprova (5 % voltam). A
// assinatura eletrônica fecha o caso.
//
// Tempo em minutos; a semana começa na segunda às 0h (calendário "expediente": das 8h às
// 18h com almoço das 12h às 13h, de segunda a sexta). Rode com:
//   utsim linha lean_office relatorio examples/revisao_de_contratos.ron --html relatorio.html
//
//   pedidos -> caixa_juridico -> triagem -> distribuicao -+-> caixa_padrao -> minuta_padrao ------+-> negociacao -> caixa_revisao -> revisao_final -> caixa_diretoria -> aprovacao -> assinatura -> assinado
//                   ^                                     +-> caixa_especifica -> minuta_especifica -+                                  |                                    |
//                   +------------------------------------------- devoluções -------------------------------------------------------------+------------------------------------+
Model(
    name: "Revisão de contratos",
    description: "Lean Office: contratos padrão e específicos, advogados em multitarefa, negociação com a contraparte, revisão final e aprovação da diretoria",
    line: "lean_office",
    run: (stop_time: 80640.0, warmup: 10080.0, seed: 43, replications: 5),
    calendars: {
        "expediente": (period: 10080.0, off: [
            (start: 0.0, duration: 480.0),
            (start: 720.0, duration: 60.0),
            (start: 1080.0, duration: 840.0),
            (start: 2160.0, duration: 60.0),
            (start: 2520.0, duration: 840.0),
            (start: 3600.0, duration: 60.0),
            (start: 3960.0, duration: 840.0),
            (start: 5040.0, duration: 60.0),
            (start: 5400.0, duration: 840.0),
            (start: 6480.0, duration: 60.0),
            (start: 6840.0, duration: 3240.0),
        ]),
    },
    objects: [
        // Área solicitante.
        (name: "pedidos", kind: Source(interarrival: Exp(mean: 240.0),
            labels: {
                "valor": LogNormal(mean: 50000.0, sd: 80000.0),
                "prioridade": Discrete([(1.0, 0.8), (2.0, 0.2)]),
                "complexidade": Discrete([(1.0, 0.7), (2.0, 0.3)]),
                "sla": Const(14400.0),
            }),
            shifts: Calendar("expediente"), position: (0.0, 0.0, 0.0),
            preset: "lean_office/entrada", department: "Área solicitante", symbol: "inicio"),
        // Jurídico.
        (name: "caixa_juridico", kind: Queue(order: Desc("prioridade")), position: (0.0, 2.0, 0.0),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            visual: Some((asset: Some("pilha_papeis"))), preset: "lean_office/caixa_entrada", department: "Jurídico", symbol: "espera"),
        (name: "triagem", kind: Processor(process: Triangular(min: 10.0, mode: 20.0, max: 40.0),
            operators: Some(OperatorUse(team: "advogados"))), position: (1.0, 2.0, 0.0),
            on_entry: "if random() > 1.0 { item.erro = 1.0; item.erros_triagem = label(item, \"erros_triagem\", 0.0) + 1.0; }",
            visual: Some((asset: Some("mesa"))), preset: "lean_office/posto", department: "Jurídico", symbol: "operacao"),
        (name: "distribuicao", kind: Queue(), position: (2.0, 2.0, 0.0),
            output: ByLabel("complexidade"),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            visual: Some((asset: Some("pilha_papeis"))), preset: "lean_office/caixa_entrada", department: "Jurídico", symbol: "espera"),
        (name: "caixa_padrao", kind: Queue(order: Asc("prazo")), position: (3.0, 1.0, 0.0),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            visual: Some((asset: Some("pilha_papeis"))), preset: "lean_office/caixa_entrada", department: "Jurídico", symbol: "espera"),
        (name: "minuta_padrao", kind: Processor(process: Triangular(min: 20.0, mode: 40.0, max: 90.0),
            operators: Some(OperatorUse(team: "assistentes"))), position: (4.0, 1.0, 0.0),
            on_entry: "if random() > 0.95 { item.erro = 1.0; item.erros_minuta_padrao = label(item, \"erros_minuta_padrao\", 0.0) + 1.0; }",
            visual: Some((asset: Some("mesa"))), preset: "lean_office/posto", department: "Jurídico", symbol: "operacao"),
        (name: "caixa_especifica", kind: Queue(order: Asc("prazo")), position: (3.0, 3.0, 0.0),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            visual: Some((asset: Some("pilha_papeis"))), preset: "lean_office/caixa_entrada", department: "Jurídico", symbol: "espera"),
        (name: "minuta_especifica", kind: Processor(capacity: 6, process: Triangular(min: 120.0, mode: 240.0, max: 480.0),
            operators: Some(OperatorUse(team: "advogados"))), position: (4.0, 3.0, 0.0),
            on_entry: "if random() > 0.85 { item.erro = 1.0; item.erros_minuta_especifica = label(item, \"erros_minuta_especifica\", 0.0) + 1.0; }",
            visual: Some((asset: Some("mesa"))), preset: "lean_office/posto", department: "Jurídico", symbol: "operacao"),
        (name: "caixa_revisao", kind: Queue(order: Asc("prazo")), position: (6.0, 2.0, 0.0),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            visual: Some((asset: Some("pilha_papeis"))), preset: "lean_office/caixa_entrada", department: "Jurídico", symbol: "espera"),
        (name: "revisao_final", kind: Processor(process: Triangular(min: 20.0, mode: 40.0, max: 90.0),
            operators: Some(OperatorUse(team: "seniores"))), position: (7.0, 2.0, 0.0),
            output: ByLabel("rota"),
            on_entry: "item.rota = 1.0; if label(item, \"erro\", 0.0) >= 1.0 && random() < 0.9 { item.erro = 0.0; item.rota = 2.0; }",
            visual: Some((asset: Some("mesa"))), preset: "lean_office/verificacao", department: "Jurídico", symbol: "inspecao"),
        // Contraparte.
        (name: "negociacao", kind: Processor(capacity: 100000, process: Exp(mean: 2880.0)), position: (5.0, 0.0, 0.0),
            preset: "lean_office/espera_informacao", department: "Contraparte", symbol: "espera"),
        // Diretoria.
        (name: "caixa_diretoria", kind: Queue(order: Desc("prioridade")), position: (8.0, 3.0, 0.0),
            on_entry: "if label(item, \"prazo\", -1.0) < 0.0 && label(item, \"sla\", -1.0) >= 0.0 { item.prazo = now + item.sla; }",
            visual: Some((asset: Some("pilha_papeis"))), preset: "lean_office/caixa_entrada", department: "Diretoria", symbol: "espera"),
        (name: "aprovacao", kind: Processor(process: Triangular(min: 10.0, mode: 20.0, max: 40.0),
            operators: Some(OperatorUse(team: "diretoria"))), position: (9.0, 3.0, 0.0),
            output: Weighted([0.95, 0.05]),
            visual: Some((asset: Some("mesa"))), preset: "lean_office/aprovacao", department: "Diretoria", symbol: "inspecao"),
        (name: "assinatura", kind: Processor(capacity: 100000, process: Uniform(min: 60.0, max: 1440.0)), position: (10.0, 3.0, 0.0),
            preset: "lean_office/tramitacao", department: "Diretoria", symbol: "transporte"),
        (name: "assinado", kind: Sink, position: (11.0, 3.0, 0.0),
            preset: "lean_office/conclusao", department: "Diretoria", symbol: "fim"),
        // Pessoas e equipes.
        (name: "advogados", kind: Dispatcher(team: ["advogado_1", "advogado_2"]), position: (4.5, 5.0, 0.0),
            preset: "lean_office/equipe", department: "Jurídico"),
        (name: "advogado_1", kind: Transporter(speed: 72.0,
            multitask: Some((max_open: 3, slice: Exp(mean: 60.0), switch: Const(10.0)))), position: (4.0, 4.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", department: "Jurídico"),
        (name: "advogado_2", kind: Transporter(speed: 72.0,
            multitask: Some((max_open: 3, slice: Exp(mean: 60.0), switch: Const(10.0)))), position: (4.5, 4.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", department: "Jurídico"),
        (name: "assistentes", kind: Dispatcher(team: ["assistente"]), position: (4.5, 0.5, 0.0),
            preset: "lean_office/equipe", department: "Jurídico"),
        (name: "assistente", kind: Transporter(speed: 72.0), position: (4.0, 0.5, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", department: "Jurídico"),
        (name: "seniores", kind: Dispatcher(team: ["advogado_senior"]), position: (7.5, 3.0, 0.0),
            preset: "lean_office/equipe", department: "Jurídico"),
        (name: "advogado_senior", kind: Transporter(speed: 72.0), position: (7.0, 3.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", department: "Jurídico"),
        (name: "diretoria", kind: Dispatcher(team: ["diretor"]), position: (9.5, 4.0, 0.0),
            preset: "lean_office/equipe", department: "Diretoria"),
        (name: "diretor", kind: Transporter(speed: 72.0), position: (9.0, 4.0, 0.0),
            shifts: Calendar("expediente"), visual: Some((asset: Some("pessoa"))), person: Some(()),
            preset: "lean_office/pessoa", department: "Diretoria"),
    ],
    connections: [
        ("pedidos", "caixa_juridico"),
        ("caixa_juridico", "triagem"),
        ("triagem", "distribuicao"),
        ("distribuicao", "caixa_padrao"),   // porta 1: contrato padrão
        ("distribuicao", "caixa_especifica"),   // porta 2: contrato específico
        ("caixa_padrao", "minuta_padrao"),
        ("caixa_especifica", "minuta_especifica"),
        ("minuta_padrao", "negociacao"),
        ("minuta_especifica", "negociacao"),
        ("negociacao", "caixa_revisao"),
        ("caixa_revisao", "revisao_final"),
        ("revisao_final", "caixa_diretoria"),   // porta 1: minuta certa
        ("revisao_final", "caixa_juridico"),   // porta 2: erro percebido
        ("caixa_diretoria", "aprovacao"),
        ("aprovacao", "assinatura"),   // aprova
        ("aprovacao", "caixa_juridico"),   // devolve
        ("assinatura", "assinado"),
    ],
)
