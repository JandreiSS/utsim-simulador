// Estudo de caso 2: centro de distribuição. Tempo em segundos, distâncias em metros.
// O centro opera de forma contínua. Rodamos 44 h e descartamos as 4 primeiras (o porta-paletes
// leva umas 2 h para chegar ao regime). Janela de estatísticas: 40 h.
//
// Planta (vista de cima, x para a direita, y para cima):
//
//   pátio   docas      esteira (30 m)    recepção      cruzamento              porta-paletes
//   (-3,0) (0,0) ---> (3,0)...(33,0) -> (36,0) ------ (60,0) ================ (100,0)
//                                                        |  |   corredor estreito
//                                                        |  |   (40 m, um veículo por vez)
//                                                garagem-+  |
//                                                (60,10)    | (22 m)
//                                                        picking (60,-22)
//                                                           |
//                                                           | 60 m a pé (pickers)
//                                                        embalagem (60,-82/-84)
//                                                           |
//                                                        expedição (60,-100)
Model(
    name: "Centro de distribuição",
    description: "Docas, esteira, porta-paletes seletivo com corredor estreito, empilhadeiras, picking e embalagem",
    run: (stop_time: 158400.0, warmup: 14400.0, seed: 2026, replications: 30),
    objects: [
        // ----- Recebimento -----
        (name: "caminhoes", kind: Source(interarrival: Exp(mean: 1732.4)), position: (-5.0, 0.0, 0.0)),
        (name: "patio", kind: Queue(), position: (-3.0, 0.0, 0.0)),
        (name: "docas", kind: Processor(capacity: 2, process: Uniform(min: 901.0, max: 1499.0)), position: (0.0, 0.0, 0.0)),
        (name: "descarga", kind: Separator(mode: Split(10), process: Uniform(min: 5.0, max: 15.0)), position: (3.0, 0.0, 0.0)),
        (name: "esteira_recebimento", kind: Conveyor(length: 30.0, speed: 0.4, item_length: 1.2, accumulating: true),
            position: (18.0, 0.0, 0.0)),
        (name: "recebimento", kind: Queue(), transport: "frota", position: (36.0, 0.0, 0.0)),

        // ----- Armazenagem: porta-paletes seletivo, 24 colunas x 4 níveis -----
        (name: "porta_paletes", kind: Rack(bays: 24, levels: 4, dwell: Uniform(min: 3600.0, max: 10800.0),
                placement: FirstFree, bay_width: 1.2, level_height: 1.5),
            transport: "frota", position: (100.0, 0.0, 0.0)),

        // ----- Empilhadeiras (andam pela rede e respeitam o corredor estreito) -----
        (name: "emp_1", kind: Transporter(speed: 2.0, acceleration: Some(0.6), deceleration: Some(0.6),
                load_time: Uniform(min: 8.0, max: 14.0), unload_time: Uniform(min: 10.0, max: 20.0), home: true, agv: true),
            position: (60.0, 10.0, 0.0)),
        (name: "emp_2", kind: Transporter(speed: 2.0, acceleration: Some(0.6), deceleration: Some(0.6),
                load_time: Uniform(min: 8.0, max: 14.0), unload_time: Uniform(min: 10.0, max: 20.0), home: true, agv: true),
            position: (60.0, 10.0, 0.0)),
        (name: "emp_3", kind: Transporter(speed: 2.0, acceleration: Some(0.6), deceleration: Some(0.6),
                load_time: Uniform(min: 8.0, max: 14.0), unload_time: Uniform(min: 10.0, max: 20.0), home: true, agv: true),
            position: (60.0, 10.0, 0.0)),
        (name: "emp_4", kind: Transporter(speed: 2.0, acceleration: Some(0.6), deceleration: Some(0.6),
                load_time: Uniform(min: 8.0, max: 14.0), unload_time: Uniform(min: 10.0, max: 20.0), home: true, agv: true),
            position: (60.0, 10.0, 0.0)),
        (name: "frota", kind: Dispatcher(team: ["emp_1", "emp_2", "emp_3"], rule: Nearest), position: (60.0, 10.0, 0.0)),

        // ----- Picking: o palete retirado é quebrado em 6 caixas, cada uma separada por um picker -----
        (name: "fila_picking", kind: Queue(), position: (60.0, -18.0, 0.0)),
        (name: "quebra", kind: Separator(mode: Split(6), process: Uniform(min: 15.0, max: 25.0)), position: (60.0, -20.0, 0.0)),
        (name: "fila_pedidos", kind: Queue(), position: (60.0, -21.0, 0.0)),
        (name: "separacao", kind: Processor(capacity: 6, process: Shifted(offset: 33.062, dist: Weibull(shape: 2.437, scale: 23.854)),
                operators: OperatorUse(team: "pickers", count: 1, setup: false, process: true)),
            transport: "pickers", position: (60.0, -22.0, 0.0)),

        // ----- Pickers: andam a 1,3 m/s, levam até 3 caixas por viagem num carrinho -----
        (name: "picker_1", kind: Transporter(speed: 1.3, capacity: 3, load_time: Uniform(min: 3.0, max: 6.0),
                unload_time: Uniform(min: 3.0, max: 6.0), home: true), position: (60.0, -22.0, 0.0)),
        (name: "picker_2", kind: Transporter(speed: 1.3, capacity: 3, load_time: Uniform(min: 3.0, max: 6.0),
                unload_time: Uniform(min: 3.0, max: 6.0), home: true), position: (60.0, -22.0, 0.0)),
        (name: "picker_3", kind: Transporter(speed: 1.3, capacity: 3, load_time: Uniform(min: 3.0, max: 6.0),
                unload_time: Uniform(min: 3.0, max: 6.0), home: true), position: (60.0, -22.0, 0.0)),
        (name: "picker_4", kind: Transporter(speed: 1.3, capacity: 3, load_time: Uniform(min: 3.0, max: 6.0),
                unload_time: Uniform(min: 3.0, max: 6.0), home: true), position: (60.0, -22.0, 0.0)),
        (name: "picker_5", kind: Transporter(speed: 1.3, capacity: 3, load_time: Uniform(min: 3.0, max: 6.0),
                unload_time: Uniform(min: 3.0, max: 6.0), home: true), position: (60.0, -22.0, 0.0)),
        (name: "picker_6", kind: Transporter(speed: 1.3, capacity: 3, load_time: Uniform(min: 3.0, max: 6.0),
                unload_time: Uniform(min: 3.0, max: 6.0), home: true), position: (60.0, -22.0, 0.0)),
        (name: "picker_7", kind: Transporter(speed: 1.3, capacity: 3, load_time: Uniform(min: 3.0, max: 6.0),
                unload_time: Uniform(min: 3.0, max: 6.0), home: true), position: (60.0, -22.0, 0.0)),
        (name: "picker_8", kind: Transporter(speed: 1.3, capacity: 3, load_time: Uniform(min: 3.0, max: 6.0),
                unload_time: Uniform(min: 3.0, max: 6.0), home: true), position: (60.0, -22.0, 0.0)),
        (name: "picker_9", kind: Transporter(speed: 1.3, capacity: 3, load_time: Uniform(min: 3.0, max: 6.0),
                unload_time: Uniform(min: 3.0, max: 6.0), home: true), position: (60.0, -22.0, 0.0)),
        (name: "picker_10", kind: Transporter(speed: 1.3, capacity: 3, load_time: Uniform(min: 3.0, max: 6.0),
                unload_time: Uniform(min: 3.0, max: 6.0), home: true), position: (60.0, -22.0, 0.0)),
        (name: "pickers", kind: Dispatcher(team: ["picker_1", "picker_2", "picker_3", "picker_4", "picker_5"], rule: Nearest),
            position: (60.0, -22.0, 0.0)),

        // ----- Embalagem e expedição -----
        (name: "fila_embalagem", kind: Queue(), position: (60.0, -82.0, 0.0)),
        (name: "embalagem", kind: Processor(capacity: 5, process: Triangular(min: 50.0, mode: 70.0, max: 110.0)),
            transfer: (speed: 1.0), position: (60.0, -84.0, 0.0)),
        (name: "expedicao", kind: Sink, position: (60.0, -100.0, 0.0)),
    ],
    connections: [
        ("caminhoes", "patio"),
        ("patio", "docas"),
        ("docas", "descarga"),
        ("descarga", "esteira_recebimento"),
        ("esteira_recebimento", "recebimento"),
        ("recebimento", "porta_paletes"),
        ("porta_paletes", "fila_picking"),
        ("fila_picking", "quebra"),
        ("quebra", "fila_pedidos"),
        ("fila_pedidos", "separacao"),
        ("separacao", "fila_embalagem"),
        ("fila_embalagem", "embalagem"),
        ("embalagem", "expedicao"),
    ],
    network: Some((
        nodes: [
            (name: "recepcao", position: (36.0, 0.0, 0.0)),
            (name: "cruzamento", position: (60.0, 0.0, 0.0)),
            (name: "garagem", position: (60.0, 10.0, 0.0)),
            (name: "rack", position: (100.0, 0.0, 0.0)),
            (name: "picking", position: (60.0, -22.0, 0.0)),
            (name: "embalagem", position: (60.0, -82.0, 0.0)),
        ],
        edges: [
            (from: "recepcao", to: "cruzamento"),
            (from: "cruzamento", to: "garagem"),
            // Corredor estreito do porta-paletes: um veículo por vez, nos dois sentidos.
            (from: "cruzamento", to: "rack", two_way: true, capacity: Some(1)),
            (from: "cruzamento", to: "picking"),
            (from: "picking", to: "embalagem", two_way: true),
        ],
    )),
)
