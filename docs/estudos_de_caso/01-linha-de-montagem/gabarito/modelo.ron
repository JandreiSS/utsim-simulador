// Estudo de caso 1: linha de montagem com inspeção e retrabalho. Tempo em segundos.
//
// O relógio do modelo começa às 06h00 (t = 0). Um dia tem 86400 s.
// Turnos: 1º das 06h às 14h, 2º das 14h às 22h, parada de 30 min no meio de cada turno
// (10h e 18h), noite parada das 22h às 06h. Todos os objetos da linha usam o mesmo calendário.
//
//  bases ---> fila_bases --\
//                           >-- montagem (Combiner) -> fila_solda -> solda -> fila_cal -> calibracao
//  placas --> fila_placas -/                                (quebras)           ^            |
//                                                                  fila_retorno-+            v
//        expedicao <--88%-- inspecao (3 bancadas, inspetores) <---------------- fila_insp <--+
//                              |12%
//                              +--> fila_retrabalho -> retrabalho --> fila_retorno (volta à calibração)
Model(
    name: "Linha de montagem com inspeção e retrabalho",
    description: "Kit de placas, solda com quebras, calibração, inspeção com 12% de defeito e retrabalho",
    run: (stop_time: 950400.0, warmup: 86400.0, seed: 2026, replications: 20),
    objects: [
        // ----- Entradas -----
        (name: "bases", kind: Source(interarrival: Uniform(min: 45.0, max: 65.0)),
            shifts: (period: 86400.0, off: [(start: 14400.0, duration: 1800.0), (start: 43200.0, duration: 1800.0), (start: 57600.0, duration: 28800.0)]),
            position: (0.0, 0.0, 0.0)),
        (name: "placas", kind: Source(interarrival: Uniform(min: 12.0, max: 24.0)),
            shifts: (period: 86400.0, off: [(start: 14400.0, duration: 1800.0), (start: 43200.0, duration: 1800.0), (start: 57600.0, duration: 28800.0)]),
            position: (0.0, 6.0, 0.0)),
        (name: "fila_bases", kind: Queue(capacity: 4), position: (4.0, 0.0, 0.0)),
        (name: "fila_placas", kind: Queue(capacity: 12), position: (4.0, 6.0, 0.0)),

        // ----- Estação 1: montagem do kit (1 base + 3 placas) -----
        (name: "montagem", kind: Combiner(components: [3], mode: Pack,
                setup: Uniform(min: 3.0, max: 7.0),
                process: Triangular(min: 38.0, mode: 45.0, max: 60.0)),
            shifts: (period: 86400.0, off: [(start: 14400.0, duration: 1800.0), (start: 43200.0, duration: 1800.0), (start: 57600.0, duration: 28800.0)]),
            position: (10.0, 3.0, 0.0)),
        (name: "fila_solda", kind: Queue(capacity: 2), position: (14.0, 3.0, 0.0)),

        // ----- Estação 2: solda (quebras) -----
        (name: "solda", kind: Processor(process: Triangular(min: 30.0, mode: 38.0, max: 48.0)),
            downtime: (mtbf: Exp(mean: 7220.7), mttr: Exp(mean: 1612.0)),
            shifts: (period: 86400.0, off: [(start: 14400.0, duration: 1800.0), (start: 43200.0, duration: 1800.0), (start: 57600.0, duration: 28800.0)]),
            position: (20.0, 3.0, 0.0)),
        (name: "fila_cal", kind: Queue(capacity: 2), position: (24.0, 3.0, 0.0)),

        // ----- Estação 3: calibração (recebe também as peças retrabalhadas, com prioridade) -----
        (name: "fila_retorno", kind: Queue(), position: (24.0, 9.0, 0.0)),
        (name: "calibracao", kind: Processor(process: LogNormal(mean: 44.443, sd: 6.148)),
            shifts: (period: 86400.0, off: [(start: 14400.0, duration: 1800.0), (start: 43200.0, duration: 1800.0), (start: 57600.0, duration: 28800.0)]),
            position: (30.0, 3.0, 0.0)),
        (name: "fila_insp", kind: Queue(capacity: 2), position: (34.0, 3.0, 0.0)),

        // ----- Estação 4: inspeção (3 bancadas, 1 inspetor por peça) -----
        (name: "inspecao", kind: Processor(capacity: 3, process: Gamma(shape: 4.117, scale: 24.787),
                operators: OperatorUse(team: "inspetores", count: 1, setup: false, process: true)),
            output: Weighted([0.88, 0.12]),
            shifts: (period: 86400.0, off: [(start: 14400.0, duration: 1800.0), (start: 43200.0, duration: 1800.0), (start: 57600.0, duration: 28800.0)]),
            position: (40.0, 3.0, 0.0)),
        (name: "expedicao", kind: Sink, position: (48.0, 0.0, 0.0)),

        // ----- Retrabalho -----
        (name: "fila_retrabalho", kind: Queue(), position: (40.0, 9.0, 0.0)),
        (name: "retrabalho", kind: Processor(process: Triangular(min: 150.0, mode: 240.0, max: 420.0)),
            shifts: (period: 86400.0, off: [(start: 14400.0, duration: 1800.0), (start: 43200.0, duration: 1800.0), (start: 57600.0, duration: 28800.0)]),
            position: (34.0, 9.0, 0.0)),

        // ----- Inspetores: ficam na mesa de apoio, a 8 m das bancadas, e andam a 1,3 m/s -----
        (name: "inspetor_1", kind: Transporter(speed: 1.3, home: true),
            shifts: (period: 86400.0, off: [(start: 14400.0, duration: 1800.0), (start: 43200.0, duration: 1800.0), (start: 57600.0, duration: 28800.0)]),
            position: (40.0, 11.0, 0.0)),
        (name: "inspetor_2", kind: Transporter(speed: 1.3, home: true),
            shifts: (period: 86400.0, off: [(start: 14400.0, duration: 1800.0), (start: 43200.0, duration: 1800.0), (start: 57600.0, duration: 28800.0)]),
            position: (40.0, 11.0, 0.0)),
        (name: "inspetor_3", kind: Transporter(speed: 1.3, home: true),
            shifts: (period: 86400.0, off: [(start: 14400.0, duration: 1800.0), (start: 43200.0, duration: 1800.0), (start: 57600.0, duration: 28800.0)]),
            position: (40.0, 11.0, 0.0)),
        (name: "inspetor_4", kind: Transporter(speed: 1.3, home: true),
            shifts: (period: 86400.0, off: [(start: 14400.0, duration: 1800.0), (start: 43200.0, duration: 1800.0), (start: 57600.0, duration: 28800.0)]),
            position: (40.0, 11.0, 0.0)),
        (name: "inspetores", kind: Dispatcher(team: ["inspetor_1", "inspetor_2", "inspetor_3"], rule: Nearest),
            position: (40.0, 11.0, 0.0)),
    ],
    connections: [
        ("bases", "fila_bases"),
        ("placas", "fila_placas"),
        ("fila_bases", "montagem"),      // porta 0: o contêiner (a base)
        ("fila_placas", "montagem"),     // porta 1: os componentes (as placas)
        ("montagem", "fila_solda"),
        ("fila_solda", "solda"),
        ("solda", "fila_cal"),
        ("fila_retorno", "calibracao"),  // as retrabalhadas têm prioridade
        ("fila_cal", "calibracao"),
        ("calibracao", "fila_insp"),
        ("fila_insp", "inspecao"),
        ("inspecao", "expedicao"),       // porta 1: 88% aprovadas
        ("inspecao", "fila_retrabalho"), // porta 2: 12% com defeito
        ("fila_retrabalho", "retrabalho"),
        ("retrabalho", "fila_retorno"),
    ],
)
