// Acabamento da interface (piloto): campos de posição, lista de objetos, seleção de objetos
// sobrepostos, ordem das ligações e "Salvar como".
//   utsim-view crates/utsim-viewer/roteiros/acabamento_modelo.ron --roteiro crates/utsim-viewer/roteiros/acabamento_interface.ron --capturas saida/acabamento
[
    Esperar(quadros: 20),
    Afirmar(Modo(Editar)),
    Afirmar(ObjetosIgual(6)),
    Afirmar(AbaEsquerda("Biblioteca")),
    Captura("01_modelo"),

    // Lista de objetos: aba, filtro por nome e seleção pela lista.
    ClicarBotao("Objetos"),
    Esperar(quadros: 3),
    Afirmar(AbaEsquerda("Objetos")),
    Afirmar(ListaObjetos(6)),
    Captura("02_lista"),

    // O filtro por nome reduz a lista; clicar numa linha seleciona (e o painel mostra o objeto).
    MoverPara(Tela(88.0, 95.0)),
    Clicar(Esquerdo),
    Digitar("insp"),
    Esperar(quadros: 3),
    Afirmar(ListaObjetos(3)),
    Captura("03_filtro"),
    MoverPara(Tela(30.0, 177.0)),
    Clicar(Esquerdo),
    Esperar(quadros: 3),
    Afirmar(Selecionado(Some("insp_b"))),
    Esperar(quadros: 8),
    Captura("04_selecionado_pela_lista"),

    // Campos de posição e giro no painel: digitar, confirmar e desfazer.
    Afirmar(PosicaoDe("insp_b", (2.0, 0.0))),
    MoverPara(Deslocado(Botao("X"), 30.0, 0.0)),
    Clicar(Esquerdo),
    Atalho(["Ctrl", "A"]),
    Digitar("5"),
    Tecla("Enter"),
    Esperar(quadros: 3),
    Afirmar(PosicaoDe("insp_b", (5.0, 0.0))),
    MoverPara(Deslocado(Botao("Y"), 30.0, 0.0)),
    Clicar(Esquerdo),
    Atalho(["Ctrl", "A"]),
    Digitar("-3"),
    Tecla("Enter"),
    Esperar(quadros: 3),
    Afirmar(PosicaoDe("insp_b", (5.0, -3.0))),
    MoverPara(Deslocado(Botao("Giro (graus)"), 55.0, 0.0)),
    Clicar(Esquerdo),
    Atalho(["Ctrl", "A"]),
    Digitar("90"),
    Tecla("Enter"),
    Esperar(quadros: 3),
    Afirmar(GiroDe("insp_b", 90.0)),
    Afirmar(Sujo(true)),
    Captura("05_posicao_e_giro"),
    Atalho(["Ctrl", "Z"]),
    Afirmar(GiroDe("insp_b", 0.0)),
    Atalho(["Ctrl", "Z"]),
    Afirmar(PosicaoDe("insp_b", (5.0, 0.0))),
    Atalho(["Ctrl", "Z"]),
    Afirmar(PosicaoDe("insp_b", (2.0, 0.0))),

    // Objetos sobrepostos: clicar de novo no mesmo ponto alterna entre eles.
    MoverPara(Mundo(2.0, 0.0)),
    Esperar(quadros: 3),
    Afirmar(PilhaSobCursor(3)),
    Captura("06_dica_da_pilha"),
    Clicar(Esquerdo),
    Afirmar(Selecionado(Some("insp_a"))),
    Clicar(Esquerdo),
    Afirmar(Selecionado(Some("insp_b"))),
    Esperar(quadros: 3),
    Captura("07_segundo_da_pilha"),
    Clicar(Esquerdo),
    Afirmar(Selecionado(Some("insp_c"))),
    Clicar(Esquerdo),
    Afirmar(Selecionado(Some("insp_a"))),
    Clicar(Esquerdo),
    Afirmar(Selecionado(Some("insp_b"))),
    // Arrastar a partir do mesmo ponto move o objeto destacado, não o de cima.
    Arrastar(de: Mundo(2.0, 0.0), para: Mundo(2.0, 5.0)),
    Afirmar(PosicaoDe("insp_b", (2.0, 5.0))),
    Afirmar(PosicaoDe("insp_a", (2.0, 0.0))),
    Captura("08_arrastado_o_selecionado"),
    Atalho(["Ctrl", "Z"]),
    Afirmar(PosicaoDe("insp_b", (2.0, 0.0))),

    // Lista: Shift + clique soma à seleção; duplo clique enquadra o objeto.
    MoverPara(Tela(30.0, 156.0)),
    Clicar(Esquerdo),
    Afirmar(Selecionado(Some("insp_a"))),
    Segurar("Shift"),
    MoverPara(Tela(30.0, 198.0)),
    Clicar(Esquerdo),
    LargarTecla("Shift"),
    Afirmar(SelecionadosIgual(2)),
    Afirmar(SelecaoContem("insp_c")),
    Captura("09_selecao_multipla_pela_lista"),

    // Ordem das ligações: a fila tem três saídas (portas 1, 2 e 3) e uma entrada.
    MoverPara(Tela(88.0, 95.0)),
    Clicar(Esquerdo),
    Atalho(["Ctrl", "A"]),
    Digitar("fila"),
    Esperar(quadros: 3),
    Afirmar(ListaObjetos(1)),
    MoverPara(Tela(30.0, 156.0)),
    Clicar(Esquerdo),
    Afirmar(Selecionado(Some("fila"))),
    Esperar(quadros: 3),
    Captura("10_fila_selecionada"),
    MoverPara(Tela(1100.0, 400.0)),
    Rolar(-30.0),
    Esperar(quadros: 3),
    Captura("11_ligacoes"),
    Afirmar(PortaDe("fila", 1, "insp_a")),
    Afirmar(PortaDe("fila", 2, "insp_b")),
    // "Descer" na porta 1: insp_a passa a ser a porta 2, insp_b a porta 1.
    MoverPara(Deslocado(Botao("porta 1: fila -> insp_a"), 135.0, 0.0)),
    Clicar(Esquerdo),
    Esperar(quadros: 3),
    Afirmar(PortaDe("fila", 1, "insp_b")),
    Afirmar(PortaDe("fila", 2, "insp_a")),
    Afirmar(PortaDe("fila", 3, "insp_c")),
    Captura("12_ordem_trocada"),
    Atalho(["Ctrl", "Z"]),
    Afirmar(PortaDe("fila", 1, "insp_a")),
    Afirmar(PortaDe("fila", 2, "insp_b")),
    Atalho(["Ctrl", "Y"]),
    Afirmar(PortaDe("fila", 1, "insp_b")),
    Atalho(["Ctrl", "Z"]),

    // Salvar como (Ctrl + Shift + S): o caminho digitado mantém as maiúsculas.
    Atalho(["Ctrl", "Shift", "S"]),
    Esperar(quadros: 3),
    Captura("13_salvar_como"),
    Atalho(["Ctrl", "A"]),
    Digitar("{capturas}/Copia_Acabamento.ron"),
    Esperar(quadros: 2),
    Captura("14_caminho_digitado"),
    Tecla("Enter"),
    Esperar(quadros: 5),
    Afirmar(CaminhoTermina("Copia_Acabamento.ron")),
    Afirmar(TituloContem("Copia_Acabamento.ron")),
    Afirmar(StatusContem("Salvo")),
    Afirmar(Sujo(false)),
    Captura("15_salvo_como"),

    // Zoom no cursor: o objeto sob o cursor continua sob o cursor depois da roda.
    Focar(objeto: "saida", distancia: 30.0, giro: Some(0.0), inclinacao: Some(0.9)),
    Esperar(quadros: 5),
    MoverPara(Objeto("insp_a")),
    Esperar(quadros: 3),
    Captura("16_antes_do_zoom"),
    Rolar(4.0),
    Esperar(quadros: 3),
    Captura("17_zoom_no_cursor"),
    Rolar(-4.0),
    Esperar(quadros: 3),
    Captura("18_zoom_de_volta"),

    // Lista de famílias de distribuição inteira, sem rolagem escondida.
    MoverPara(Tela(88.0, 95.0)),
    Clicar(Esquerdo),
    Atalho(["Ctrl", "A"]),
    Tecla("Backspace"),
    Esperar(quadros: 3),
    Afirmar(ListaObjetos(6)),
    MoverPara(Tela(30.0, 198.0)),
    Clicar(Esquerdo),
    Afirmar(Selecionado(Some("insp_a"))),
    Esperar(quadros: 3),
    ClicarBotao("Constante"),
    Esperar(quadros: 15),
    Captura("19_familias_sem_rolagem"),
    Tecla("Esc"),
    Esperar(quadros: 3),

    // Texto inválido: fica na caixa, em vermelho, com o motivo; o modelo não muda.
    ClicarBotao("editar como texto"),
    Esperar(quadros: 3),
    MoverPara(Deslocado(Botao("Const(3.0)"), 0.0, 0.0)),
    Clicar(Esquerdo),
    Atalho(["Ctrl", "A"]),
    Digitar("Uniform(min: 1.0)"),
    ClicarBotao("Nome"),
    Esperar(quadros: 3),
    Afirmar(Sujo(false)),
    Captura("20_texto_invalido"),
    // Trocar de objeto e voltar: o texto continua lá.
    MoverPara(Tela(30.0, 219.0)),
    Clicar(Esquerdo),
    Esperar(quadros: 3),
    MoverPara(Tela(30.0, 198.0)),
    Clicar(Esquerdo),
    Esperar(quadros: 3),
    Captura("21_texto_mantido"),
    MoverPara(Deslocado(Botao("Uniform(min: 1.0)"), 0.0, 0.0)),
    Clicar(Esquerdo),
    Atalho(["Ctrl", "A"]),
    Digitar("Uniform(min: 1.0, max: 2.0)"),
    ClicarBotao("Nome"),
    Esperar(quadros: 3),
    Afirmar(Sujo(true)),
    Captura("22_texto_valido_aplicado"),
]
