// A3D-2: operadores (operador_simples) andando e trabalhando nas máquinas.
//   utsim-view examples/celula_com_operadores.ron --roteiro crates/utsim-viewer/roteiros/visual_realista_operadores.ron --capturas %TEMP%/utsim_visual/operadores
// Confere: "ana" andando de 10,2 até maq1 com as pernas alternando (uma captura a cada
// ~0,3 m percorridos, a perna da frente troca), os braços balançando ao contrário das
// pernas, e depois de pé na frente da máquina, trabalhando (t = 31), com a luz da
// máquina na cor do estado.
[
    Esperar(quadros: 20),
    EsperarSegundos(3.0),
    ClicarBotao("▶ Simular"),
    EsperarAte(Modo(Simular), 120.0),
    Esperar(quadros: 30),
    EsperarSegundos(2.0),
    Captura("01_visao_geral"),

    // Caminhada em velocidade x1 (de x50: cinco vezes "-").
    IrPara(26.0),
    Focar(objeto: "ana", distancia: 6.0, giro: Some(0.0), inclinacao: Some(0.25)),
    Tecla("-"),
    Tecla("-"),
    Tecla("-"),
    Tecla("-"),
    Tecla("-"),
    ClicarBotao("Reproduzir"),
    EsperarSegundos(0.6),
    Captura("02_andando_a"),
    Captura("03_andando_b"),
    Captura("04_andando_c"),
    Captura("05_andando_d"),
    ClicarBotao("Pausar"),

    // Na máquina, trabalhando no setup.
    IrPara(31.0),
    Focar(objeto: "maq1", distancia: 6.0, giro: Some(0.3), inclinacao: Some(0.35)),
    Esperar(quadros: 10),
    Captura("06_trabalhando"),
    Afirmar(TempoSimuladoMin(30.0)),
]
