// Roteiro da camada "Rede" do editor (fase 9), a partir de um modelo vazio.
//   utsim-view --novo --roteiro crates/utsim-viewer/roteiros/editor_rede.ron --capturas %TEMP%\utsim_editor\rede
// Monta uma linha (chegada, fila, duas máquinas, saída) com uma empilhadeira, desenha uma
// rede em anel com a ferramenta "Aresta" (cliques no chão criam os nós já ligados), seleciona,
// arrasta, renomeia e exclui um nó (e desfaz), seleciona uma aresta e limita a capacidade,
// escolhe a base da empilhadeira num nó da rede e simula: a empilhadeira segue o anel.
[
    Esperar(quadros: 20),
    Afirmar(Camada("Objetos")),

    // Objetos.
    ClicarBotao("Chegada"),
    MoverPara(Mundo(-7.0, 3.0)),
    Clicar(Esquerdo),
    ClicarBotao("Fila"),
    MoverPara(Mundo(-4.0, 3.0)),
    Clicar(Esquerdo),
    ClicarBotao("Processo"),
    Segurar("Shift"),
    MoverPara(Mundo(3.0, 3.0)),
    Clicar(Esquerdo),
    MoverPara(Mundo(3.0, -3.0)),
    Clicar(Esquerdo),
    LargarTecla("Shift"),
    Tecla("Esc"),
    ClicarBotao("Saída"),
    MoverPara(Mundo(7.0, 0.0)),
    Clicar(Esquerdo),
    ClicarBotao("Empilhadeira"),
    MoverPara(Mundo(-4.0, -1.0)),
    Clicar(Esquerdo),
    Afirmar(ObjetosIgual(6)),

    // Ligações: chegada -> fila -> (processo, processo_2) -> saida.
    MoverPara(Objeto("chegada")),
    Clicar(Esquerdo),
    Tecla("C"),
    MoverPara(Objeto("fila")),
    Clicar(Esquerdo),
    MoverPara(Objeto("fila")),
    Clicar(Esquerdo),
    Tecla("C"),
    MoverPara(Objeto("processo")),
    Clicar(Esquerdo),
    MoverPara(Objeto("fila")),
    Clicar(Esquerdo),
    Tecla("C"),
    MoverPara(Objeto("processo_2")),
    Clicar(Esquerdo),
    MoverPara(Objeto("processo")),
    Clicar(Esquerdo),
    Tecla("C"),
    MoverPara(Objeto("saida")),
    Clicar(Esquerdo),
    MoverPara(Objeto("processo_2")),
    Clicar(Esquerdo),
    Tecla("C"),
    MoverPara(Objeto("saida")),
    Clicar(Esquerdo),
    Afirmar(LigacoesIgual(5)),

    // A fila entrega pela empilhadeira.
    MoverPara(Objeto("fila")),
    Clicar(Esquerdo),
    ClicarBotao("nenhum"),
    ClicarBotao("empilhadeira"),
    Afirmar(ProblemasIgual(0)),
    Captura("01_objetos"),

    // Camada Rede: desenhar o anel clicando no chão com a ferramenta Aresta.
    ClicarBotao("Rede"),
    Afirmar(Camada("Rede")),
    Afirmar(NosIgual(0)),
    ClicarBotao("Aresta"),
    Afirmar(Ferramenta("Rede:Aresta")),
    MoverPara(Mundo(-4.0, 1.0)),
    Clicar(Esquerdo),
    Afirmar(Ferramenta("Rede:Aresta:no")),
    MoverPara(Mundo(-1.0, 6.0)),
    Captura("02_aresta_pendente"),
    Clicar(Esquerdo),
    MoverPara(Mundo(3.0, 5.0)),
    Clicar(Esquerdo),
    MoverPara(Mundo(6.0, 0.0)),
    Clicar(Esquerdo),
    MoverPara(Mundo(3.0, -5.0)),
    Clicar(Esquerdo),
    MoverPara(Mundo(-1.0, -5.0)),
    Clicar(Esquerdo),
    // Fecha o anel clicando no primeiro nó.
    MoverPara(Mundo(-4.0, 1.0)),
    Clicar(Esquerdo),
    Tecla("Esc"),
    Afirmar(Ferramenta("Rede:Aresta")),
    Afirmar(NosIgual(6)),
    Afirmar(ArestasIgual(6)),
    Afirmar(Aresta("no_6", "no")),
    Afirmar(NoEm("no_4", (6.0, 0.0))),
    Afirmar(ProblemasIgual(0)),
    Tecla("F"),
    Esperar(quadros: 10),
    Captura("03_anel"),

    // Selecionar, arrastar (um passo de desfazer) e renomear um nó.
    ClicarBotao("Selecionar"),
    MoverPara(Mundo(6.0, 0.0)),
    Clicar(Esquerdo),
    Afirmar(SelecaoCamada(Some("no:no_4"))),
    Captura("04_no_selecionado"),
    Arrastar(de: Mundo(6.0, 0.0), para: Mundo(7.0, -2.0)),
    Afirmar(NoEm("no_4", (7.0, -2.0))),
    Captura("05_no_arrastado"),
    Atalho(["Ctrl", "Z"]),
    Afirmar(NoEm("no_4", (6.0, 0.0))),
    MoverPara(Deslocado(Botao("Nome"), 70.0, 0.0)),
    Clicar(Esquerdo),
    Atalho(["Ctrl", "A"]),
    Digitar("canto"),
    Tecla("Enter"),
    Esperar(quadros: 3),
    Afirmar(SelecaoCamada(Some("no:canto"))),
    Afirmar(Aresta("no_3", "canto")),

    // Excluir o nó leva as duas arestas dele; desfazer traz tudo de volta.
    Tecla("Delete"),
    Afirmar(NosIgual(5)),
    Afirmar(ArestasIgual(4)),
    Captura("06_no_excluido"),
    Atalho(["Ctrl", "Z"]),
    Afirmar(NosIgual(6)),
    Afirmar(ArestasIgual(6)),

    // Selecionar uma aresta pelo meio e limitar a um veículo.
    MoverPara(Mundo(-2.5, 3.5)),
    Clicar(Esquerdo),
    Afirmar(SelecaoCamada(Some("aresta:no->no_2"))),
    ClicarBotao("Limitar veículos (AGV)"),
    Esperar(quadros: 3),
    Captura("07_aresta_capacidade"),
    Atalho(["Ctrl", "Z"]),

    // Base da empilhadeira num nó da rede (camada Objetos).
    ClicarBotao("Objetos"),
    MoverPara(Objeto("empilhadeira")),
    Clicar(Esquerdo),
    Afirmar(Selecionado(Some("empilhadeira"))),
    ClicarBotao("fora da rede"),
    ClicarBotao("no_6"),
    Afirmar(PosicaoDe("empilhadeira", (-1.0, -5.0))),
    Captura("08_base_no_no"),

    // Simular: a empilhadeira anda pelo anel.
    ClicarBotao("▶ Simular"),
    EsperarAte(Modo(Simular), 120.0),
    Esperar(quadros: 30),
    IrPara(3.0),
    Esperar(quadros: 10),
    Captura("09_sim_a"),
    IrPara(6.0),
    Esperar(quadros: 10),
    Captura("10_sim_b"),
    IrPara(9.0),
    Esperar(quadros: 10),
    Captura("11_sim_c"),
    IrPara(12.0),
    Esperar(quadros: 10),
    Captura("12_sim_d"),
]
