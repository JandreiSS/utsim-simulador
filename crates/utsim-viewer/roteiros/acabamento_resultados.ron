// Acabamento da janela Resultados (piloto): tabela de cenários larga que rola na horizontal
// e sinais de viável e inviável da otimização escritos em palavras.
//   utsim-view examples/tutorial_03_operadores.ron --roteiro crates/utsim-viewer/roteiros/acabamento_resultados.ron --capturas saida/acabamento_resultados
// (rode a partir da raiz do repositório: o experimento é lido de examples/)
[
    Esperar(quadros: 20),
    ClicarBotao("Resultados"),
    Esperar(quadros: 6),
    ClicarBotao("Cenários"),
    Esperar(quadros: 4),
    Afirmar(AbaResultados("Cenários")),

    // Abre um experimento com cinco cenários: a tabela passa da largura da janela.
    MoverPara(Deslocado(Botao("Arquivo de experimento:"), 200.0, 0.0)),
    Clicar(Esquerdo),
    Atalho(["Ctrl", "A"]),
    Digitar("examples/experimento_tutorial_03.ron"),
    ClicarBotao("Abrir experimento"),
    Esperar(quadros: 4),
    ClicarBotao("Rodar cenários"),
    EsperarAte(CenariosComparados(5), 400.0),
    Afirmar(AnaliseRodando(false)),
    Esperar(quadros: 6),
    Captura("01_tabela_larga"),
    // Rolar para a direita mostra os últimos cenários (nada fica cortado).
    MoverPara(Deslocado(Botao("Filtrar métricas:"), 300.0, 80.0)),
    Segurar("Shift"),
    Rolar(-30.0),
    LargarTecla("Shift"),
    Esperar(quadros: 3),
    Captura("02_tabela_rolada"),

    // Otimização com uma restrição: os sinais aparecem como "atende"/"não atende" e "sim"/"não".
    ClicarBotao("Otimização"),
    Esperar(quadros: 4),
    ClicarBotao("objeto.campo"),
    Esperar(quadros: 2),
    Digitar("maq1.capacity"),
    ClicarBotao("Adicionar parâmetro"),
    Esperar(quadros: 3),
    ClicarBotao("objeto.métrica"),
    Esperar(quadros: 2),
    Digitar("saida.time_in_system.mean"),
    ClicarBotao("Adicionar restrição"),
    Esperar(quadros: 3),
    ClicarBotao("máximo"),
    Digitar("90"),
    ClicarBotao("objeto.métrica"),
    Esperar(quadros: 2),
    Digitar("saida.time_in_system.mean"),
    Esperar(quadros: 2),
    Captura("03_problema"),
    ClicarBotao("Otimizar"),
    EsperarAte(MelhorPontoContem("maq1.capacity"), 400.0),
    Afirmar(AnaliseRodando(false)),
    Esperar(quadros: 4),
    MoverPara(Tela(640.0, 500.0)),
    Rolar(-12.0),
    Esperar(quadros: 3),
    Captura("04_viavel"),
    Rolar(-30.0),
    Esperar(quadros: 3),
    Captura("05_tabela_de_pontos"),
]
